00000005)), (np.float64(577.4999999999995), np.float64(1559.7775666666682)), (np.float64(2637.292236328125), np.float64(1559.7775666666682)), (np.float64(2637.292236328125), np.float64(1044.7017000000005))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 47, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': '91779355d26208db9e9cee072b02208f', 'category': 'NarrativeText', 'element_id': '5fb1c4d6f842e5ef8daecf0da96f0651'}, page_content='Whenever the TCP connection is disconnected, the antenna sets its keep-alive timers to infinity. When a new TCP connection is established, the modem will send an ‘A’ to the antenna, and the antenna will send an \'a\' to the modem. Typically each side will then set a disconnect timer to three times the requested interval. For example, the modem might send "A 3" and set its disconnect timer to 9 seconds. If at any time after that, the modem waits more than 9 seconds to receive an "s" message, the modem will break the TCP connection. It may then choose to periodically (or at random intervals) attempt to make a new TCP connection. Similarly, the antenna might send "a 2" and then break the connection if it must wait more than 6 seconds between received "L" messages.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.9404767155647278, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(577.5048416666666), np.float64(1598.8595000000016)), (np.float64(577.5048416666666), np.float64(1822.2733666666684)), (np.float64(2626.8322500000004), np.float64(1822.2733666666684)), (np.float64(2626.8322500000004), np.float64(1598.8595000000016))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 47, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': '91779355d26208db9e9cee072b02208f', 'category': 'NarrativeText', 'element_id': '91f4b446bbb3175d97c5f3da3250b1fa'}, page_content='Neither the antenna nor the modem is obliged to accept more than one TCP connection at a time, but this is not prohibited. In a system with two modems, one may be acting as a backup. In this arrangement, the antenna should only honor satellite selection requests from one modem.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.9533111453056335, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(577.5048416666666), np.float64(1861.3553000000018)), (np.float64(577.5048416666666), np.float64(2318.0987666666692)), (np.float64(2641.967041015625), np.float64(2318.0987666666692)), (np.float64(2641.967041015625), np.float64(1861.3553000000018))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 47, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': '91779355d26208db9e9cee072b02208f', 'category': 'NarrativeText', 'element_id': 'df0918d4f69af2d26fe578d7a0283698'}, page_content='TCP is a "stream-oriented" protocol: there is no particular mapping of an OpenAMIP message into an IP packet. A single packet may contain a fragment of a message, a complete message, or multiple messages. In the reference implementation, the modem sends an entire initial set of seven messages in a single POSIX "write" command immediately after opening the connection. On most POSIX systems, this will result in a single TCP/IP packet. The reference receiver implementation accumulates characters until a new line is found and then processes the result as an OpenAMIP message. Accumulation of the next message starts with the first character after the new line.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.8802143335342407, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(575.9085083007812), np.float64(2413.46175)), (np.float64(575.9085083007812), np.float64(2481.4200833333334)), (np.float64(1286.5479736328125), np.float64(2481.4200833333334)), (np.float64(1286.5479736328125), np.float64(2413.46175))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 47, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': 'f115b3553736acad34f2f234e5b4e491', 'category': 'Title', 'element_id': 'c9f6a1cac0f75e4b89ea30c1569930bb'}, page_content='2.6.2 UDP Interface'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.945313572883606, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(574.8684692382812), np.float64(2510.08642578125)), (np.float64(574.8684692382812), np.float64(2794.7030999999997)), (np.float64(2618.572509765625), np.float64(2794.7030999999997)), (np.float64(2618.572509765625), np.float64(2510.08642578125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 47, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': 'c9f6a1cac0f75e4b89ea30c1569930bb', 'category': 'NarrativeText', 'element_id': '0c00c4b0d1455c72dba452a59a20c5bd'}, page_content='Each message fits in a single UDP packet. A packet may contain more than one message, but any given message must be fully contained within one packet. The antenna has a configured IP address and well-known port, as does the modem. The initial state of the OpenAMIP interface is "idle" (that is, no keepalive) until the partner sends a keepalive timer. The interface reverts to the "idle" state if three keepalives are missed.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.948739767074585, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(577.4999999999998), np.float64(2831.836669921875)), (np.float64(577.4999999999998), np.float64(3173.8636999999994)), (np.float64(2625.351318359375), np.float64(3173.8636999999994)), (np.float64(2625.351318359375), np.float64(2831.836669921875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 47, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': 'c9f6a1cac0f75e4b89ea30c1569930bb', 'category': 'NarrativeText', 'element_id': '3afbd6255755feedbb71cbf06f15dbcc'}, page_content='In Version 1.9, the modem may create a UDP stream for the "C" message, alongside the primary TCP connection for all other OpenAMIP messages. Because the "C" message will be sent at a relatively high rate (tens of Hertz), the UDP stream is more practical; it avoids TCP handshaking overhead. It is recommended that the modem and antenna use the same IP address and port for both TCP and UDP connections, although this is not mandatory. Because TCP and UDP use separate address spaces, this does not cause any conflict.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.7623041868209839, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(346.7931213378906), np.float64(3563.6708333333327)), (np.float64(346.7931213378906), np.float64(3660.795833333333)), (np.float64(1032.7503662109375), np.float64(3660.795833333333)), (np.float64(1032.7503662109375), np.float64(3563.6708333333327))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 47, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': 'c9f6a1cac0f75e4b89ea30c1569930bb', 'category': 'NarrativeText', 'element_id': 'c38823d12339d9bf49a906cd2a60bd6e'}, page_content='OpenAMIP™ Standard Version 1.17 T0000682 | Rev H'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(2579.206875), np.float64(3563.6708333333327)), (np.float64(2579.206875), np.float64(3607.4208333333327)), (np.float64(2625.1575000000003), np.float64(3607.4208333333327)), (np.float64(2625.1575000000003), np.float64(3563.6708333333327))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 47, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': 'c9f6a1cac0f75e4b89ea30c1569930bb', 'category': 'UncategorizedText', 'element_id': '6f84efefbb8f22aba025d4553af307aa'}, page_content='39'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b9