.0), np.float64(2017.3416666666665)), (np.float64(350.0), np.float64(2104.8416666666662)), (np.float64(1083.9062499999995), np.float64(2104.8416666666662)), (np.float64(1083.9062499999995), np.float64(2017.3416666666665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 11, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'category': 'Title', 'element_id': '83ebd1e8bd0b4c8b7a9897128f96338c'}, page_content='2.1 Introduction'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.9449360370635986, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(577.4999999999999), np.float64(2143.4151666666667)), (np.float64(577.4999999999999), np.float64(2370.6055333333334)), (np.float64(2628.868896484375), np.float64(2370.6055333333334)), (np.float64(2628.868896484375), np.float64(2143.4151666666667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 11, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': '83ebd1e8bd0b4c8b7a9897128f96338c', 'category': 'NarrativeText', 'element_id': '53ef9102d8e917bebf9eba4044734eb6'}, page_content='OpenAMIP is intended to be simple and flexible. Communications are in the form of messages that are readable ASCII characters. A message consists of one or more space-separated variable-length fields. The command is terminated by a new line <lf> character or by the <cr><lf> sequence.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.p