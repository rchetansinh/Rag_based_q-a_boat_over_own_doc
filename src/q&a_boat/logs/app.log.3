/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'category': 'Header', 'element_id': '96f8bf8e078b89908ef381d247542be3'}, page_content='Modified OpenAMIP'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.8850132822990417, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(341.1080627441406), np.float64(442.3416666666665)), (np.float64(341.1080627441406), np.float64(529.8416666666666)), (np.float64(1368.4322509765625), np.float64(529.8416666666666)), (np.float64(1368.4322509765625), np.float64(442.3416666666665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 56, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': '96f8bf8e078b89908ef381d247542be3', 'category': 'Title', 'element_id': '9ebfc833f36fe6b420f5273ce83ac26e'}, page_content='3.2 Modified OpenAMIP'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.9443739652633667, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(576.8154907226562), np.float64(568.415652777778)), (np.float64(576.8154907226562), np.float64(967.4906616210938)), (np.float64(2622.552216666667), np.float64(967.4906616210938)), (np.float64(2622.552216666667), np.float64(568.415652777778))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 56, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': '9ebfc833f36fe6b420f5273ce83ac26e', 'category': 'NarrativeText', 'element_id': '621f37bbd03dc9e20c8186655ec774d2'}, page_content='Any antenna or modem manufacturer can extend the protocol by creating an extended type field. The extended type field consists of the manufacturer\'s name (with no spaces) followed by a colon, followed by a type (with no spaces). If a modem or antenna controller receives a message of unknown type, the modem or antenna controller will ignore the message. If the messages are optional for operation of the equipment, then the protocol still qualifies as "unmodified" OpenAMIP. If the messages must be used for a particular antenna or modem, then the resulting implementation must be called "modified OpenAMIP".'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.7984784245491028, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(577.4951583333332), np.float64(1005.908652777779)), (np.float64(577.4951583333332), np.float64(1054.325319444446)), (np.float64(802.666259765625), np.float64(1054.325319444446)), (np.float64(802.666259765625), np.float64(1005.908652777779))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 56, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': '9ebfc833f36fe6b420f5273ce83ac26e', 'category': 'NarrativeText', 'element_id': '02eecde9fb4622a9bb895612ca4c71f8'}, page_content='Examples:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.5759708285331726, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(577.4951583333332), np.float64(1096.1851806640625)), (np.float64(577.4951583333332), np.float64