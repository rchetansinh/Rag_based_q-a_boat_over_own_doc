pntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': 'be8584d4d452a99e9ee17201f77867b7', 'category': 'UncategorizedText', 'element_id': 'd9ad4a29b98df623b1162380cf105fa2'}, page_content='H } commands. This command overrides the N command.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.41001856327056885, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(531.1235416666665), np.float64(924.5928344726562)), (np.float64(531.1235416666665), np.float64(1799.179931640625)), (np.float64(1711.66162109375), np.float64(1799.179931640625)), (np.float64(1711.66162109375), np.float64(924.5928344726562))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 15, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': 'be8584d4d452a99e9ee17201f77867b7', 'category': 'NarrativeText', 'element_id': '470c0d0dc9a464520152d3a09cd4e3f5'}, page_content='Find the satellite / Fulfill most recently received O or S, P, B, R, X, H commands. O, S, P, B, R, X, H commands are expected to be stored until an ‘F’ command is received, whereupon they will be fulfilled. O, S, P, B, R, X, H commands should be cached; they should not be deleted on receipt of an ‘F’ command. They may be re-used in a scenario where only a subset of them is updated before the next ‘F’ command. These commands should be deleted in the case of a connection reset. In some situations, the ‘F’ command is intended to update signal path setting such as polarization, rather than to initiate a full satellite search. A terminal may optimize response time by performing only those operations relevant to updated parameters, and skipping those (such as re-point) which have not been updated.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.9307454824447632, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(531.1235416666664), np.float64(1823.0085416666677)), (np.float64(531.1235416666664), np.float64(2240.9697916666682)), (np.float64(1693.8760986328125), np.float64(2240.9697916666682)), (np.float64(1693.8760986328125), np.float64(1823.0085416666677))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02:08', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 15, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'parent_id': 'be8584d4d452a99e9ee17201f77867b7', 'category': 'NarrativeText', 'element_id': 'e2983de6a44fad72fe469f21594614fc'}, page_content='The O command will be sent without an F command when the system is only updating an existing TLE (same satellite, but an updated TLE). The antenna is responsible for deciding whether to change its pointing immediately or cache the new TLE until an actual re-point is required. The existing TLE update (vs re-point) can be determined by checking the TLE satellite name/Satellite catalog number since the last ‘O’ command was received.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_d9819300d88ddfd3ced0bb7e3d1398ac.pdf', 'detection_class_prob': 0.8825621008872986, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(531.1235416666664), np.float64(2333.426666666668)), (np.float64(531.1235416666664), np.float64(2377.176666666668)), (np.float64(1317.4327392578125), np.float64(2377.176666666668)), (np.float64(1317.4327392578125), np.float64(2333.426666666668))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T20:02: