de for more information on GDRs.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8613246083259583, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.2431640625), np.float64(1379.7568359375)), (np.float64(567.2431640625), np.float64(1447.25146484375)), (np.float64(1285.6026611328125), np.float64(1447.25146484375)), (np.float64(1285.6026611328125), np.float64(1379.7568359375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 220, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c86d35f4c8322c0bda4656978f264de2', 'category': 'Title', 'element_id': '025aae675dbafc6dd507a5109c05ee96'}, page_content='5.1.2.1 Network Setup'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.949010968208313, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.0100708007812), np.float64(1489.540283203125)), (np.float64(567.0100708007812), np.float64(1849.3586197916663)), (np.float64(2638.1334947916666), np.float64(1849.3586197916663)), (np.float64(2638.1334947916666), np.float64(1489.540283203125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 220, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '025aae675dbafc6dd507a5109c05ee96', 'category': 'NarrativeText', 'element_id': '6fc731fc32baeaa1198853e97cc37dff'}, page_content='The network architecture to support a rain diversity configuration consists of a Primary RF Gateway Site, a Diversity RF Gateway Site, and a CDC (can have an optional backup CDC) as depicted in Figure 5-4. Note the CMS (Carrier Measurement System) located in each RF Gateway. In previous CDC deployments, it was used only to measure the distance between the line cards and satellite terminals; now it will also measure signal strength, from which the PP will determine if rain fade is present.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.26942533254623413, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(430.484130859375), np.float64(3562.900286458333)), (np.float64(430.484130859375), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 220, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '025aae675dbafc6dd507a5109c05ee96', 'category': 'NarrativeText', 'element_id': 'da12a5a10617acde47a68efad85451eb'}, page_content='186'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.47977128624916077, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1060.90966796875), np.float64(3510.84716796875)), (np.float64(1060.90966796875), np.float64(3628.525286458333)), (np.float64(2624.267578125), np.float64(3628.525286458333)), (np.float64(2624.267578125), np.float64(3510.84716796875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['e