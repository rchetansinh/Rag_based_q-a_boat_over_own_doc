ntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9008945822715759, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(302.7182922363281), np.float64(835.041666666667)), (np.float64(302.7182922363281), np.float64(922.541666666667)), (np.float64(2020.7515052083331), np.float64(922.541666666667)), (np.float64(2020.7515052083331), np.float64(835.041666666667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 257, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '52efef0a3a7b897dc835e5ce5220af68', 'category': 'Title', 'element_id': '6ba5ecb4494a631ce725358fe66ab0c4'}, page_content='6.2 Pulse NMS Features and Operations'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9412189722061157, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(965.8638281249998)), (np.float64(568.75), np.float64(1262.379453125)), (np.float64(2597.25830078125), np.float64(1262.379453125)), (np.float64(2597.25830078125), np.float64(965.8638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 257, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6ba5ecb4494a631ce725358fe66ab0c4', 'category': 'NarrativeText', 'element_id': 'b265797cf8498f0331e4e2635e386739'}, page_content='The Pulse NMS provides functionality for configuration, control, monitoring, alarm handling, event logging and reporting functions of the network equipment. The Pulse NMS provides a complete set of APIs and a web-based user interface for these purposes. A custom graphic user interface (GUI), or operations interfaces, to connect OSS/BSS systems can be produced using the APIs as per customer requirements.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9423305988311768, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1308.572161458333)), (np.float64(568.75), np.float64(1605.087786458333)), (np.float64(2605.800537109375), np.float64(1605.087786458333)), (np.float64(2605.800537109375), np.float64(1308.572161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 257, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6ba5ecb4494a631ce725358fe66ab0c4', 'category': 'NarrativeText', 'element_id': 'f19a565e8162dbe9d0e7142671107632'}, page_content='The Pulse NMS features a fully web-based user interface for the operator, as well as a full- featured RESTful API using JSON encoding that enables machine-to-machine communication. Users accessing the system via the API and users with the same permissions accessing the system via the web-based user interface are considered equivalent and will have the same options. Pulse supports multiple users with various permission-based access.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9394792914390564, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(558.2192993164062), np.float64(1651.2804947916663)), (np.float64(558.2192993164062), np.float64(1885.8169531249998)), (np.float64(2591.2845364583336), np.float64(1885.8169531249