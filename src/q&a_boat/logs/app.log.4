y': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'ae52e0f311fb0de20f0705291c80c76c', 'category': 'Title', 'element_id': 'a205b8601a425de0ee52cd580597ff83'}, page_content='12.6 Layer 2/Layer 3 Hybrid Mode'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9391096830368042, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(528.3638281249998)), (np.float64(568.75), np.float64(700.9211197916668)), (np.float64(2628.472900390625), np.float64(700.9211197916668)), (np.float64(2628.472900390625), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 404, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a205b8601a425de0ee52cd580597ff83', 'category': 'NarrativeText', 'element_id': '1c00b4e148b772bfbf7a969a9e2b4ff3'}, page_content='iDirect introduces the Layer 2/Layer 3 Hybrid Mode feature to allow both Layer 2 and Layer 3 traffic to traverse a single VSAT network at the same time, sharing the same NMS, PP stack, line cards, and satellite bandwidth.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9437147378921509, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(747.1138281249998)), (np.float64(568.75), np.float64(919.6711197916668)), (np.float64(2633.966796875), np.float64(919.6711197916668)), (np.float64(2633.966796875), np.float64(747.1138281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 404, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a205b8601a425de0ee52cd580597ff83', 'category': 'NarrativeText', 'element_id': '9b7a140f719b331fddfceb591bcbe7c3'}, page_content='When transported in the same network, Layer 2 and Layer 3 traffic is separated by an individual Satellite Virtual Networks (SVN), see SVN and Service Delimiting Tags on page 366. In other words, SVNs will be marked as either Layer 2 or Layer 3 during network configuration.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9049037098884583, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(965.8638281249998)), (np.float64(568.75), np.float64(1014.4627864583334)), (np.float64(1718.4197077195315), np.float64(1014.4627864583334)), (np.float64(1718.4197077195315), np.float64(965.8638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 404, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a205b8601a425de0ee52cd580597ff83', 'category': 'NarrativeText', 'element_id': '1a28df23318a91446a39833982350e0e'}, page_content='The most common use cases for this feature include:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(1060.6554947916666)), (np.float64(567.5468749999999), np.float64(1109.254453125)), (np.float64(607.6595364583333), np.float64(1109.254453125)), (np.float64(607.6595364583333), np