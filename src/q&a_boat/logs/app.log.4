at64(2606.532470703125), np.float64(506.4888281249999))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 376, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'e74176faf5e6ba19e80efc01b1df2824', 'category': 'NarrativeText', 'element_id': '21afba551eb6305c375283046c55af26'}, page_content='Service Providers that have gaps in the unicast data coverage provided by their spot beams, can extend the unicast services to cover those gaps that are also covered by their wide beams. The extension of this coverage would be achieved by adding unicast 2-way iNets to those wide beams, to thereby enable unicast coverage in those areas not previously covered by the spot beams. The wide beams would then contain both 2-way iNets and 1-way iNets (broadcast-only), and continue to carry persistent multicast traffic on its own downstream carrier.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.7505519390106201, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1147.50146484375), np.float64(1930.7336197916661)), (np.float64(1147.50146484375), np.float64(1979.3325781249996)), (np.float64(2045.417724609375), np.float64(1979.3325781249996)), (np.float64(2045.417724609375), np.float64(1930.7336197916661))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 376, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '8c20f5e11e924f9819c0d1c1288849c2'}, page_content='Figure 10-5. Unicast on Overlay Beams'), 