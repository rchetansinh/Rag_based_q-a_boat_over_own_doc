), np.float64(299.87945312500017)), (np.float64(1465.4656982421875), np.float64(251.28049479166657))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 310, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': 'b529f25cae8273ef98f263ced1bf91af'}, page_content='7.11.3 Terminal Break-Before-Make Beam Switch'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9374725222587585, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.99267578125), np.float64(400.7596614583332)), (np.float64(563.99267578125), np.float64(573.3169531250002)), (np.float64(2575.3522447916666), np.float64(573.3169531250002)), (np.float64(2575.3522447916666), np.float64(400.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 310, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b529f25cae8273ef98f263ced1bf91af', 'category': 'NarrativeText', 'element_id': '9fbc9ebd4a3e68591b2f89a0a13657cc'}, page_content='command the polarization changes needed for the antenna (or change the LNB band selection), and re-establish the link as quickly as possible. The terminal state is maintained during the beam switch.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9469707608222961, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(619.5096614583332)), (np.float64(568.75), np.floa