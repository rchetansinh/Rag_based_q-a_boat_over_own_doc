3984375), np.float64(251.28049479166657))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': 'b7e59a852c82cb4f6be077219a261d97'}, page_content='4.4.2.2 Latency'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9430306553840637, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(400.7596614583332)), (np.float64(568.75), np.float64(573.3169531250002)), (np.float64(2633.55615234375), np.float64(573.3169531250002)), (np.float64(2633.55615234375), np.float64(400.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b7e59a852c82cb4f6be077219a261d97', 'category': 'NarrativeText', 'element_id': 'c827f5e2818bf8222e5b9cb7f71920b4'}, page_content='classification and prioritization of packets, and proper management of available bandwidth. For example, if a Voice-Over IP application requires 16 Kbps and a remote is only allocated 10 Kbps, the application fails regardless of priority, as available bandwidth is not enough.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8942044377326965, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(564.04833984375), np.float64(661.3638281249999)), (np.float64(564.04833984375), np.float64(724.5461197916663)), (np.float64(1084.2471923828125), np.float64(724.5461197916663)), (np.float64(1084.2471923828125), np.float64(661.3638281249999))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b7e59a852c82cb4f6be077219a261d97', 'category': 'Title', 'element_id': 'b982095151224808ef4d865a2c930ac5'}, page_content='4.4.2.2 Latency'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9456049799919128, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.6351928710938), np.float64(767.674072265625)), (np.float64(565.6351928710938), np.float64(1065.504453125)), (np.float64(2643.149658203125), np.float64(1065.504453125)), (np.float64(2643.149658203125), np.float64(767.674072265625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b982095151224808ef4d865a2c930ac5', 'category': 'NarrativeText', 'element_id': '53cb8980cf935df88140a848740227fc'}, page_content='In general, latency measures the amount of time between events. When the term "latency" is used in communications networks, it refers to the amount of time between the transmission of a packet from its source and the receipt of that packet at the destination. In general, latency accounts for the total delay between events and it includes transit time, queuing, and processing delays.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9462730288505554, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(564.9942016601562), np.float64(1111.697161458333)), (np.float64(564.9942016601562), np.float64(1472.0718994140625)), (np.float64(2639.2637031249997), np.float64(1472.0718994140625)), (np.float64(2639.2637031249997), np.float64(1111.697161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b982095151224808ef4d865a2c930ac5', 'category': 'NarrativeText', 'element_id': '0d5d2e1f53c3f5261676c7999c405e9a'}, page_content='Application latency is typically a concern for transaction-based applications, such as credit card verification systems, which require a rapid completion time per transaction; and interactive applications, like VoIP calls. For such applications, it is important that latency- sensitive traffic be expedited through the system at the expense of less important background traffic. This is especially true in bandwidth-limited conditions where a remote may have a limited number of TDMA (time division multiple access) slots on which to transmit its packets.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8586249947547913, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1552.6103515625)), (np.float64(568.75), np.float64(1621.8935546875)), (np.float64(1010.1475830078125), np.float64(1621.8935546875)), (np.float64(1010.1475830078125), np.float64(1552.6103515625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b7e59a852c82cb4f6be077219a261d97', 'category': 'Title', 'element_id': 'a8b0dbab7cfb8666cd72efb94c9a5662'}, page_content='4.4.2.3 Jitter'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9393091797828674, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1663.9676513671875)), (np.float64(568.75), np.float64(1900.400286458333)), (np.float64(2622.963623046875), np.float64(1900.400286458333)), (np.float64(2622.963623046875), np.float64(1663.9676513671875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a8b0dbab7cfb8666cd72efb94c9a5662', 'category': 'NarrativeText', 'element_id': '60a6c02b1690df12b9570ced8bf173dd'}, page_content='Jitter refers to the variation in arrival time between packets for a specific traffic flow. Time sensitive applications such as VoIP typically require limited latency and jitter to perform properly. A network with high jitter may not satisfy the requirements of such time-sensitive applications, even if their latency requirements are met.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9483499526977539, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1945.5704345703125)), (np.float64(568.75), np.float64(2305.387939453125)), (np.float64(2637.9512031249997), np.float64(2305.387939453125)), (np.float64(2637.9512031249997), np.float64(1945.5704345703125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a8b0dbab7cfb8666cd72efb94c9a5662', 'category': 'NarrativeText', 'element_id': 'cccc67384b7f37480595befc156a6553'}, page_content='There are many sources of jitter in networks, two of which are significant in a satellite network. While jitter plays a role in both downstream and upstream directions, a satellite network with TDMA inbounds, such as Velocity, tends to introduce more jitter in the upstream direction than in the downstream. This characteristic is due to the discrete nature of TDMA, which only allows a remote to transmit data in assigned slots. Jitter is introduced when the inter-slot times assigned to a particular remote do not match the desired play out rate.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9390888810157776, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2351.2804947916666)), (np.float64(568.75), np.float64(2585.816953125)), (np.float64(2577.0302734375), np.float64(2585.816953125)), (np.float64(2577.0302734375), np.float64(2351.2804947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a8b0dbab7cfb8666cd72efb94c9a5662', 'category': 'NarrativeText', 'element_id': 'a1bcc28015f9bcc6d2ba158eda05e3ce'}, page_content='Another source of jitter is additional traffic transmitted between (or in front of) successive packets in the real-time stream. When a large packet needs to be transmitted in front of a real-time packet, jitter is introduced because the remote must wait longer than desired before transmitting the next real-time packet.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9483638405799866, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2632.009661458333)), (np.float64(568.75), np.float64(3114.462786458333)), (np.float64(2624.7532864583327), np.float64(3114.462786458333)), (np.float64(2624.7532864583327), np.float64(2632.009661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a8b0dbab7cfb8666cd72efb94c9a5662', 'category': 'NarrativeText', 'element_id': '37e6dc6e7ef9b54d6db3c01840de79b1'}, page_content="Consider an application like VoIP: the transmitting application spaces each packet at a known fixed interval (for example, every 20 ms). However, in the packet-switched network that this application's traffic traverses, there is no guarantee the packets will arrive at their destination with the same 20 ms interval rate. To compensate for this uneven interval, the receiving equipment stores incoming packets in a jitter buffer and attempts to play out the arriving packets at the interval at which they were transmitted. To accomplish this method, additional latency is introduced by buffering packets for a certain amount of time before forwarding them at the fixed interval."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9072372913360596, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(3202.509661458333)), (np.float64(568.75), np.float64(3265.6919531249996)), (np.float64(1190.003662109375), np.float64(3265.6919531249996)), (np.float64(1190.003662109375), np.float64(3202.509661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b7e59a852c82cb4f6be077219a261d97', 'category': 'Title', 'element_id': '887b2a3b08b55713b6000ed2ab83438a'}, page_content='4.4.2.4 Packet Loss'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.923071026802063, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.0228271484375), np.float64(3310.134661458333)), (np.float64(568.0228271484375), np.float64(3420.712786458333)), (np.float64(2618.883494791666), np.float64(3420.712786458333)), (np.float64(2618.883494791666), np.float64(3310.134661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '887b2a3b08b55713b6000ed2ab83438a', 'category': 'NarrativeText', 'element_id': 'd5f4b66a315577a98cf676966d980006'}, page_content='Packet loss measures the number of packets transmitted by a source, but not received by the destination. The most common cause of packet loss is network congestion. Congestion occurs'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5303984880447388, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(1684.22021484375), np.float64(3562.900286458333)), (np.float64(1684.22021484375), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '887b2a3b08b55713b6000ed2ab83438a', 'category': 'NarrativeText', 'element_id': '106ca530958bd230b9995710fcbbea82'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5764698386192322, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(2544.864583333333), np.float64(3514.3013281249996)), (np.float64(2544.864583333333), np.float64(3562.900286458333)), (np.float64(2624.605712890625), np.float64(3562.900286458333)), (np.float64(2624.605712890625), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '887b2a3b08b55713b6000ed2ab83438a', 'category': 'NarrativeText', 'element_id': 'c01d7ac3af5d742c148f006dd7152833'}, page_content='131'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.6227678060531616, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3579.9263281249996)), (np.float64(353.6458333333333), np.float64(3628.525286458333)), (np.float64(1920.8299560546875), np.float64(3628.525286458333)), (np.float64(1920.8299560546875), np.float64(3579.9263281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 165, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '887b2a3b08b55713b6000ed2ab83438a', 'category': 'NarrativeText', 'element_id': '861db318a3da02251e0dad30d9a8f845'}, page_content='Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9092608690261841, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(345.95452880859375), np.float64(251.28049479166657)), (np.float64(345.95452880859375), np.float64(299.87945312500017)), (np.float64(979.2113037109375), np.float64(299.87945312500017)), (np.float64(979.2113037109375), np.float64(251.28049479166657))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 166, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': '2630dae2672d931496e9280c221998aa'}, page_content='4.4.3 Bandwidth Allocation'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9443827271461487, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.9158325195312), np.float64(400.7596614583332)), (np.float64(565.9158325195312), np.float64(573.3169531250002)), (np.float64(2580.602244791666), np.float64(573.3169531250002)), (np.float64(2580.602244791666), np.float64(400.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 166, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2630dae2672d931496e9280c221998aa', 'category': 'NarrativeText', 'element_id': '6609210dad0b88382b79bfbff6b7c955'}, page_content='when the volume of traffic exceeds the available bandwidth, causing packets to fill queues internal to network devices at a rate faster than those packets can be transmitted from the device. When this condition exists, devices drop packets to keep network conditions stable.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9518455862998962, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.7896728515625), np.float64(619.5096614583332)), (np.float64(565.7896728515625), np.float64(1040.528564453125)), (np.float64(2647.956298828125), np.float64(1040.528564453125)), (np.float64(2647.956298828125), np.float64(619.5096614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 166, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2630dae2672d931496e9280c221998aa', 'category': 'NarrativeText', 'element_id': 'b597709575f6f409bf9d7ff666c59cce'}, page_content='Applications built on a TCP (Transmission Control Protocol) transport interpret the absence of these packets (and the absence of their related ACKs) as congestion and they invoke standard TCP slow-start and congestion avoidance techniques. With real-time applications, such as VoIP or streaming video, it is often impossible to gracefully recover these lost packets for lack of enough time to retransmit lost packets. Packet loss may affect the application in adverse ways. For example, parts of words in a voice call may be missing or there may be an echo, or video images may break up or become block-like (pixilation effects).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9228888750076294, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1131.2924218749997)), (np.float64(568.75), np.float64(1199.3601302083334)), (np.float64(1508.9681396484375), np.float64(1199.3601302083334)), (np.float64(1508.9681396484375), np.float64(1131.2924218749997))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 166, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2630dae2672d931496e9280c221998aa', 'category': 'Title', 'element_id': '28c38b85fad41ba993b6450c8ad2a5df'}, page_content='4.4.3 Bandwidth Allocation'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9399064779281616, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1242.947161458333)), (np.float64(568.75), np.float64(1415.5044531249998)), (np.float64(2563.1387031249997), np.float64(1415.5044531249998)), (np.float64(2563.1387031249997), np.float64(1242.947161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 166, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '28c38b85fad41ba993b6450c8ad2a5df', 'category': 'NarrativeText', 'element_id': '2b45a346d3f9edc5c370aaf5ef900bc9'}, page_content="Over-subscription of satellite bandwidth, as well as network conditions such as rain fade, cause situations in which the available bandwidth is not sufficient to satisfy all subscribers' demand at a given point in time."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.942989706993103, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1461.697161458333)), (np.float64(568.75), np.float64(1758.5294189453125)), (np.float64(2634.4147447916666), np.float64(1758.5294189453125)), (np.float64(2634.4147447916666), np.float64(1461.697161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 166, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '28c38b85fad41ba993b6450c8ad2a5df', 'category': 'NarrativeText', 'element_id': '55d02529d34b7465d4ac7b1c7efb8662'}, page_content='The Velocity GBWM subsystem allocates available bandwidth according to the configured GBWM tree, configuration of the GSPs and SSPCs in that tree, and current satellite network conditions. GBWM uses a demand and allocation algorithm, whereby demand originates from SSPCs on individual satellite terminals and flows up the Global QoS Enforcement (GQE) tree to the satellite network level, and capacity is allocated down the tree.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9437422752380371, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1804.4054947916663)), (np.float64(568.75), np.float64(2224.8794531249996)), (np.float64(2621.763703125), np.float64(2224.8794531249996)), (np.float64(2621.763703125), np.float64(1804.4054947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 166, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '28c38b85fad41ba993b6450c8ad2a5df', 'category': 'NarrativeText', 'element_id': 'c10b8e1d3726fea66bfa797922538a32'}, page_content='The GBWM subsystem uses the configured GBWM tree to create iNet-specific GQE trees, and allocates available satellite capacity to fulfill the demand of subscribers in real-time according to those GQE trees, their service plan parameters, variations in available bandwidth, contention, and congestion. Each GSP and SSPC has properties that control bandwidth allocation and bandwidth requests. These properties are configured specifically at each node in the tree. How these properties are configured determines how available bandwidth is distributed among groups of competing nodes in the tree.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9407904744148254, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2271.072161458333)), (np.float64(568.75), np.float64(2443.6294531249996)), (np.float64(2632.7421875), np.float64(2443.6294531249996)), (np.float64(2632.7421875), np.float64(2271.072161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 166, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '28c38b85fad41ba993b6450c8ad2a5df', 'category': 'NarrativeText', 'element_id': 'dfc3c9087ea730fd5f846bb7e8ea27dc'}, page_content="SSPCs, resident on the satellite terminal, are the 'leaves' of the tree, and do not have any nodes below them. SSPCs originate demand requests. GSPs cannot originate any demand, and only ever aggregate demand from the nodes below them, either SSPC or other GSP nodes."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.898527204990387, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(836.8328247070312), np.float64(2529.9263281249996)), (np.float64(836.8328247070312), np.float64(2702.4836197916666)), (np.float64(2575.37255859375), np.float64(2702.4836197916666)), (np.float64(2575.37255859375), np.float64(2529.9263281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 166, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '78a65af09c796ba3aa0fdbabf6fceb15'}, page_content='NOTE: The GQE tree is often also referred to as the GBWM tree, with the meaning derived from the context of the reference. In this document, the two trees are named explicitly.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9427934885025024, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.603271484375), np.float64(2839.822161458333)), (np.float64(566.603271484375), np.float64(3012.379453125)), (np.float64(2637.08837890625), np.float64(3012.379453125)), (np.float64(2637.08837890625), np.float64(2839.822161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 166, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'b2d600f731a4513b612d8b18103825a8'}, page_content='The bandwidth allocation function of the GBWM subsystem consists of a Global QoS Enforcer, a per satellite SAS QoS Enforcer, per iNets/per satellite QoS Enforcers, and the GQE trees. For more details on these portions of the GBWM subsystem, see GBWM Operations on page 160.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9376400709152222, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(3100.4263281249996)), (np.float64(568.75), np.float64(3163.608619791666)), (np.float64(1479.2381591796875), np.float64(3163.608619791666)), (np.float64(1479.2381591796875), np.float64(3100.4263281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 166, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '822b700797d59e4a443a45494a833fed'}, page_content='4.4.3.1 Allocation Algorithms'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpnt