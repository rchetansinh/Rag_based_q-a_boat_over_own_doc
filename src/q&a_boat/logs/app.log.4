/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '456e808b9ec06401abffb47e55d97fcc', 'category': 'ListItem', 'element_id': '1602caa9650d09f555b55a65a943c346'}, page_content='• A global QoS Enforcer, running on the GBWM cluster in the NOC'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8733354806900024, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1027.8429947916666)), (np.float64(673.2760416666666), np.float64(1076.441953125)), (np.float64(2379.65234375), np.float64(1076.441953125)), (np.float64(2379.65234375), np.float64(1027.8429947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 194, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '456e808b9ec06401abffb47e55d97fcc', 'category': 'ListItem', 'element_id': '1366526d1a70143d3755346342ad9261'}, page_content='• A SAS QoS Enforcer for each satellite, running on the PP cluster in the SAS'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8661362528800964, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1122.634661458333)), (np.float64(673.2760416666666), np.float64(1171.2336197916668)), (np.float64(2644.294189453125), np.float64(1171.2336197916668)), (np.float64(2644.294189453125), np.float64(1122.634661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 194, 'file_directory': '/var/fo