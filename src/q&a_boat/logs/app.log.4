388, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd2590e0808150497da6b06e38a47d3d1', 'category': 'Title', 'element_id': '2aa2bb0e67254bc73d97f25ce4a23857'}, page_content='11.4.1.2 Enable/Disable Fulfillment Ratio Statistics'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9480703473091125, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(502.8429947916665)), (np.float64(568.75), np.float64(799.3586197916668)), (np.float64(2637.621826171875), np.float64(799.3586197916668)), (np.float64(2637.621826171875), np.float64(502.8429947916665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 388, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2aa2bb0e67254bc73d97f25ce4a23857', 'category': 'NarrativeText', 'element_id': 'c7ed376f02df19c690ca601555d54c5f'}, page_content='When configuring SSPPs, you may enable or disable the generation of the new stats for all SSPCs using that SSPP. Configuration of the SSPP is possible using the NMS Web UI and through an API call to the NMS. The generation of the stats cannot be selectively enabled or disable for a given SSPC, but instead, when applied, has effect on all the SSPCs associated with the SSPP.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8845572471618652, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.6024780273438), np.float64(849.1971614583332)), (np.float64(565.6024780273438), np.float64(959.7752864583334)), (np.float64(2440.87036