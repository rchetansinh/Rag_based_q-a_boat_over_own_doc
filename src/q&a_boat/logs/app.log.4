2:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 126, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '076441efd8afe69a07eccd4d35944575', 'category': 'NarrativeText', 'element_id': 'c481700a087e0515af130b6343a2c0bd'}, page_content='Figure 3-8, shows three carriers spaced by their occupied bandwidth constraints with the planned DVB-S2 carrier (Fwanted) in the center. The difference in power spectral density between the wanted carrier and the adjacent carriers is denoted as the adjacent-channel interference (ACI) level in dBc (decibel relative to carrier).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(404.59766455135417), np.float64(3562.900286458333)), (np.float64(404.59766455135417), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 126, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '076441efd8afe69a07eccd4d35944575', 'category': 'UncategorizedText', 'element_id': 'b387a298bb7160d47aea4a356b0fd5ad'}, page_content='92'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5328029990196228, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1061.8353271484375), np.float64(3508.827880859375)), (np.float64(1061.8353271484375), np.float64(3628.525286458333)), (np.float64(2626.779296875), np.float64(3628.525