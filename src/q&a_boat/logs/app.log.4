yout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 50, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '16749acd842556de1a76b1a1c99f3929', 'category': 'Title', 'element_id': '952ffa5db9bc5dbc427bcda312ba99a0'}, page_content='1.3.1 SAS and CDC/RF Gateway Architectures'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9382667541503906, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.1353759765625), np.float64(506.4888281249999)), (np.float64(565.1353759765625), np.float64(803.0044531250002)), (np.float64(2613.451203125), np.float64(803.0044531250002)), (np.float64(2613.451203125), np.float64(506.4888281249999))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 50, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '952ffa5db9bc5dbc427bcda312ba99a0', 'category': 'NarrativeText', 'element_id': '869890f266d01567d8ddef859819f717'}, page_content='Two ground segment network options are available for deployment in the Velocity network— the traditional Satellite Access Station (SAS) architecture, and the Central Data Center (CDC) and Radio Frequency (RF) Gateway architecture. Both ground segments provide communications between the Service Provider Data communications Network (DCN) and Satellite Terminals.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9361255168914795, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.6104736328125), np.float64(849.1971614583332)), (np.float64(567.6104736328125), np.float64(1021.7544531250002)), (np.float64(2608.448486328125), np.float64(1021.7544531250002)), (np.float64(2608.448486328125), np.float64(849.1971614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 50, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '952ffa5db9bc5dbc427bcda312ba99a0', 'category': 'NarrativeText', 'element_id': '2b1973614b2ce0accb0011e1ecd00d09'}, page_content='The SAS site, sometimes referred to as a hub, is generally based on an NMS cluster, PP cluster, hub chassis and line cards, all co-located at the same site and generally sufficient to provide service over a single feeder link for one satellite.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9510583877563477, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1067.947161458333)), (np.float64(568.75), np.float64(1612.3794531249998)), (np.float64(2624.521484375), np.float64(1612.3794531249998)), (np.float64(2624.521484375), np.float64(1067.947161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 50, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '952ffa5db9bc5dbc427bcda312ba99a0', 'category': 'NarrativeText', 'element_id': '013c7ea21acdb1df85f8d5ed617f46eb'}, page_content='The CDC/RF Gateway implementation is based on geographically distributed components in which the CDC, which contains an NMS and PP cluster, is geographically separated from the RF equipment. It offers a scalable alternative to the SAS, where the total bandwidth capacity of spot beams outstrip the feeder-link capacity of any single location. Packet Processing (PP) functions, in the CDC, are consolidated at one data center instead of within the footprint of the satellite’s feeder-link. In this arrangement, multiple geographically separated RF gateways can support different feeder-links. In addition to supporting the same features and functions as the SAS, the CDC and RF Gateway architecture manages terrestrial delay and jitter, as well as packet loss and reordering between the RF Gateways and Data Centers.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8705847859382629, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1658.572161458333)), (np.float64(568.75), np.float64(1707.1711197916663)), (np.float64(2497.033935546875), np.float64(1707.1711197916663)), (np.float64(2497.033935546875), np.float64(1658.572161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 50, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '952ffa5db9bc5dbc427bcda312ba99a0', 'category': 'NarrativeText', 'element_id': '9fcbbf6b85689161b2320a637c07bec0'}, page_content='A summary of CDC and RF Gateway Architecture supported capabilities are listed below:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9149739146232605, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1753.3638281249998)), (np.float64(67