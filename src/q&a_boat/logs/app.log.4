a3780e06cf99d7e0ea'}, page_content='• Changes in iNet congestion'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.882904052734375, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(2285.6554947916666)), (np.float64(673.2760416666666), np.float64(2334.2544531249996)), (np.float64(1590.5216064453125), np.float64(2334.2544531249996)), (np.float64(1590.5216064453125), np.float64(2285.6554947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '59430bc75f34350409de5115d365733c', 'category': 'ListItem', 'element_id': 'eddbed4ed7d21130b20b9e465351893a'}, page_content='• A command through the Pulse NMS API'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8992041349411011, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.985107421875), np.float64(2380.447161458333)), (np.float64(565.985107421875), np.float64(2429.0461197916666)), (np.float64(1478.659423828125), np.float64(2429.0461197916666)), (np.float64(1478.659423828125), np.float64(2380.447161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '59430bc75f34350409de5115d365733c', 'category': 'NarrativeText', 'element_id': '5af6d3fd678533ae9bdb73bf7284dc58'}, page_content='There are three types of beam switching:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9238020777702332, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(672.38916015625), np.float64(2474.156982421875)), (np.float64(672.38916015625), np.float64(2709.7752864583335)), (np.float64(2628.508494791667), np.float64(2709.7752864583335)), (np.float64(2628.508494791667), np.float64(2474.156982421875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '59430bc75f34350409de5115d365733c', 'category': 'ListItem', 'element_id': '915d8717dde227c188a5a8a4af1ec4a8'}, page_content='• Make-before-Break (MBB) — Set up the connections on the new iNet before performing the actual switching. This is done when there is no change in polarization and no change in the LNB band between the initial and final iNets, and both iNets are on the same satellite and land at the same SAS.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9394201636314392, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(2754.531982421875)), (np.float64(673.2760416666666), np.float64(3054.0400390625)), (np.float64(2609.22314453125), np.float64(3054.0400390625)), (np.float64(2609.22314453125), np.float64(2754.531982421875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '59430bc75f34350409de5115d365733c', 'category': 'ListItem', 'element_id': 'f7ffd2ffa8fcc5781daae96ff33643ad'}, page_content='• Break-before-Make (BBM) — Break the connections on the existing iNet before switching beams. This is more disruptive, but is necessary when there is a change in polarization or a change in the LNB band or for terminal types that support only one receiver. This also requires both iNets to be on the same satellite and land at the same SAS or land at the same or different RF gateway in the CDC architecture.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9329735040664673, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(662.9468383789062), np.float64(3096.52783203125)), (np.float64(662.9468383789062), np.float64(3271.2336197916666)), (np.float64(2591.45849609375), np.float64(3271.2336197916666)), (np.float64(2591.45849609375), np.float64(3096.52783203125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '59430bc75f34350409de5115d365733c', 'category': 'ListItem', 'element_id': '76ee491d532557b28e13bdcfbd752b29'}, page_content='• Satellite Switch — This occurs when switching between satellites. The terminal reacquires into the new SAS or land at the same or different RF gateway in the CDC architecture.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.39292997121810913, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3508.64770507