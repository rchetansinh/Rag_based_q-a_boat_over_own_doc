85.247314453125), np.float64(397.541666666667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 134, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd89f78d9017cc0ec95fabebb6fb228f0', 'category': 'Title', 'element_id': '96bbf683d817a66422d41732b035fe1d'}, page_content='3.5 Upstream Carrier Operation with Adaptive TDMA'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9480912089347839, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(528.3638281249998)), (np.float64(568.75), np.float64(886.8586197916668)), (np.float64(2631.7897447916666), np.float64(886.8586197916668)), (np.float64(2631.7897447916666), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 134, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '96bbf683d817a66422d41732b035fe1d', 'category': 'NarrativeText', 'element_id': 'decaddbffa73ff55ef83ffc5c219a0d6'}, page_content='Adaptive TDMA (A-TDMA) allows satellite terminals to dynamically adapt their transmissions to the SAS in real time to the optimal symbol rate and MODCOD for the prevailing conditions. This process reduces the amount of rain margin designed into the upstream link, significantly improving the satellite terminals’ clear-sky throughput when compared to non-adaptive TDMA networks. Reducing the system resources set aside for worst-case conditions makes these resources available for data transmission.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9464238286018372, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(933.0513281249998)), (np.float64(568.75), np.float64(1231.851806640625)), (np.float64(2623.723876953125), np.float64(1231.851806640625)), (np.float64(2623.723876953125), np.float64(933.0513281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 134, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '96bbf683d817a66422d41732b035fe1d', 'category': 'NarrativeText', 'element_id': '80818e098b38ac98f32839b02b871987'}, page_content='Each satellite terminal transmits to the SAS on a shared upstream channel and dynamic time slots determined by the protocol processor. Based on QoS considerations and the link conditions of each satellite terminal, the protocol processor determines the amount of time and the frequency for each burst transmitted by the satellite terminal and provides a synchronized Burst Time Plan (BTP) to all satellite terminals.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8677374720573425, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1320.1697998046875)), (np.float64(568.75), np.float64(1391.0496826171875)), (np.float64(2151.969646212604), np.float64(1391.0496826171875)), (np.float64(2151.969646212604), np.float64(1320.1697998046875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 134, 'file_directory': '/var/folders/5z/p05w