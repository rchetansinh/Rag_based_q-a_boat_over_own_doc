ders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '9ba8ebc5064bb3d3a3354d5d20321466'}, page_content='NOTE: The MIR Fulfillment Ratio Stats are derived in the same fashion as are the CIR Fulfillment Ratio Stats, except that the configured MIR parameters are used.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9141697287559509, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(744.8340885416665)), (np.float64(568.75), np.float64(812.9017968750001)), (np.float64(2094.3829162134375), np.float64(812.9017968750001)), (np.float64(2094.3829162134375), np.float64(744.8340885416665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 389, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '3061477bcbea098c9978f8cc83516362'}, page_content='11.4.2 CIR/MIR Performance Metrics Compared'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9433573484420776, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.5482177734375), np.float64(856.4888281249998)), (np.float64(563.5482177734375), np.float64(1091.0252864583335)), (np.float64(2569.075927734375), np.float64(1091.0252864583335)), (np.float64(2569.075927734375), np.float64(856.4888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 389, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '3061477bcbea098c9978f8cc83516362', 'category': 'NarrativeText', 'element_id': '6fd79135c0bf0c03bda4852a889ded99'}, page_content='In some cases, the MIR fulfillment stats will report a better performance than the CIR fulfillment stats. Although the case may seem counter intuitive, this occurrence is possible with both CIR/MIR Fulfillment Stats and CIR/MIR Fulfillment Ratio Stats. This occurrence illustrated with with the reported metrics for an SSPC.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9518789052963257, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1137.2179947916666)), (np.float64(568.75), np.float64(1619.6711197916666)), (np.float64(2645.644287109375), np.float64(1619.6711197916666)), (np.float64(2645.644287109375), np.float64(1137.2179947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 389, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '3061477bcbea098c9978f8cc83516362', 'category': 'NarrativeText', 'element_id': '7cc689de5bdba9ab1702a7ea7098cb49'}, page_content='If during operation there is no demand, then there is no allocation. Consider the CIR first—if there is no CIR demand in a frame and consequently no allocation in the same frame, then the calculation will show that the CIR fulfillment stat and fulfillment ratio stat have a value of 1— or 100% fulfillment for both parameters. Now consider the MIR—it is defined as the demand that exceeds the CIR, but is below the configured MIR. MIR is therefore calculated as "Demand – CIR". If negative, then the demand did not exceed CIR and therefore the MIR demand was \'0\'. The allocation, would also be \'0\'. In this scenario, the MIR fulfillment Stat and Fulfillment Ratio are \'1\' —which is 100% fulfillment, as nothing was asked for and nothing was allocated.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9485097527503967, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1665.8638281249998)), (np.float64(568.75), np.float64(2086.427001953125)), (np.float64(2567.2949531249997), np.float64(2086.427001953125)), (np.float64(2567.2949531249997), np.float64(1665.8638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 389, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '3061477bcbea098c9978f8cc83516362', 'category': 'NarrativeText', 'element_id': '1dc5a10f54881d8fdcc5a07677b3252e'}, page_content="There may also be cases where the demand is below CIR, and there is no MIR demand as a result of congestion; the CIR fulfillment is '0' and the CIR fulfillment ratio is less than '1'. So MIR fulfillment and fulfillment ratio will be 1 (100%). This scenario may also seem counter- intuitive for Satellite Operators and Service Providers, as a common belief is that the MIR fulfillment is generally worse than CIR fulfillment. This relationship, however, is reversed whenever the demand is below the CIR and the CIR fulfillment is low. This is a noteworthy point to be considered by operators with regard to SLA agreements."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8896175026893616, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(3233.572161458333)), (np.float64(568.75), np.float64(3344.150286458333)), (np.float64(2627.6699531249997), np.float64(3344.150286458333)), (np.float64(2627.6699531249997), np.float64(3233.572161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 389, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '4d90754580690cc53946e8d872295622'}, page_content='From an SLA perspective, these scenarios are readily adapted into the billing arrangement, as illustrated in the following examples:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4272361397743225, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3508.96826171875)), (np.float64(353.6458333333333), np.float64(3628.525286458333)), (np.float64(1932.7449951171875), np.float64(3628.525286458333)), (np.float64(1932.7449951171875), np.float64(3508.96826171875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 389, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'ad2dfcee7dae9aa347a1a2e08c2f816b'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.38230156898498535, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(2544.864583333333), np.float64(3514.3013281249996)), (np.float64(2544.864583333333), np.float64(3562.900286458333)), (np.float64(2624.947998046875), np.float64(3562.900286458333)), (np.float64(2624.947998046875), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 389, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '90510c9a2587dafde20d976a037b319c'}, page_content='355'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8372073769569397, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(347.4673767089844), np.float64(251.28049479166657)), (np.float64(347.4673767089844), np.float64(299.90399169921875)), (np.float64(1625.718017578125), np.float64(299.90399169921875)), (np.float64(1625.718017578125), np.float64(251.28049479166657))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 390, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': '345a61e30334ba6ac96770997a0b3165'}, page_content='11.4.3 Fulfillment Ratio Stats Calculation and Reporting'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9444304704666138, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.7499999999999), np.float64(397.0963159722218)), (np.float64(568.7499999999999), np.float64(569.6511770833333)), (np.float64(2618.57958984375), np.float64(569.6511770833333)), (np.float64(2618.57958984375), np.float64(397.0963159722218))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 390, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '345a61e30334ba6ac96770997a0b3165', 'category': 'NarrativeText', 'element_id': '8315b724326d38fc0567e493fffef252'}, page_content='Case 1: Assume that SLA for the CIR fulfillment is for 96% of the time. If the measured performance is below 96% the satellite operator has some predefined penalties depending on by how much the SLA is missed.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9459362030029297, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.7804565429688), np.float64(615.8463159722218)), (np.float64(567.7804565429688), np.float64(912.3595104166666)), (np.float64(2648.185791015625), np.float64(912.3595104166666)), (np.float64(2648.185791015625), np.float64(615.8463159722218))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 390, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '345a61e30334ba6ac96770997a0b3165', 'category': 'NarrativeText', 'element_id': '1d51edca998402178bc844598cfeb6e9'}, page_content='Case 2: Assume that the SLA for the MIR Fulfillment is 50%. In the special case where demand is below CIR (all the time) the performance is at 100%. In such as case, there would be no penalties or rebates against the MIR. This result is a reasonable expectation since the service provider demand was below CIR and never crossed into MIR— the Satellite Operator should not be penalized for something that was not used (MIR demand above CIR).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9388032555580139, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.2106323242188), np.float64(958.5546493055551)), (np.float64(567.2106323242188), np.float64(1255.0678437499998)), (np.float64(2608.325927734375), np.float64(1255.0678437499998)), (np.float64(2608.325927734375), np.float64(958.5546493055551))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 390, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '345a61e30334ba6ac96770997a0b3165', 'category': 'NarrativeText', 'element_id': '7678091633c8e8598527db543cf27ae4'}, page_content='Case 3: It is more likely to have values other than 100% fulfillment for MIR. However that fulfillment can be larger than the CIR fulfillment. This scenario is explained in the same way as for the case where for part of the time the demand is below CIR so the MIR fulfillment is 100% for that portion of time and then below 100 % for other portions. So the overall performance, in this case, will be below 100% but above the CIR fulfillment.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8940793871879578, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.7500000000005), np.float64(1350.0404895833328)), (np.float64(568.7500000000005), np.float64(1418.1106284722218)), (np.float64(2401.0068359375), np.float64(1418.1106284722218)), (np.f