34)), (np.float64(2634.706411458333), np.float64(506.4888281249999))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 277, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'fed2faeb5c775e06714f8b604843ea73', 'category': 'NarrativeText', 'element_id': '2533218181a16dbc4879177eb68f08fc'}, page_content='A terminal type is a unique user-configured element in the NMS that defines a specific set of terminal components—for example, LNB, BUC, ACU, and Satellite Router. This baseline set of elements, referred to as a Terminal Type, represents a configuration template that can be used to create multiple terminals that will be based on this baseline set of terminal components. A terminal type does not dictate which terminal model it can be used to configure, but instead can be applied to any new terminal to which the components of the terminal type are desired and appropriate.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9420830011367798, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.648681640625), np.float64(973.1554947916665)), (np.float64(565.648681640625), np.float64(1270.0858154296875)), (np.float64(2569.913330078125), np.float64(1270.0858154296875)), (np.float64(2569.913330078125), np.float64(973.1554947916665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 277, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'fed2faeb5c775e06714f8b604843ea73', 'category': 'NarrativeText', 'element_id': 'c1f61fe2688e2b95bfb488a54dfe5e04'}, page_content='An important parameter that is specified when configuring a Terminal Type, is the RF Terminal Type. The RF Terminal Type is an arbitrary numerical ID (1-65535) that is unique per network, and is used to identify all terminals that share similar RF properties. The RF Terminal Type properties are actually configured on the Terminal Type tab of the Add Channel dialog or the Add Regulatory Area dialog.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.89833664894104, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1360.9799218749997)), (np.float64(568.75), np.float64(1429.0476302083334)), (np.float64(1428.5389404296875), np.float64(1429.0476302083334)), (np.float64(1428.5389404296875), np.float64(1360.9799218749997))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 277, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '4688114e65c128d4a24ac6ed13f61168', 'category': 'Title', 'element_id': '90ae5faf3c2142b71152376e4104bc98'}, page_content='7.2.8 RF Terminal Types'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9510990977287292, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.618896484375), np.float64(1472.5953369140625)), (np.float64(566.618896484375), np.float64(1893.1086197916663)), (np.float64(2639.00537109375), np.float64(1893.1086197916663)), (np.float64(2639.00537109375), np.float64(1472.5953369140625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 277, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '90ae5faf3c2142b71152376e4104bc98', 'category': 'NarrativeText', 'element_id': 'a11fd256b3ba9d0b1c021dca6db91367'}, page_content='In Velocity, the RF Terminal Type is used to identify all terminals that share similar RF properties, so that the data path components can treat them in the same manner. There is no benefit to gain by defining more than one RF terminal type for terminals with the difference in max PSD or in max EIRP less than the difference in upstream carrier C/N or C/No of most inroute group compositions. The typical spacing of C/N thresholds of ATDMA MODCODs is about 1dB. Similarly, the C/No values of upstream carriers in most inroute group compositions are rarely less than 1dB apart.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9372884035110474, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.5441284179688), np.float64(1939.3013281249998)), (np.float64(566.5441284179688), np.float64(2111.8586197916666)), (np.float64(2587.7880859375), np.float64(2111.8586197916666)), (np.float64(2587.7880859375), np.float64(1939.3013281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 277, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '90ae5faf3c2142b71152376e4104bc98', 'category': 'NarrativeText', 'element_id': '7980109e0b08b9ba2b7eaaeb4f2bcf9f'}, page_content='Although Velocity and Pulse allow the configuration of up to 1024 RF Terminal Types, configuring a large number of RF Terminal Types incurs processing costs and overhead. Two scale aspects to consider are given below:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9320046901702881, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(2150.759661458333)), (np.float64(567.5468749999999), np.float64(2385.2961197916666)), (np.float64(2586.900146484375), np.float64(2385.2961197916666)), (np.float64(2586.900146484375), np.float64(2150.759661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 277, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '90ae5faf3c2142b71152376e4104bc98', 'category': 'ListItem', 'element_id': '921cddfdff6e76b7f19a7375426ad178'}, page_content='1. The time to load the Pulse Add Channel and Add Regulatory Area dialogs will increase proportionally with the number of configured RF Terminal Types in that channel or regulatory area. For example, an increase from 50 to 250 RF Terminal Types will cause the dialog load time to increase 5 times as well.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9431541562080383, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(2424.197161458333)), (np.float64(567.5468749999999), np.float64(2721.7900390625)), (np.float64(2610.206411458333), np.float64(2721.7900390625)), (np.float64(2610.206411458333), np.float64(2424.197161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 277, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '90ae5faf3c2142b71152376e4104bc98', 'category': 'ListItem', 'element_id': '8d26bd628fd291913fb2246a5a230d94'}, page_content='2. The OTA overhead to broadcast terminal information will increase as the number of RF Terminal Types increases. With up to 78 RF Terminal Types, the overhead amounts to 2.34kbps on the downstream channel. Additional 2.34 kbps broadcast overhead will accommodate another 78 RF Terminal Types and so on. For example, configuring 250 RF Terminal Types will incur 2.34 x 4 = 9.36 kbps of overhead transmission.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.912239134311676, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(788.715087890625), np.float64(2805.16943359375)), (np.float64(788.715087890625), np.float64(3165.504453125)), (np.float64(2570.89404296875), np.float64(3165.504453125)), (np.float64(2570.89404296875), np.float64(2805.16943359375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 277, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '81c6ed20529a5b32ad2a897c2e8faf9f'}, page_content='NOTE: Pulse 2.6.0.2 and below limit configured RF Terminal Types to 78. To use more than 78 RF Terminal Types, the user needs to upgrade to Pulse 2.7.1.2 or contact iDirect TAC for the next step. Velocity 3.2.1.x Terminal software must be installed to use RF Terminal types above 78. Terminals with earlier software version should only be configured with RF Terminal types in the range 1-77.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90cl