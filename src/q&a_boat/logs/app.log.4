t_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 70, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a8d64f2358765b50e3244e39e114f131', 'category': 'NarrativeText', 'element_id': '2f3281be6b8d8577b9c3dafe0b60c306'}, page_content='The operator can configure the optimum outermost contour for a given terminal type (from a group of concentric contours defined by the operator for a given beam). For example, if the FOM threshold is set to 5,000 for a particular terminal type, the PP will use a FOM contour with a FOM of value less than or equal to 5,000 as the beam edge for that terminal type.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9334207773208618, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(841.9054947916665)), (np.float64(568.75), np.float64(952.4836197916668)), (np.float64(2562.919953125), np.float64(952.4836197916668)), (np.float64(2562.919953125), np.float64(841.9054947916665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 70, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a8d64f2358765b50e3244e39e114f131', 'category': 'NarrativeText', 'element_id': '763e2823da8df608eb475820488f46f5'}, page_content="The FOM Threshold for Smaller Terminals Feature helps match beam performance with the terminal's capabilities, avoiding connection/switching issues."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9287744164466858, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1001.9382552083331)), (np.float64(568.75), np.float64(1055.4226302083334)), (np.float64(1585.341552734375), np.float64(1055.4226302083334)), (np.float64(1585.341552734375), np.float64(1001.9382552083331))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 70, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a8d64f2358765b50e3244e39e114f131', 'category': 'Title', 'element_id': '5ea15906490eaa4614aa1eb25c4b963a'}, page_content='2.1.1.1.1 Basic FOM Contour Operation'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9374780058860779, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.528076171875), np.float64(1100.759661458333)), (np.float64(566.528076171875), np.float64(1335.2961197916668)), (np.float64(2599.378286458333), np.float64(1335.2961197916668)), (np.float64(2599.378286458333), np.float64(1100.759661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 70, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '5ea15906490eaa4614aa1eb25c4b963a', 'category': 'NarrativeText', 'element_id': 'f5285d2e7168b2e2d0de4f5facfebbe3'}, page_content="The Velocity platform supports a single FOM map for all terminal types, assuming that all terminals can operate within the edge of a beam, even at the very edge. This approach can be problematic for smaller terminals, as they may struggle to maintain service at the beam's edge."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9487600326538086, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.5650634765625), np.float64(1381.4888281249998)), (np.float64(568.5650634765625), np.float64(1739.9836197916663)), (np.float64(2615.40625), np.float64(1739.9836197916663)), (np.float64(2615.40625), np.float64(1381.4888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 70, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '5ea15906490eaa4614aa1eb25c4b963a', 'category': 'NarrativeText', 'element_id': '64ed45b93c438a3b969ceb4edf0b3544'}, page_content='Different terminals have different transmit and receive capabilities. These capabilities determine locations within a beam where the terminal can close the link with hub and can access the network. Satellite beams are usually stronger toward the center of the beam. The performance of a terminal is the best in the innermost contour and degrades towards the outer contours. The outermost contour for a terminal represents the boundary of where the terminal can access and operate in a given beam.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9532757997512817, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.044189453125), np.float64(1785.1346435546875)), (np.float64(568.044189453125), np.float64(2206.650286458333)), (np.float64(2632.0449531249997), np.float64(2206.650286458333)), (np.float64(2632.0449531249997), np.float64(1785.1346435546875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 70, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '5ea15906490eaa4614aa1eb25c4b963a', 'category': 'NarrativeText', 'element_id': '8e3a871062ce81bdd295fb6ddfbe19d9'}, page_content='This is shown in Figure 2-2 below. The red and blue beams with FOM contours are represented by circles. High-end terminals can function within both red and blue FOM contours, while lower-end terminals can only operate within the inner FOM contours (represented by solid lines). If a lower-end terminal is at position x2 and the system tries to switch it to the blue beam, it may lose connection due to its limitations. Similarly, at position x1, the system may incorrectly assume the terminal can operate within the red beam’s contour, leading to a loss of connection.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8440749645233154, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1008.8240356445312), np.float64(3217.7127864583335)), (np.float64(1008.8240356445312), np.float64(3266.3117447916666)), (np.float64(2177.9215853368746), np.float64(3266.3117447916666)), (np.float64(2177.9215853368746), np.float64(3217.7127864583335))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 70, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '61c7f8c3b053d01bf471dd5d73550f0e'}, page_content='Figure 2-2. Basic FOM Contour Operation Overview'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad