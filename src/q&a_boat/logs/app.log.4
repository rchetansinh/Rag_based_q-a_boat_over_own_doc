: 212, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c11410786e70480156cf55f5cc07ca44', 'category': 'ListItem', 'element_id': '79723302f94d9727e0a5f250e655fff2'}, page_content='• the last measured efficiency, M = 2.0'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8834145665168762, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(2225.2075781249996)), (np.float64(673.2760416666666), np.float64(2275.993489583333)), (np.float64(1995.9403076171875), np.float64(2275.993489583333)), (np.float64(1995.9403076171875), np.float64(2225.2075781249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 212, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c11410786e70480156cf55f5cc07ca44', 'category': 'ListItem', 'element_id': '0e91b315b9b6e48786437eda7e0877d4'}, page_content='• since 2.0 ≥ 1.8 or M ≥ E, then the CIR/MIR is not changed'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9434403777122498, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2322.060302734375)), (np.float64(568.75), np.float64(2619.5044531249996)), (np.float64(2645.211669921875), np.float64(2619.5044531249996)), (np.float64(2645.211669921875), np.float64(2322.060302734375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 212, 'file_directory': '/var/folders/5