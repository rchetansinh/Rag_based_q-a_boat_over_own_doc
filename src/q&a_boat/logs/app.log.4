03125)), (np.float64(2641.612548828125), np.float64(1543.3477783203125)), (np.float64(2641.612548828125), np.float64(1060.6554947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 173, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'e59ef841f670a1055edc8e3cec8185fd'}, page_content='For example, support for multi-parent GSPs enables the following situation: a service provider wishes to offer a global service, but wants to provide subscribers with higher throughput when they are located in a regional coverage area and lower throughput when they are outside that area. As shown in the diagram below, the service provider can define a regional GSP (GSP1) and a global GSP (GSP2), and configure the subscriber service plan (SSPC1) to have both GSPs as parents. The subscriber service plan would draw bandwidth from only one of its possible GSP parents at a time - the regional GSP when it is located in the regional coverage area, and from the global GSP when outside the regional coverage area.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8000684380531311, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1109.5), np.float64(3188.5461197916666)), (np.float64(1109.5), np.float64(3237.1450781249996)), (np.float64(2089.1181640625), np.float64(3237.1450781249996)), (np.float64(2089.1181640625), np.float64(3188.5461197916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 173, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_uplo