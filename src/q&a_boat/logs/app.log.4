80810546875), np.float64(2297.960693359375)), (np.float64(2631.080810546875), np.float64(1937.1060791015625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 349, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a115ba57efaeaa311755ccfd76a56e1d', 'category': 'NarrativeText', 'element_id': '45d8ef1195c9cdb46e91fc051aa08d7d'}, page_content='In the Channel object, which corresponds geographically to the current beam, a Max C/N value is configured for each RA that the channel (beam) intersects. To link the Max C/N con- figuration in the channel with the correct RA, the Channel object associates each Max C/N with the RA Element ID. Whereas the applied algorithm is the same as with the prior method, the new implementation uses a Max C/N specific to the Channel/RA combination, as opposed to applying one value across the entire RA, as in the prior implementation.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9446151852607727, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2347.306640625)), (np.float64(568.75), np.float64(2644.1502864583335)), (np.float64(2640.357453125), np.float64(2644.1502864583335)), (np.float64(2640.357453125), np.float64(2347.306640625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 349, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a115ba57efaeaa311755ccfd76a56e1d', 'category': 'NarrativeText', 'element_id': '95daf4ff96f179d6c207b15479b094e2'}, page_content='During acquisition, several transactions occur using the default (worst-case) power and PSD limits for slot assignments. For a brief period of less than 1 second, efficiency is affected for a very small amount of management traffic, with no impact on user traffic or risk of regulatory infringement. Also, there is no impact on acquisition, as it applies only after geo-location, when the Regulatory Area is known.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9451094269752502, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2693.9888281249996)), (np.float64(568.75), np.float64(3052.4836197916666)), (np.float64(2631.8262031249997), np.float64(3052.4836197916666)), (np.float64(2631.8262031249997), np.float64(2693.9888281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 349, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a115ba57efaeaa311755ccfd76a56e1d', 'category': 'NarrativeText', 'element_id': '2f927706e7fb3f7c712d21ad5363dd44'}, page_content='As this new implementation is based on the Regulatory Area, which is known to the PP only after the remote sends a geo-location message—several steps into the acquisition over-the-air process, acquisition behavior is not affected. The PP periodically broadcasts messages tailored to each of the Terminal Types allowed in the iNet. To compute its initial transmit power, and PSD limits, the terminal uses Initial Tx Power from the Acquisition Parameters Descriptor within the TIM. The remote is unaware of the new method of configuration.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9400014281272888, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.6402587890625), np.float64(3102.322161458333)), (np.float64(566.6402587890625), np.float64(3398.837786458333)), (np.float64(2628.499755859375), np.float64(3398.837786458333)), (np.float64(2628.499755859375), np.float64(3102.322161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 349, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a115ba57efaeaa311755ccfd76a56e1d', 'category': 'NarrativeText', 'element_id': '80187cd214989a339c1722ac48dc9393'}, page_content='As the PP determines slot assignments for a terminal, it now incorporates the max C/N based on the physical location of the terminal (both its RA and its beam). Note that the remote is unaware of the additional information available in the PP; all OTA messaging is unchanged by the new algorithm in the PP. The PP already takes physical layer limits into account for beam selection; setting those limits with more granularity will affect beam switch decisions.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4146570861339569, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(1681.374755859375), np.float64(3562.900286458333)), (np.float64(1681.374755859375), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 349, 'file_directory': '/var/folders/5z/p05