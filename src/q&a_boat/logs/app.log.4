float64(506.4888281249999))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 316, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'e8a454587af27ebe61f016dffba437b5', 'category': 'NarrativeText', 'element_id': '40122ff1f588e7888d6c5874c00b8864'}, page_content='After receiving a CM value table for all of the iNets, from each SAS, the CNG_Proxy process at the NOC constructs a consolidated table that contains the CM values for all the iNets in the entire system (all SASs and all iNets). The consolidated table includes a version number of the table, and a new date-time stamp generated at the NOC, for the time at which the new table is published. To ensure that each SAS in the network has CM data for all other SASs, the consolidated CM table, is then sent from the NOC to each SAS in the network.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9398850798606873, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(911.1763281249998)), (np.float64(568.75), np.float64(1083.7336197916668)), (np.float64(2641.219482421875), np.float64(1083.7336197916668)), (np.float64(2641.219482421875), np.float64(911.1763281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 316, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'e8a454587af27ebe61f016dffba437b5', 'category': 'NarrativeText', 'element_id': '5eab9f8a30815fb9995955806bfc7a84'}, page_content='Based on the consolidated congestion informatio