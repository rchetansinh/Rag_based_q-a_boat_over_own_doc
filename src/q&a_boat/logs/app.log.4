_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 127, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd2df6adec3e7506677f8dc60134c59ea', 'category': 'NarrativeText', 'element_id': '6b7cfa1431acc69a513212ee405ea156'}, page_content='For DVB-S2 roll-off factors of 10, 15 and 20%, the BER degradation of the wanted carrier does not exceed 0.25 dB from LBA guide across all supported MODCODs for ACI levels of +7 dBc (each) on either side independent of the symbol rate, roll-off and waveform modulation type of the adjacent carriers. However, for 5% roll-off factor, the robustness to ACI levels is degraded slightly.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9332128763198853, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1691.384661458333)), (np.float64(568.75), np.float64(1863.9419531249998)), (np.float64(2616.860595703125), np.float64(1863.9419531249998)), (np.float64(2616.860595703125), np.float64(1691.384661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 127, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd2df6adec3e7506677f8dc60134c59ea', 'category': 'NarrativeText', 'element_id': 'f014bac4c5361967129a3055e03db723'}, page_content='Based on carrier arrangements robustness to ACI levels for 5% roll-off factor vary from +4 dBc to +7 dBc on either side. The worst case typically occurs at the highest operating MODCOD under the following conditions:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kv