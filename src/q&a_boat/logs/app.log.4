)), (np.float64(566.1580810546875), np.float64(795.7127864583334)), (np.float64(2596.268310546875), np.float64(795.7127864583334)), (np.float64(2596.268310546875), np.float64(499.1971614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a78e3560f52fefd1f75b24c099174fdb', 'category': 'NarrativeText', 'element_id': 'd11db7618893e83f344f1544a105c34e'}, page_content='There are sixteen levels of Priority Queues, from Level 1 (the highest) to Level 16 (the lowest). All high-priority queues are serviced before any lower-priority queues are serviced. When two or more queues are set to the same priority level, all queues of equal priority are serviced using a round-robin algorithm selection prior to selecting any packets from lower priority queues.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9246509671211243, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(883.7596614583332)), (np.float64(568.75), np.float64(946.9419531249996)), (np.float64(1854.1085205078125), np.float64(946.9419531249996)), (np.float64(1854.1085205078125), np.float64(883.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '286d6609b946f10b1890c1866e8c8a80', 'category': 'Title', 'element_id': '543f686bdb1a010727d3a979ca1a7326'}, page_content='4.6.6.2 Class-Based Weighted Fair Queues'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9437143802642822, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.2828979492188), np.float64(991.3846614583332)), (np.float64(568.2828979492188), np.float64(1225.9211197916668)), (np.float64(2587.375732421875), np.float64(1225.9211197916668)), (np.float64(2587.375732421875), np.float64(991.3846614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '543f686bdb1a010727d3a979ca1a7326', 'category': 'NarrativeText', 'element_id': 'c14cac4b2ef5a16fbc23b3f5d660bb91'}, page_content='Packets are selected from Class-Based Weighted Fair Queues for transmission based on the service level (or class) of the packet. Each service level is assigned a cost. Packet cost is defined as the cost of its service level multiplied by its length. Packets with the lowest cost are transmitted first, regardless of service level.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9503375887870789, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1272.1138281249998)), (np.float64(568.75), np.float64(1692.587786458333)), (np.float64(2617.1334947916666), np.float64(1692.587786458333)), (np.float64(2617.1334947916666), np.float64(1272.1138281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '543f686bdb1a010727d3a979ca1a7326', 'category': 'NarrativeText', 'element_id': '8c7f48c3f30d90154ed82739575ef099'}, page_content='The cost of a service level changes during operation. Each time a queue is passed over in favor of other service levels, the cost of the skipped queue is credited, which lowers the cost of the packets in that queue. Over time, all service levels have the opportunity to transmit, at least occasionally, even in the presence of higher priority traffic. Assuming there is a constant congested link with an equal amount of traffic at each service level, the total bandwidth available is divided more evenly by using transmission priority based on each service level cost.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8970195055007935, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1780.634661458333)), (np.float64(568.75), np.float64(1843.8169531249998)), (np.float64(1410.570068359375), np.float64(1843.8169531249998)), (np.float64(1410.570068359375), np.float64(1780.634661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '286d6609b946f10b1890c1866e8c8a80', 'category': 'Title', 'element_id': '227ca51029925f3b18aaafe4c459ebcb'}, page_content='4.6.6.3 Best-Effort Queues'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9386460781097412, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.3428344726562), np.float64(1888.259661458333)), (np.float64(563.3428344726562), np.float64(2060.8169531249996)), (np.float64(2544.2177734375), np.float64(2060.8169531249996)), (np.float64(2544.2177734375), np.float64(1888.259661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '227ca51029925f3b18aaafe4c459ebcb', 'category': 'NarrativeText', 'element_id': '76aedf9ee2bd791aa02aa16258144612'}, page_content='Packets in Best Effort Queues do not have priority or cost. All packets in these queues are treated equally by applying a round-robin selection algorithm to the queues. Best-Effort Queues are only serviced if there are no packets waiting in Priority Queues or in CBWFQs.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8937004804611206, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2152.1257552083334)), (np.float64(568.75), np.float64(2220.1934635416665)), (np.float64(1641.4912109375), np.float64(2220.1934635416665)), (np.float64(1641.4912109375), np.float64(2152.1257552083334))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '286d6609b946f10b1890c1866e8c8a80', 'category': 'Title', 'element_id': 'f0c5fc8165da129a9ccdc8d419b2be79'}, page_content='4.6.7 FAP Service Enforcement'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9475926756858826, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2259.356689453125)), (np.float64(568.75), np.float64(2560.2961197916666)), (np.float64(2637.9512031249997), np.float64(2560.2961197916666)), (np.float64(2637.9512031249997), np.float64(2259.356689453125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f0c5fc8165da129a9ccdc8d419b2be79', 'category': 'NarrativeText', 'element_id': 'f6fd66afa74338304fd5210d7563e0ad'}, page_content='As mentioned in Fair Access Policy on page 325, FAP enforcement allows service providers to define a set of rules for throttling the throughput of GSPs and SSPCs based on the total consumption (in Mbytes) within a defined period of time. FAP enforcement for GSPs and SSPCs is largely the same, but is handled by separate software processes (Group FAP Enforcer vs. Subscriber FAP Enforcer Scheduler).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.945737898349762, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2605.199951171875)), (np.float64(568.75), np.float64(2903.004453125)), (np.float64(2635.0345364583336), np.float64(2903.004453125)), (np.float64(2635.0345364583336), np.float64(2605.199951171875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f0c5fc8165da129a9ccdc8d419b2be79', 'category': 'NarrativeText', 'element_id': '2e201bc5ce7bb3f1ac1571334e2c7f6b'}, page_content='The FAP Enforcer is responsible for enforcing the FAP volume allowance defined as part of the service plan. The FAP Enforcer resides at the NOC, and receives real-time inbound/outbound traffic volumes per iNet group (for GSPs) or per SSPC. FAP enforcement verifies if any of the FAP rules have been violated; for example, if the volume usage for the allowance period has exceeded the volume allowance.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9468278288841248, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(562.8057250976562), np.float64(2945.9609375)), (np.float64(562.8057250976562), np.float64(3369.6711197916666)), (np.float64(2631.6803697916666), np.float64(3369.6711197916666)), (np.float64(2631.6803697916666), np.float64(2945.9609375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f0c5fc8165da129a9ccdc8d419b2be79', 'category': 'NarrativeText', 'element_id': '636f95f759dc7d780657416dfbfd56d4'}, page_content='The volume usage is collected for all GSPs and SSPCs from each SAS, and is then reported to the NOC every 30 seconds. The algorithm runs periodically, every 30 seconds, or at any time when it receives an action message. The action messages are either a configuration change, a Top-Up allowance request, or an update on FAP usage. The algorithm checks for the start of a FAP update period to credit the FAP balance and applies rollover when applicable. The algorithm also checks if any FAP conditions have been reached to take action, and if restoration rules for restoring the service have been met.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.3851853311061859, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(1680.948974609375), np.float64(3562.900286458333)), (np.float64(1680.948974609375), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f0c5fc8165da129a9ccdc8d419b2be79', 'category': 'NarrativeText', 'element_id': '609ce45a7be541eba74eaf9243b3863e'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5202372670173645, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(2544.864583333333), np.float64(3514.3013281249996)), (np.float64(2544.864583333333), np.float64(3562.900286458333)), (np.float64(2624.3330078125), np.float64(3562.900286458333)), (np.float64(2624.3330078125), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 209, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f0c5fc8165da129a9ccdc8d419b2be79', 'category': 'NarrativeText', 'element_id': '443c0ca933ac7bb8885fa63df21394a4'}, page_content='175'), Doc