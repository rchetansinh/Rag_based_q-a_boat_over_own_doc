4(1634.8013281249998)), (np.float64(568.75), np.float64(1697.9836197916666)), (np.float64(2165.03669802401), np.float64(1697.9836197916666)), (np.float64(2165.03669802401), np.float64(1634.8013281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 388, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': 'd3c6619a51f425a9bc08dee6e5eea64f'}, page_content='11.4.1.3 Deriving CIR/MIR Fulfillment Ratio Statistics'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9409192204475403, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(564.9742431640625), np.float64(1742.4263281249998)), (np.float64(564.9742431640625), np.float64(1976.962786458333)), (np.float64(2639.336619791666), np.float64(1976.962786458333)), (np.float64(2639.336619791666), np.float64(1742.4263281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 388, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd3c6619a51f425a9bc08dee6e5eea64f', 'category': 'NarrativeText', 'element_id': '67b88ebb0db07249ee30ab71b14d592b'}, page_content='Derivation of the CIR/MIR Ratio Stats can be described in terms of the CIR, as both are derived in the same fashion, except that the MIR fulfillment ratio stats are based on MIR related parameters. Assuming the operator has configured the desired window size for the CIR fulfillment stat, for both the downstream and upstream, the stat is derived as follows.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9509804248809814, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2023.1554947916663)), (np.float64(568.75), np.float64(2443.757568359375)), (np.float64(2594.6748046875), np.float64(2443.757568359375)), (np.float64(2594.6748046875), np.float64(2023.1554947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 388, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd3c6619a51f425a9bc08dee6e5eea64f', 'category': 'NarrativeText', 'element_id': '90c866d1970f2c1bdfeea2c0e1dacc65'}, page_content='The CIR fulfillment stat is derived based on a per frame calculation and uses the configured window for delayed fulfillment. After applying the algorithm the system determines which frames met CIR demand and which failed. The number of frames that passed is then divided by the number of intervals—for example, 300 intervals in the downstream and 240 for upstream— each of 30 second intervals. The output of the CIR/MIR fulfillment stats calculation with additional information of how much the demand was satisfied, will be used to derive the stats. The algorithm is best explained through the following diagram.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.6646940112113953, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(816.4468383789062), np.float64(3137.504453125)), (np.float64(816.4468383789062), np.float64(3186.103411458333)), (np.float64(2374.957956646406), np.float64(3186.103411458333)), (np.float64(2374.957956646406), np.float64(3137.504453125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 388, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': 'c788bba250fa76d8f67b20ede7bbadec'}, page_content='Figure 11-4. Algorithm for Calculating the CIR (MIR) fulfillment Ratio'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.2877849340438843, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(351.7124328613281), np.float64(3514.3013281249996)), (np.float64(351.7124328613281), np.float64(3562.900286458333)), (np.float64(433.5219421386719), np.float64(3562.900286458333)), (np.float64(433.5219421386719), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 388, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '7c8a889972015c2f12742438b2f76ac3'}, page_content='354'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.478619247674942, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1061.7174072265625), np.float64(3512.505615234375)), (np.float64(1061.7174072265625), np.float64(3628.525286458333)), (np.float64(2621.335645833333), np.float64(3628.525286458333)), (np.float64(2621.335645833333), np.float64(3512.505615234375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['