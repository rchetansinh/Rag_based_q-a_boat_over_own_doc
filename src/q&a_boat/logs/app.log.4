rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '81b96bd6c1871d0e1864cc298ec79402', 'category': 'UncategorizedText', 'element_id': '9e1c1b27e136c7b9591606c436e94a3b'}, page_content='•'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9336721897125244, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(584.143798828125), np.float64(2693.9888281249996)), (np.float64(584.143798828125), np.float64(2928.525286458333)), (np.float64(2628.83642578125), np.float64(2928.525286458333)), (np.float64(2628.83642578125), np.float64(2693.9888281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 330, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '81b96bd6c1871d0e1864cc298ec79402', 'category': 'ListItem', 'element_id': 'bd13252733d30471cf45449a769a449c'}, page_content='The algorithm has the ability to select a satellite based on its elevation as seen from the terminal, and its position in the active portion of the orbit. Upon receiving geolocation and time from the ACU, the remote selects an NGSO satellite or GEO satellite. Elevation is computed from its longitude (and assumed GEO orbit) or from its TLE.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9388383030891418, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(669.5725708007812), np.float64(2967.4263281249996)), (np.float64(669.5725708007812), np.float64(3201.962786458333)), (np.float64(2620.626953125), np.float64(3201.962786458333)), (np.float64(2620.626953125), np.float64(2967.4263281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 330, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '81b96bd6c1871d0e1864cc298ec79402', 'category': 'NarrativeText', 'element_id': '6b45eb2042a529336495436e625c9c73'}, page_content='A Sub-Satellite Point (SSP) Contour Map may optionally be used. The operator may configure an SSP Contour to ensure the remote only attempts to use a satellite when the satellite is visible from the RF Gateway location, and is in the active portion of its orbit to support NGSO acquisition.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9181503653526306, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(672.6132202148438), np.float64(3240.8638281249996)), (np.float64(672.6132202148438), np.float64(3351.441953125)), (np.float64(2556.9043281249997), np.float64(3351.441953125)), (np.float64(2556.9043281249997), np.float64(3240.8638281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 330, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '81b96bd6c1871d0e1864cc298ec79402', 'category': 'NarrativeText', 'element_id': '36017051bc426d072fdfc321e9dd1a45'}, page_content='This map is installed when commissioning or staging the terminal, alongside TLE information. A contour and TLE are provided for each satellite. The terminal will only'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(430.0836416027083), np.float64(3562.900286458333)), (np.float64(430.0836416027083), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 330, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '81b96bd6c1871d0e1864cc298ec79402', 'category': 'UncategorizedText', 'element_id': 'e8cf42a0101c94dcdd73ad922e86115d'}, page_content='296'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4791431427001953, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1062.55322265625), np.float64(3507.0869140625)), (np.float64(1062.55322265625), np.float64(3628.525286458333)), (np.float64(2627.099609375), np.float64(3628.525286458333)), (np.float64(2627.099609375), np.float64(3507.0869140625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 330, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '81b96bd6c1871d0e1864cc298ec79402', 'category': 'NarrativeText', 'element_id': 'bb77afa3b6fba4d680e94eb53581c9fd'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9261799454689026, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1736.8385416666665), np.float64(251.28049479166657)), (np.float64(1736.8385416666665), np.float64(299.87945312500017)), (np.float64(2631.484375), np.float64(299.87945312500017)), (np.float64(2631.484375), np.float64(251.28049479166657))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 331, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': 'dbbf52b330a1449e550c6b404dc8208f'}, page_content='7.14.2 Dynamic iNet Creation/Deletion'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9423258900642395, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(669.7523803710938), np.float64(400.7596614583332)), (np.float64(669.7523803710938), np.float64(635.2961197916668)), (np.float64(2602.311767578125), np.float64(635.2961197916668)), (np.float64(2602.311767578125), np.float64(400.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 331, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'dbbf52b330a1449e550c6b404dc8208f', 'category': 'NarrativeText', 'element_id': '1fd7bbeab9af17a7094860668192d2dd'}, page_content="acquire on a satellite if that satellite's SSP is currently within the SSP Contour. The SSP Contour and default TLE are quasi-statically configured in nonvolatile memory in the modem. The SSP Contour can be provided through the Update Manager, or through the Commissioning API/WUI."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9386751055717468, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(671.767822265625), np.float64(674.1971614583332)), (np.float64(671.767822265625), np.float64(846.7544531250002)), (np.float64(2629.984130859375), np.float64(846.7544531250002)), (np.float64(2629.984130859375), np.float64(674.1971614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 331, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'dbbf52b330a1449e550c6b404dc8208f', 'category': 'NarrativeText', 'element_id': 'a62fbc36eadc766768710e4e5371ed5d'}, page_content="The remote will use the TLE to point to any satellite for which it has a TLE (including GEO). It sends the satellite TLE to the ACU via the OpenAMIP 'O' command. The ACU uses the TLE for pointing and tracking the NGSO satellites."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.7677083611488342, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1258.011962890625), np.float64(1759.0428466796875)), (np.float64(1258.011962890625), np.float64(1808.4293212890625)), (np.float64(1939.4095458984375), np.float64(1808.4293212890625)), (np.float64(1939.4095458984375), np.float64(1759.0428466796875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 331, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': 'e8c5a67d74ec9328d1b6f42ccf09607c'}, page_content='Figure 7-24. SSP Contour Map'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9235075116157532, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1896.917421875)), (np.float64(568.75), np.float64(1964.9851302083334)), (np.float64(1842.8900146484375), np.float64(1964.9851302083334)), (np.float64(1842.8900146484375), np.float64(1896.917421875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 331, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': 'aac7b8b8bc8854f4fabc849d0af21f8a'}, page_content='7.14.2 Dynamic iNet Creation/Deletion'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9512866139411926, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2008.2369384765625)), (np.float64(568.75), np.float64(2491.0252864583335)), (np.float64(2587.1282864583336), np.float64(2491.0252864583335)), (np.float64(2587.1282864583336), np.float64(2008.2369384765625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 331, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'aac7b8b8bc8854f4fabc849d0af21f8a', 'category': 'NarrativeText', 'element_id': '16c87992f4b5979fa1f07be9008deda9'}, page_content='HEO Satellite beam footprints change as the satellite moves relative to the ground and the terminals move across the beams. Because of this, the capacity required in each beam changes over time. To address the changing capacity required, the operator may choose to activate additional “Floater” iNet(s) when capacity demand increases, and deactivate them when demand decreases. Load Balancing Processes in the iDirect platform perform load balancing when an iNet is added; and terminals are off-loaded in an iNet scheduled to be deactivated to the other active iNet in the beam. A “Floater” iNet can be activated in any beam to for increased demand that is causing congestion in that beam.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9480099081993103, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2537.2179947916666)), (np.float64(568.75), np.float64(2895.712786458333)), (np.float64(2632.883494791666), np.float64(2895.712786458333)), (np.float64(2632.883494791666), np.float64(2537.2179947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 331, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'aac7b8b8bc8854f4fabc849d0af21f8a', 'category': 'NarrativeText', 'element_id': 'a3ff431e005af0e7510e8538c335d104'}, page_content='Figure 7-25 shows the state of the beam in terms of the number of iNets in the beam at any given time. In State 1, the beam has only a single iNet, which constitutes the base capacity. Adding a “Floater” iNet takes the beam to State 2, where it has a total of two iNets. It can stay in that state for some time and then transition back to State 1 when the “Floater” iNet is deactivated. Assuming there is sufficient hardware, “Floater” iNet(s) can be added to a single beam.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.41529396176338196, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(352.7305908203125), np.float64(3508.3349609375)), (np.float64(352.7305908203125), np.float64(3628.525286458333)), (np.float64(1945.14697265625), np.float64(3628.525286458333)), (np.float64(1945.14697265625), np.float64(3508.3349609375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 331, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'aac7b8b8bc8854f4fabc849d0af21f8a', 'category': 'NarrativeText', 'element_id': '4a354f10a88fee3f57e27a1e2e4cedef'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.3493862748146057, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(2544.864583333333), np.float64(3514.3013281249996)), (np.float64(2544.864583333333), np.float64(3562.900286458333)), (np.float64(2624.943359375), np.float64(3562.900286458333)), (np.float64(2624.943359375), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 331, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'aac7b8b8bc8854f4fabc849d0af21f8a', 'category': 'NarrativeText', 'element_id': 'd340b18c807ab010213a22f5b5f3e51d'}, page_content='297'), Document(metadata={'source': '/var/folde