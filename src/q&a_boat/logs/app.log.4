97.541666666667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 329, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c62f94f4b09a2bb0ce8087e86f0bf4ba', 'category': 'Title', 'element_id': 'f19f58b942279d70e5185a670e0aa75b'}, page_content='7.14 Highly-Elliptical Orbit Support in Velocity'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9425324201583862, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(528.3638281249998)), (np.float64(568.75), np.float64(700.9211197916668)), (np.float64(2640.794953125), np.float64(700.9211197916668)), (np.float64(2640.794953125), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 329, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f19f58b942279d70e5185a670e0aa75b', 'category': 'NarrativeText', 'element_id': '8cde7f32e122ae41f9973d21dd69867e'}, page_content='The Highly-Elliptical Orbit (HEO) Feature supports HEO Satellites, which operate in a Highly Elliptical-Orbit. HEO satellites provide significantly better coverage to the arctic region where Geo Stationary Orbit (GEO) Satellite access is challenging.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9518090486526489, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.00341796875), np.float64(747.1138281249998)), (np.float64(566.00341796875), np.float64(1229.566953125)), (np.float64(2641.4147447916666), np.float64(1229.566953125)), (np.float64(2641.4147447916666), np.float64(747.1138281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 329, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f19f58b942279d70e5185a670e0aa75b', 'category': 'NarrativeText', 'element_id': '0c84ec9170a0e6a6c91d359fb357b9cf'}, page_content='Continuous service over the arctic region is accomplished by the use of multiple HEO Satellites. These satellites are not visible from the service area in the arctic region all the time, but the orbits of these satellites are chosen so that at least one satellite is visible all the time. A switchover between the satellites is required as each satellite transitions between the active and inactive arc. During periods when more than one satellite is visible, switchovers between the satellites (either automatic or through an external management system) ensures that each terminal maintains the best possible service depending on where it falls within the coverage.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8560976982116699, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.2803955078125), np.float64(1320.8757552083332)), (np.float64(568.2803955078125), np.float64(1461.8601302083334)), (np.float64(2339.019630208333), np.float64(1461.8601302083334)), (np.float64(2339.019630208333), np.float64(1320.8757552083332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 329, 'file_directory': '/var/folders/5z/p05w2v