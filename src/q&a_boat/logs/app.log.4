.2127864583335)), (np.float64(2559.2744140625), np.float64(823.6763281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 233, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2efcd16f51cd7f3019e92e34adffbdac', 'category': 'ListItem', 'element_id': 'ae038510f57f16d211e6efcd263c3cbc'}, page_content='• This command will time out after 5 minutes (by default) and terminals will be allowed to switch back into the affected beams if an RF Gateway Switchover command is not issued first and the switch command has not been explicitly canceled already. Continue with the following point.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9255340695381165, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(663.5416666666666), np.float64(1097.1138281249998)), (np.float64(663.5416666666666), np.float64(1207.691953125)), (np.float64(2597.883494791666), np.float64(1207.691953125)), (np.float64(2597.883494791666), np.float64(1097.1138281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 233, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2efcd16f51cd7f3019e92e34adffbdac', 'category': 'ListItem', 'element_id': '46e2d6a19b41355b77c74f845fabe5e3'}, page_content='b. If the operator cancels the previous switch command, the configured channel states are restored for the specified beam sets.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9240367412567139, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(1246.5929947916666)), (np.float64(567.5468749999999), np.float64(1357.1711197916668)), (np.float64(2602.65625), np.float64(1357.1711197916668)), (np.float64(2602.65625), np.float64(1246.5929947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 233, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2efcd16f51cd7f3019e92e34adffbdac', 'category': 'ListItem', 'element_id': '07f85455879f2feeb71ad40eecf0af68'}, page_content='2. RF Gateway Switchover: The satellite payload is reconfigured, permitting migration of these channels to a different feeder link'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9243766069412231, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(663.5416666666666), np.float64(1396.072161458333)), (np.float64(663.5416666666666), np.float64(1506.650286458333)), (np.float64(2584.64111328125), np.float64(1506.650286458333)), (np.float64(2584.64111328125), np.float64(1396.072161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 233, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2efcd16f51cd7f3019e92e34adffbdac', 'category': 'ListItem', 'element_id': '22cb7457fed4e6c72f64e9023b171520'}, page_content='a. if there are beam set assigned to the new RF Gateway other than those specified in the new beam set, will be unassigned fr