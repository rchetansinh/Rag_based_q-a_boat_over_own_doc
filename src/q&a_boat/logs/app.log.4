olders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': '76b7750e9b7273b3e7dc0d8c36908ba9'}, page_content='8.3 Bonded Modems'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9056338667869568, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(294.66943359375), np.float64(397.541666666667)), (np.float64(294.66943359375), np.float64(485.041666666667)), (np.float64(1245.3682861328125), np.float64(485.041666666667)), (np.float64(1245.3682861328125), np.float64(397.541666666667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '76b7750e9b7273b3e7dc0d8c36908ba9', 'category': 'Title', 'element_id': '75172a2dae1e909e1bf3ba68ec6ee5a6'}, page_content='8.3 Bonded Modems'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9450960755348206, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(528.3638281249998)), (np.float64(568.75), np.float64(824.8794531250002)), (np.float64(2564.645751953125), np.float64(824.8794531250002)), (np.float64(2564.645751953125), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '75172a2dae1e909e1bf3ba68ec6ee5a6', 'category': 'NarrativeText', 'element_id': '3ba7a07e38699a01e71090fa38007e01'}, page_content='The use of bonded modems, in Velocity, allows multiple modems to operate with a single antenna, via the ACU. Third-party solutions such as the Xiplink box can provide link aggregation at higher layers where two or more modems can make use of a single ACU and acquire onto the same satellite/beam. The bonded modems implementation significantly increases throughput — especially on the upstream.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9449033141136169, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.0510864257812), np.float64(871.0721614583332)), (np.float64(563.0510864257812), np.float64(1291.5461197916668)), (np.float64(2582.65966796875), np.float64(1291.5461197916668)), (np.float64(2582.65966796875), np.float64(871.0721614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '75172a2dae1e909e1bf3ba68ec6ee5a6', 'category': 'NarrativeText', 'element_id': '4803ce39c270bc1910460846993ad4b9'}, page_content='A master/subordinate design is the basis of the bonded modems architecture. In this implementation, one modem is designated to operate in the master mode and controls the ACU, while all other bonded modems are designated to operate in the subordinate mode. If two or more modems are deployed in a bonded configuration, each must be configured to operate in either the master or the subordinate mode. Although most bonded modem deployments will operate with two modems, there is no fixed limit as to the number of modems that may be used.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.7767055034637451, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(839.3953247070312), np.float64(1377.8429947916666)), (np.float64(839.3953247070312), np.float64(1488.4211197916666)), (np.float64(2588.404328125), np.float64(1488.4211197916666)), (np.float64(2588.404328125), np.float64(1377.8429947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '4a17d5f1eac48e7931bd1de45554a288'}, page_content='NOTE: 1) OpenBMIP capable terminals, configured with a “smart BUC,” cannot support bonded modems, as the modems do not share OpenBMIP information.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.43131348490715027, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(849.8437499999999), np.float64(1527.322161458333)), (np.float64(849.8437499999999), np.float64(1575.9211197916666)), (np.float64(2475.6328125), np.float64(1575.9211197916666)), (np.float64(2475.6328125), np.float64(1527.322161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'b37b8a0754618a13b9032f929eebe7d4'}, page_content='2) The bonded modems implementation does not bond the IP connections.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.33484530448913574, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(818.6293334960938), np.float64(1614.822161458333)), (np.float64(818.6293334960938), np.float64(1663.4211197916663)), (np.float64(2529.798583984375), np.float64(1663.4211197916663)), (np.float64(2529.798583984375), np.float64(1614.822161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'c41c4a15139576261c1d4cbc064b2e82'}, page_content='See Configuring Velocity Networks Using Pulse, for configuration details.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5634930729866028, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(849.8437499999999), np.float64(1702.322161458333)), (np.float64(849.8437499999999), np.float64(1750.9211197916663)), (np.float64(2204.2627373808855), np.float64(1750.9211197916663)), (np.float64(2204.2627373808855), np.float64(1702.322161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '55b849fbe8ac47f9a3eb13e996f0820f'}, page_content='3) 9-Series remotes do not currently support bonded modems.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8547733426094055, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.6168823242188), np.float64(1876.41064453125)), (np.float64(566.6168823242188), np.float64(1951.353515625)), (np.float64(1237.44677734375), np.float64(1951.353515625)), (np.float64(1237.44677734375), np.float64(1876.41064453125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': 'd196bf44d9990520109d3e4c98ee5c26'}, page_content='8.3.1 Master Mode'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.948122501373291, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.2908325195312), np.float64(1993.9888281249998)), (np.float64(563.2908325195312), np.float64(2414.462786458333)), (np.float64(2588.46533203125), np.float64(2414.462786458333)), (np.float64(2588.46533203125), np.float64(1993.9888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd196bf44d9990520109d3e4c98ee5c26', 'category': 'NarrativeText', 'element_id': '1506e811ed66be191fdc1bd3181f9aaf'}, page_content='In master mode the designated modem controls the ACU and acts as a relay that forwards geo-location and other status information from the ACU to all connected subordinate modems. In order to support this service, the modem operating in master mode runs an OpenAMIP server that establishes connections with subordinate modem clients to relay any ACU responses. Any incoming OpenAMIP messages from subordinate modems are ignored by the master modem, which listens on the OpenAMIP default TCP port of 5001, unless configured otherwise.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9470004439353943, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.000244140625), np.float64(2458.84765625)), (np.float64(565.000244140625), np.float64(2881.406005859375)), (np.float64(2640.6491197916666), np.float64(2881.406005859375)), (np.float64(2640.6491197916666), np.float64(2458.84765625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd196bf44d9990520109d3e4c98ee5c26', 'category': 'NarrativeText', 'element_id': 'b628465e10847aa1b50c70d8e8aeb192'}, page_content='The behavior of the master mode terminal, except for relaying any OpenAMIP messages, is the same as with any other standard mobile terminal. When the master modem drops the ACU connection, all connections with subordinate modems are terminated, which emulates the behavior as if the subordinates were actually connected to the ACU. Once the master re- establishes the ACU connection, it again listens for connections from the subordinate modems. Terminal components such as the BUC/LNB/BIM still rely on the master mode terminal for power, clock or tone/voltage for band selection.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.873037576675415, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.6825561523438), np.float64(2972.26708984375)), (np.float64(567.6825561523438), np.float64(3040.505963541666)), (np.float64(1412.1851806640625), np.float64(3040.505963541666)), (np.float64(1412.1851806640625), np.float64(2972.26708984375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '5d021e4d78678fab4915d27839a7cf43'}, page_content='8.3.2 Subordinate Mode'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9361771941184998, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(556.8335571289062), np.float64(3081.263671875)), (np.float64(556.8335571289062), np.float64(3318.629453125)), (np.float64(2558.4720364583336), np.float64(3318.629453125)), (np.float64(2558.4720364583336), np.float64(3081.263671875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 342, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '5d021e4d78678fab4915d27839a7cf43', 'category': 'NarrativeText', 'element_id': '6569c77f4994feba9563834cb0895d3e'}, page_content='In the subordinate mode, of the bonded modem architecture, modems configured as subordinates receive ACU messages relayed from the master modem. Subordinate modems behave similar to regular modems operating with OpenAMIP enabled, however they are unaware that the connection is not with a physical ACU. Since subordinate modems only'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7