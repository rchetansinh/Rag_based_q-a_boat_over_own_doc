': 'application/pdf', 'languages': ['eng'], 'page_number': 202, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'ListItem', 'element_id': '3d5f15d7946362c30ad315c2c930eb30'}, page_content='• Allocation Fairness relative to CIR — allocates available satellite bandwidth proportional to the current CIR value.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9116566777229309, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1667.6435546875)), (np.float64(673.2760416666666), np.float64(1780.087786458333)), (np.float64(2638.717041015625), np.float64(1780.087786458333)), (np.float64(2638.717041015625), np.float64(1667.6435546875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 202, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'ListItem', 'element_id': '1a70b3430350990d6c21c87494180a05'}, page_content='• Allocation Fairness relative to CIR and MIR — allocates available satellite bandwidth proportional to the current CIR value in CIR round and current MIR in the MIR round.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9074899554252625, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1826.2804947916663)), (np.float64(673.2760416666666), np.float64(1936.8586197916663)), (np.float64(2458.581298828125), np.float64(1936.8586197916663)), (np.float64(2458.581298828125), np.float64(1826.2804947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'la