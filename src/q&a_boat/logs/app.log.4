oat64(2599.8522447916666), np.float64(700.9211197916668)), (np.float64(2599.8522447916666), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '8c8163e490e2cd677e871f9555b1e6ef', 'category': 'NarrativeText', 'element_id': '3da05a08f2dd0af9c1a3539d5b6e9fa6'}, page_content='Internal Velocity traffic is carried across the backbone network and the OTA network in an SVN with ID 1, referred to as the Admin SVN. This includes all administrative traffic between the Pulse NMS, SAS components, and satellite routers.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9456084370613098, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.3555297851562), np.float64(747.1138281249998)), (np.float64(563.3555297851562), np.float64(1043.629453125)), (np.float64(2617.862661458333), np.float64(1043.629453125)), (np.float64(2617.862661458333), np.float64(747.1138281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '8c8163e490e2cd677e871f9555b1e6ef', 'category': 'NarrativeText', 'element_id': '69b0257432a17fb231b65032fc26f418'}, page_content='Other equipment in the SAS and NOC sites (such as switches, routers, and firewalls) are typically managed using a separate logical or physical monitor and control (M&C) network. Depending on the operator’s philosophy, the M&C network may also include dial-in modem connections on terminal servers in each POP and SAS to provide last-resort M&C connectivity. This M&C network may also be used to manage backbone network components.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9401493668556213, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.2720947265625), np.float64(1089.822161458333)), (np.float64(568.2720947265625), np.float64(1324.3586197916668)), (np.float64(2629.018911458333), np.float64(1324.3586197916668)), (np.float64(2629.018911458333), np.float64(1089.822161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '8c8163e490e2cd677e871f9555b1e6ef', 'category': 'NarrativeText', 'element_id': '53f4df8365ccfb9f71544e1895157ad8'}, page_content='A port on each server in Velocity clusters is designated as a debug LAN, or Dell Remote Access Controller (DRAC) port. Optionally, the satellite operator may connect this port to the M&C network to provide last-resort connectivity to debug, shut down, or recover a failed server that has become unreachable.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9119543433189392, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(313.54166666666663), np.float64(1418.375)), (np.float64(313.54166666666663), np.float64(1505.875)), (np.float64(1850.4572916666666), np.float64(1505.875)), (np.float64(1850.4572916666666), np.float64(1418.375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '073773ef961d565978790f6735188a87', 'category': 'Title', 'element_id': '2e98fd082bf6d9b1fccef9d3a9be77e2'}, page_content='2.15 Velocity Data Traffic Protocols'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8960519433021545, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.2167358398438), np.float64(1549.197161458333)), (np.float64(568.2167358398438), np.float64(1597.7961197916666)), (np.float64(2109.5605781249997), np.float64(1597.7961197916666)), (np.float64(2109.5605781249997), np.float64(1549.197161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2e98fd082bf6d9b1fccef9d3a9be77e2', 'category': 'NarrativeText', 'element_id': '66c60e97a74ff23c913a8d98f4dd603d'}, page_content='This section describes the protocols used for handling Velocity traffic.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9286163449287415, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1689.104921875)), (np.float64(568.75), np.float64(1757.1726302083334)), (np.float64(1581.03230277125), np.float64(1757.1726302083334)), (np.float64(1581.03230277125), np.float64(1689.104921875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '073773ef961d565978790f6735188a87', 'category': 'Title', 'element_id': '4178b1390f94c8ee123dc055842f09a8'}, page_content='2.15.1 IPv4 Packet Forwarding'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9382796883583069, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(559.8283081054688), np.float64(1800.759661458333)), (np.float64(559.8283081054688), np.float64(1973.3169531249998)), (np.float64(2556.46044921875), np.float64(1973.3169531249998)), (np.float64(2556.46044921875), np.float64(1800.759661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '4178b1390f94c8ee123dc055842f09a8', 'category': 'NarrativeText', 'element_id': '838a1e4177da78fa2dbaa242b33626ae'}, page_content='IPv4 packets are forwarded through the system based on the forwarding table built by the underlying routing protocols. The IPv4 implementation is compliant to all applicable standards.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9481103420257568, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2019.509661458333)), (np.float64(568.75), np.float64(2378.0044531249996)), (np.float64(2619.6126614583327), np.float64(2378.0044531249996)), (np.float64(2619.6126614583327), np.float64(2019.509661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '4178b1390f94c8ee123dc055842f09a8', 'category': 'NarrativeText', 'element_id': 'a65babd76972e5351be425af25b0c830'}, page_content='An individual routing and forwarding domain exists for each SVN in the system. Incoming IPv4 packets are checked for IP header checksum validity and are discarded if the checksum fails. As the IPv4 packets are forwarded either through the satellite router or the hub-side satellite terminal proxy, the TTL (time to live) is decremented. If the TTL decrements to zero an ICMP TTL Expired message is sent back to the source address of this packet. When the TTL is decremented, the IP header checksum is updated.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.939046323299408, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(561.5463256835938), np.float64(2424.197161458333)), (np.float64(561.5463256835938), np.float64(2658.7336197916666)), (np.float64(2564.815786458333), np.float64(2658.7336197916666)), (np.float64(2564.815786458333), np.float64(2424.197161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '4178b1390f94c8ee123dc055842f09a8', 'category': 'NarrativeText', 'element_id': 'e4282be2df3228c7eee78b49b7b72980'}, page_content='By default, the DSCP (differentiated services code point) and ECN (Explicit Congestion Notification) bits are not used. However, the DSCP bits can be used in the QoS engine to prioritize packets according to their DSCP values. The system can also rewrite the DSCP bit values if this option has been configured.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.940726637840271, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2704.9263281249996)), (np.float64(568.75), np.float64(2939.462786458333)), (np.float64(2628.87109375), np.float64(2939.462786458333)), (np.float64(2628.87109375), np.float64(2704.9263281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '4178b1390f94c8ee123dc055842f09a8', 'category': 'NarrativeText', 'element_id': 'efb800ed6aab392d6338759a548bb659'}, page_content='Velocity does not reassemble fragmented packets; the fragment bits are ignored. Packet fragmentation is not recommended, because fragmented packets cannot be accelerated. (For the importance of being able to accelerate packets, see Transmission Control Protocol (TCP) on page 72.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9251196384429932, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.7439575195312), np.float64(3030.7715885416665)), (np.float64(567.7439575195312), np.float64(3098.8392968749995)), (np.float64(1586.2366943359375), np.float64(3098.8392968749995)), (np.float64(1586.2366943359375), np.float64(3030.7715885416665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '073773ef961d565978790f6735188a87', 'category': 'Title', 'element_id': '449238436732a5091426852dcde69eab'}, page_content='2.15.2 IPv6 Packet Forwarding'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.941615641117096, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(562.6575927734375), np.float64(3142.2255859375)), (np.float64(562.6575927734375), np.float64(3438.941953125)), (np.float64(2628.531494140625), np.float64(3438.941953125)), (np.float64(2628.531494140625), np.float64(3142.2255859375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 105, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '449238436732a5091426852dcde69eab', 'category': 'NarrativeText', 'element_id': '9169d6ee1805efa6c6374ace446335d3'}, page_content='The Velocity network is capable of seamlessly and simultaneously carrying traffic using both IPv4 and IPv6. Unicast IPv6 is supported with IPv4 in all Velocity datapath components in dual- stack mode in conformance with RFC 4213, though most Performance Enhancing Proxies (PEPs) do not yet support IPv6. To use IPv6, all third-party routers and switches must also support IPv6. IPv6 multicast and the Multicast Listener Discovery (MLD), however, are not'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5909528732299805, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996))