e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9074656367301941, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(560.1182861328125), np.float64(803.2341918945312)), (np.float64(560.1182861328125), np.float64(2954.125)), (np.float64(2629.844482421875), np.float64(2954.125)), (np.float64(2629.844482421875), np.float64(803.2341918945312))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'text_as_html': '<table><thead><tr><th>Parameter</th><th>Pulse Ul Name</th><th>Description</th></tr></thead><tbody><tr><td>HYSTERESIS (MBB hysteresis)</td><td>Hysteresis Second (Add Satellite)</td><td>This value, in seconds, is configured per satellite to determine a wait period before a new satellite/beam switch is initiated post the start of a previous switch.</td></tr><tr><td>BEAM SWITCH HYSTERESIS</td><td>Hysteresis Kbps (Add Satellite)</td><td>This positive value provides stability with respect to making a beam switch (current beam more preferred). A single value is configured per satellite (SAS).</td></tr><tr><td>SAT SWITCH HYSTERESIS</td><td>Sat Hysteresis Kbps (Add Satellite)</td><td>This additional hysteresis, a positive value, affects switching stability between satellites (current satellite more preferred). Higher values discourage the system from switching satellite, as this is a more disruptive switch. A single value is configured per satellite.</td></tr><tr><td>SAT SWITCH CONGESTION CEILING</td><td>Sat Congestion Ceiling (Add Satellite)</td><td>This value prevents switching back and forth between iNets on different satellites that are both congested.</td></tr><tr><td>CONGESTION FLOOR</td><td>Congestion Floor (Add Satellite)</td><td>This value, in Kbps, is a lower limit to how much negative congestion is considered. At some point all uncongested iNets are treated as equals, even if one is lightly congested compared to others. A single value is configured per satellite.</td></tr><tr><td>CONGESTION WEIGHT</td><td>Congestion Weight (Add Satellite) (Add Terminal Type)</td><td>This positive value (no units), which specifies the relative weight of the figure- of-merit vs. the congestion metric, can be used to disable beam switching due to congestion. A single default congestion weight is configured for the whole satellite, but can be overwritten by a per Terminal</td></tr></tbody></table>', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 319, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '78428c5375acc04cf1da63128f9d28a2', 'category': 'Table', 'element_id': '61c58e194aad9b58ef821cfd77045804', 'is_table_fragment': False}, page_content='<table><thead><tr><th>Parameter</th><th>Pulse Ul Name</th><th>Description</th></tr></thead><tbody><tr><td>HYSTERESIS (MBB hysteresis)</td><td>Hysteresis Second (Add Satellite)</td><td>This value, in seconds, is configured per satellite to determine a wait period before a new satellite/beam switch is initiated post the start of a previous switch.</td></tr><tr><td>BEAM SWITCH HYSTERESIS</td><td>Hysteresis Kbps (Add Satellite)</td><td>This positive value provides stability with respect to making a beam switch (current beam more preferred). A single value is configured per satellite (SAS).</td></tr><tr><td>SAT SWITCH HYSTERESIS</td><td>Sat Hysteresis Kbps (Add Satellite)</td><td>This additional hysteresis, a positive value, affects switching stability between satellites (current satellite more preferred). Higher values discourage the system from switching satellite, as this is a more disruptive switch. A single value is configured per satellite.</td></tr><tr><td>SAT SWITCH CONGESTION CEILING</td><td>Sat Congestion Ceiling (Add Satellite)</td><td>This value prevents switching back and forth between iNets on different satellites that are both congested.</td></tr><tr><td>CONGESTION FLOOR</td><td>Congestion Floor (Add Satellite)</td><td>This value, in Kbps, is a lower limit to how much negative congestion is considered. At some point all uncongested iNets are treated as equals, even if one is lightly congested compared to others. A single value is configured per satellite.</td></tr><tr><td>CONGESTION WEIGHT</td><td>Congestion Weight (Add Satellite) (Add Terminal Type)</td><td>This positive value (no units), which specifies the relative weight of the figure- of-merit vs. the congestion metric, can be used to disable beam switching due to congestion. A single default congestion weight is configured for the whole satellite, but can be overwritten by a per Terminal</td></tr></tbody></table>'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9184991121292114, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(553.2606201171875), np.float64(470.9014892578125)), (np.float64(553.2606201171875), np.float64(2000.5474853515625)), (np.float64(2624.318359375), np.float64(2000.5474853515625)), (np.float64(2624.318359375), np.float64(470.9014892578125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'text_as_html': '<table><thead><tr><th>CONGESTION METRIC DOWNSTREAM_DS_ WEIGHT</th><th>Congestion Metric Downstream Weight (Add PP Cluster)</th><th>This positive value (no units), with a range between 0 and 1, specifies a multiplier of the measured downstream congestion, to determine its relative influence on the congestion metric calculation.</th></tr></thead><tbody><tr><td>CONGESTION METRIC UPSTREAM (US) WEIGHT</td><td>Congestion Metric Upstream Weight (Add PP Cluster)</td><td>This positive value (no units), with a range between 0 and 1, specifies a multiplier of the measured upstream congestion, to determine its relative influence on the congestion metric calculation.</td></tr><tr><td>CIR CONGESTION WEIGHT</td><td>CIR Congestion Weight (Add PP Cluster)</td><td>This configurable parameter, which has a ‘0’ to ‘1’ (inclusive) range, determines the influence of CIR/MIR on congestion. 1=CIR only; O=MIR only; values in between indicate a weighted average of CIR and MIR.</td></tr><tr><td>CM_BACKOFF</td><td>Margin Allows iNETs to be Considered Congested (Add PP Cluster)</td><td>This parameter, in Kbps , is applied to the load balancing algorithm to allow the iNet to be considered congested before an unsatisfied demand occurs. Due to this factor, terminals are load balanced away from an iNet when the congestion is within</td></tr></tbody></table>', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 320, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '841a471ac901974b2cbace9bb5aaa58a', 'category': 'Table', 'element_id': '2efec05598723e2fa2c8ddc4f3b1f612', 'is_table_fragment': False}, page_content='<table><thead><tr><th>CONGESTION METRIC DOWNSTREAM_DS_ WEIGHT</th><th>Congestion Metric Downstream Weight (Add PP Cluster)</th><th>This positive value (no units), with a range between 0 and 1, specifies a multiplier of the measured downstream congestion, to determine its relative influence on the congestion metric calculation.</th></tr></thead><tbody><tr><td>CONGESTION METRIC UPSTREAM (US) WEIGHT</td><td>Congestion Metric Upstream Weight (Add PP Cluster)</td><td>This positive value (no units), with a range between 0 and 1, specifies a multiplier of the measured upstream congestion, to determine its relative influence on the congestion metric calculation.</td></tr><tr><td>CIR CONGESTION WEIGHT</td><td>CIR Congestion Weight (Add PP Cluster)</td><td>This configurable parameter, which has a ‘0’ to ‘1’ (inclusive) range, determines the influence of CIR/MIR on congestion. 1=CIR only; O=MIR only; values in between indicate a weighted average of CIR and MIR.</td></tr><tr><td>CM_BACKOFF