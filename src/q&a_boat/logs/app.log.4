2c', 'category': 'NarrativeText', 'element_id': 'ea3665f0b8a314560a9de9859955aaed'}, page_content='See Packet Classification on page 173'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9491466283798218, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(652.2337646484375), np.float64(2694.890869140625)), (np.float64(652.2337646484375), np.float64(3059.933349609375)), (np.float64(2646.504150390625), np.float64(3059.933349609375)), (np.float64(2646.504150390625), np.float64(2694.890869140625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 279, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '7aefd9971509dc354315d118c4a0002c', 'category': 'ListItem', 'element_id': '35af246d919d2a322a8b062b84caa554'}, page_content='• IPv4 and IPv6 Unicast Traffic Routing and Forwarding — When forwarding packets, the satellite router validates the IP checksum and then decrements the TTL (time to live) and updates the checksum. Additionally, the satellite router implements the Address Resolution Protocol (ARP) to support inter-operating with external hosts. The satellite router interacts with the rest of the satellite terminal components using this private IP address space. See Chapter 12 , Layer 2 Over Satellite on page 361.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9262859225273132, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(3105.967994791666)), (np.float64(673.2760416666666), np.float64(3216.5461197916666)), (np.float64(2631.01025390625), np.float64(3216.5461197916666)), (np