_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 85, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '9f20edba830fe6d44714cda36ec13502', 'category': 'NarrativeText', 'element_id': '2f174a0fedce4e6bebdf0c714f18e929'}, page_content='The Velocity Tunnel SVN transports user traffic between PP processes and line cards. If the SAS is one of a pair of primary and backup/diversity SASs, the traffic may also be sent across the backbone network between the PP servers in the primary SAS and line cards in the backup/diversity SAS. Finally, in those networks that employ the CDC/RF Gateway architecture, the Tunnel SVN transports traffic across the WAN between the CDC and the RF Gateway.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8935620784759521, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2634.951171875)), (np.float64(568.75), np.float64(2684.254453125)), (np.float64(2392.950927734375), np.float64(2684.254453125)), (np.float64(2392.950927734375), np.float64(2634.951171875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 85, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '9f20edba830fe6d44714cda36ec13502', 'category': 'NarrativeText', 'element_id': '4b7936c9fbc5a17bfbf67893c7d863a5'}, page_content='The following guidelines apply to IP address assignment in the Velocity Tunnel SVN:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_pro