out_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 201, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '42bb52a17cbbaae015e97a323899d6e5'}, page_content='4.6.3.2.1 Beam Limits'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9346680641174316, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2481.23974609375)), (np.float64(568.75), np.float64(2717.066953125)), (np.float64(2644.003662109375), np.float64(2717.066953125)), (np.float64(2644.003662109375), np.float64(2481.23974609375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 201, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '42bb52a17cbbaae015e97a323899d6e5', 'category': 'NarrativeText', 'element_id': '9e977b372037b3ef491a805d48d95f81'}, page_content='In previous releases, the NOC GQE process had no knowledge about beam limits applied to the iNets by SAS GQE process. In cases where the GSPs were not congested, the NOC GQE over allocated bandwidth to SASs from the left over capacity. This bandwidth was wasted at SAS GQE process while distributing the bandwidth to the iNets, where beam limits were enforced.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9381986260414124, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2759.618408203125)), (np.float64(568.75), np.float64(2935.816953125)), (np.float64(2643.16796875), np.float64(2935.816953125)), (np.float64(2643.16796875), np.float64(2759.618408203125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 201, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '42bb52a17cbbaae015e97a323899d6e5', 'category': 'NarrativeText', 'element_id': 'f162e1617b83b8ea98782b5427a37df2'}, page_content='Now, the NOC GQE process distributing "excess" bandwidth to SAS or not is controlled by the GSP Mode setting in GSP configuration. The "excess" bandwidth is distributed to SAS only when the GSP mode is set to "Service Provider Legacy" and restricted in other 3 GSP modes.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9097148180007935, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2985.2715885416665)), (np.float64(568.75), np.float64(3038.7559635416665)), (np.float64(1790.6910607767707), np.float64(3038.7559635416665)), (np.float64(1790.6910607767707), np.float64(2985.2715885416665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 201, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '2de4b7520298d69444aa3c6e8ff887ec'}, page_content='4.6.3.2.2 GQoS Bandwidth Allocation Algorithm'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9322304725646973, 'is_extracted': 'true', 'coordinates': {'points': ((np.floa