_class_prob': 0.8977640271186829, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(295.66156005859375), np.float64(397.541666666667)), (np.float64(295.66156005859375), np.float64(485.3056335449219)), (np.float64(1554.90869140625), np.float64(485.3056335449219)), (np.float64(1554.90869140625), np.float64(397.541666666667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 340, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '125af7373ce6dd6c2a51df27a57604db', 'category': 'Title', 'element_id': '4e7f6a1bea8d797062f9ae2bf8b158e0'}, page_content='8.1 Terminal VLAN Mapping'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9456530809402466, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(528.3638281249998)), (np.float64(568.75), np.float64(762.9002864583334)), (np.float64(2618.45556640625), np.float64(762.9002864583334)), (np.float64(2618.45556640625), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 340, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '4e7f6a1bea8d797062f9ae2bf8b158e0', 'category': 'NarrativeText', 'element_id': 'a0d286282d922532a18630c2f0f4f1a4'}, page_content='Packets in each segment of the subscriber’s virtual network within the Velocity system contain an 802.1q tag (i.e., VLAN ID). Previously, the iDirect system required packets to have the same value in each segment and to be globally unique. In Velocity, the VLAN ID used on the Terminal LAN is locally significant.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9517558813095093, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(562.6782836914062), np.float64(809.0929947916666)), (np.float64(562.6782836914062), np.float64(1168.7730712890625)), (np.float64(2640.940786458333), np.float64(1168.7730712890625)), (np.float64(2640.940786458333), np.float64(809.0929947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 340, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '4e7f6a1bea8d797062f9ae2bf8b158e0', 'category': 'NarrativeText', 'element_id': 'dafbc604caa929b57bf5dc80b66dde90'}, page_content='VLAN mapping allows the VLAN IDs used on the terminal LAN to be different from the globally unique SVN ID used in the Velocity system. The satellite router software will map between the VLAN ID used in the OTA network and the Terminal LAN VLAN ID and will map a packet’s globally unique SVN ID to a locally-significant VLAN ID before sending it on to the terminal LAN. This enables subscribers to connect a Velocity satellite network to an existing satellite network configured to use one or more VLAN IDs.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.482800155878067, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1265.2330322265625), np.float64(1744.471923828125)), (np.float64(1265.2330322265625), np.float64(1793.3950781249996)), (np.float64(1927.787841796875), np.float64(1793.3950781249996)), (np.float64(1927.787841796875), np.float64(1744.471923828125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 340, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '25f6ae82a959a7369e5f2cc58be7ac74'}, page_content='Figure 8-1. VLAN ID Mapping'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.6273435950279236, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(845.1770833333333), np.float64(1888.259661458333)), (np.float64(845.1770833333333), np.float64(1936.8586197916663)), (np.float64(2527.39208984375), np.float64(1936.8586197916663)), (np.float64(2527.39208984375), np.float64(1888.259661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 340, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '804248c6756f38641a5efe8953d3fdad'}, page_content='NOTE: VLAN mapping on the Velocity Hub-side, is a customer responsibility.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.3093118667602539, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(352.9018859863281), np.float64(3514.3013281249996)), (np.float64(352.9018859863281), np.float64(3562.900286458333)), (np.float64(430.0836416027083), np.float64(3562.900286458333)), (np.float64(430.0836416027083), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetyp