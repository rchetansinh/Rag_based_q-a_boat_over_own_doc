'], 'page_number': 239, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': '9e1a6e2461d3e6e84a673c86ecb9d7ab'}, page_content='5.5 NMS Redundancy and Failover'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8746313452720642, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(299.14056396484375), np.float64(397.541666666667)), (np.float64(299.14056396484375), np.float64(485.07000732421875)), (np.float64(1805.605712890625), np.float64(485.07000732421875)), (np.float64(1805.605712890625), np.float64(397.541666666667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 239, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '9e1a6e2461d3e6e84a673c86ecb9d7ab', 'category': 'Title', 'element_id': '1db9c928b17c265be77a933a121f6929'}, page_content='5.5 NMS Redundancy and Failover'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9534972310066223, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(528.3638281249998)), (np.float64(568.75), np.float64(948.8377864583334)), (np.float64(2632.0449531249997), np.float64(948.8377864583334)), (np.float64(2632.0449531249997), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 239, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '1db9c928b17c265be77a933a121f6929', 'category': 'NarrativeText', 'element_id': '610d80bc29141bf5bf42a5fe21e77d60'}, page_content='The NMS is responsible for all system configuration, control, monitoring, alarming, and reporting in the Velocity system. NMS redundancy and failover ensures that a failure of any NMS element does not cause an NMS service outage or degradation of system performance. In general, the NMS accomplishes this by using the underlying virtualization platform for reliable storage and virtual machine operations. The NMS then builds on this by cleanly recovering from virtual machine restarts, and monitoring processes to ensure they are restarted in case of failure.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9149651527404785, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(995.0304947916665)), (np.float64(568.75), np.float64(1105.6086197916668)), (np.float64(2503.3105781249997), np.float64(1105.6086197916668)), (np.float64(2503.3105781249997), np.float64(995.0304947916665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 239, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '1db9c928b17c265be77a933a121f6929', 'category': 'NarrativeText', 'element_id': '89908ceee949102f03a9aa945fb9cc28'}, page_content='The following sections provide information about redundancy and failover for NMS sites, servers, and services.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8667823076248169, 'is_extracted': 'true', 'coordinates': {'points': ((np.floa