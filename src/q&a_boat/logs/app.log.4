), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9321989417076111, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(3058.572161458333)), (np.float64(568.75), np.float64(3355.087786458333)), (np.float64(2628.2160260416663), np.float64(3355.087786458333)), (np.float64(2628.2160260416663), np.float64(3058.572161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 232, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '876a6ffa09d3a4e94d8459065fa28ebe', 'category': 'NarrativeText', 'element_id': 'eac71ba116bc78c1db5b7175a651dcc1'}, page_content='The RF Gateway switchover is designed to complete while the satellite payload is being recon- figured. To ensure a fast switchover, whether the RF Gateway is currently active (supporting a set of beams), or is currently inactive (not currently supporting a set of beams), it may be modified using an RT command or using the PP console. The command to switch to active mode indicates the Beam Sets for which the RF Gateway would then be responsible.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8506902456283569, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(3404.9263281249996)), (np.float64(568.75), np.float64(3453.525286458333)), (np.float64(1905.4331523970309), np.float64(3453.525286458333)), (np.float64(1905.4331523970309), np.float64(3404.9263281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'],