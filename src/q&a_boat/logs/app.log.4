 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2623d163797746fb2ffe335bade1a217', 'category': 'Title', 'element_id': '35061cd9969aa3696bbef790fb78f552'}, page_content='7.7.2 Dynamic Configuration'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9475788474082947, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(547.3297119140625), np.float64(2558.89306640625)), (np.float64(547.3297119140625), np.float64(3045.191953125)), (np.float64(2622.3105781249997), np.float64(3045.191953125)), (np.float64(2622.3105781249997), np.float64(2558.89306640625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 292, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '35061cd9969aa3696bbef790fb78f552', 'category': 'NarrativeText', 'element_id': 'f999ea70a4fa53f60d3be98f5aaeac17'}, page_content="Any configuration information that is updated while the terminal remains operating in network is considered dynamic configuration information. This differs from static configuration information in that it can be updated without completely reloading the terminal's complete configuration, which would require a reset of the satellite router causing it to drop out of network during the update. This dynamic configuration information is passed from the SAS to the satellite router through an iDirect-specific over-the-air dynamic configuration protocol, allowing changes to be pushed to the terminal without losing operation of the terminal."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9440512657165527, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(560.2998657226562), np.float64(3085.89599609375)), (np.float64(560.2998657226562), np.float64(3387.900286458333)), (np.float64(2631.607453124999), np.float64(3387.900286458333)), (np.float64(2631.607453124999), np.float64(3085.89599609375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 292, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '35061cd9969aa3696bbef790fb78f552', 'category': 'NarrativeText', 'element_id': 'c857542588717d8769124373a4fd9d8a'}, page_content='After satellite terminal authentication and the satellite terminal is admitted into the network, the PP provides it with detailed configuration information via Dynamic File Options Exchange (DFOE). At a high level, this includes all options keys other than those required for the satellite terminal to acquire into the satellite network and those needed for it to function in the IP network.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4840138256549835, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(351.2737731933594), np.float64(3514.3013281249996)), (np.float64(351.2737731933594), np.float64(3562.900286458333)), (np.float64(431.776611328125), np.float64(3562.900286458333)), (np.float64(431.776611328125), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 292, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2623d163797746fb2ffe335bade1a217', 'category': 'Title', 'elem