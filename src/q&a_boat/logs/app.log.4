loat64(1625.759661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 188, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '7b151e015f8ad3dac7074e34e694a3c2', 'category': 'NarrativeText', 'element_id': '40ed11bc92158b2b397259c685def734'}, page_content='When the average MODCOD for a beam is equal to the nominal MODCOD the beam efficiency is 1 and, therefore, scaling is not required. If a beam has an efficiency less than the nominal MODCOD, the ratio of the efficiencies is greater than 1. For MODCOD efficiency values greater than 1, the CIR/MIR cap on symbols/sec for the beam is increased by that factor. For example, for a scaling value of 3.0 the CIR/MIR cap for the beam is increased by a factor of 3. For MODCODs that result in scaling values less than 1, the CIR/MIR cap is reduced by that factor. For example, for a value of 0.5 the CIR/MIR cap is multiplied by a factor of 0.5.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.3599000871181488, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1044.918701171875), np.float64(2109.569091796875)), (np.float64(1044.918701171875), np.float64(2162.900286458333)), (np.float64(2133.166748046875), np.float64(2162.900286458333)), (np.float64(2133.166748046875), np.float64(2109.569091796875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 188, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '7b151e015f8ad3dac7074e34e694a3c2', 'category': 'FigureCaption', 'element_id': '06e3a19e479b451147620f1352e0fb7e'}, page_content='Table 4-3. MODCOD Scaling Factor Decision Logic'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8940989375114441, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.9931640625), np.float64(2923.2924218749995)), (np.float64(566.9931640625), np.float64(2976.776796875)), (np.float64(2016.969482421875), np.float64(2976.776796875)), (np.float64(2016.969482421875), np.float64(2923.2924218749995))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 188, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '7b151e015f8ad3dac7074e34e694a3c2', 'category': 'Title', 'element_id': 'dc0a9b60bada95d77fab0e53ecfe6697'}, page_content='Calculation of the Nominal MODCOD for an Outbound GSP'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9479748010635376, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(561.9093627929688), np.float64(3022.1138281249996)), (np.float64(561.9093627929688), np.float64(3318.629453125)), (np.float64(2589.16015625), np.float64(3318.629453125)), (np.float64(2589.16015625), np.float64(3022.1138281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 188, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'dc0a9b60bada95d77fab0e53ecfe6697', 'category': 'NarrativeText', 'element_id': '08d8289287e4b5bc68a278ae2ac29091'}, page_content='Services represented by GSPs are specified using a CIR and an MIR in Mbps. However, the capacity of the DVB-S2 outbound carriers is measured in Msps and the GQE engine uses Msps to control demand and allocation in the outbound direction. Therefore, configuring an outbound GSP requires a nominal MODCOD in addition to the CIR/MIR in Mbps. The Velocity system can then translate the CIR/MIR in Mbps into the corresponding CIR/MIR in Msps.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.3619215190410614, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(433.7733459472656), np.float64(3562.900286458333)), (np.float64(433.7733459472656), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 188, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'dc0a9b60bada95d77fab0e53ecfe6697', 'category': 'NarrativeText', 'element_id': '628d063042f1e99470c4767e2254692d'}, page_content='154'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4682588279247284, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1065.411376953125), np.float64(3510.672607421875)), (np.float64(1065.411376953125), np.float64(3628.525286458333)), (np.float64(2621.734619140625), np.float64(3628.525286458333)), (np.float64(2621.734619140625), np.float64(3510.672607421875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:5