3.033640416667), np.float64(506.4888281249999))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 371, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd96b5d3ca8c75e1414822b3bb1e3d90f', 'category': 'NarrativeText', 'element_id': '3fabc7f05b8aa5ad6457b7ad8f741806'}, page_content='Persistent Multicast is one of three multicast methods, in Velocity. With persistent multicast, the protocol processor sends the multicast stream on the configured iNets without waiting for an IGMP join. The other methods include the dynamic and static multicast streams, where a 2-way connection is required. The PP sends multicast streams only after a request has been issued via an IGMPv3 connection. Persistent Multicast does not need this 2-way communication to support IGMP, and is therefore able to operate using a 1-way beam/iNet.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9354885220527649, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(558.8382568359375), np.float64(911.1763281249998)), (np.float64(558.8382568359375), np.float64(1145.7127864583335)), (np.float64(2596.4980781249997), np.float64(1145.7127864583335)), (np.float64(2596.4980781249997), np.float64(911.1763281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 371, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd96b5d3ca8c75e1414822b3bb1e3d90f', 'category': 'NarrativeText', 'element_id': 'f9833e1afb23c1550d93579643cc24fd'}, page_content='Persistent Multicast can be configured either with or without enabling Multicast Overlay. When the Multicast Overlay Mode is enabled on the terminal, the terminal will tune its secondary receiver to lock to the overlay beam. A persistent multicast service configured on the terminal will be received on the multicast receiver.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8636095523834229, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1191.9054947916666)), (np.float64(568.75), np.float64(1240.504453125)), (np.float64(2604.53564453125), np.float64(1240.504453125)), (np.float64(2604.53564453125), np.float64(1191.9054947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 371, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd96b5d3ca8c75e1414822b3bb1e3d90f', 'category': 'NarrativeText', 'element_id': 'bba05dcb4c3fd3d6525bed8bd406cae0'}, page_content='The control flow for each of the Velocity system multicast types is illustrated in the diagram:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.7364705204963684, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1057.875), np.float64(2295.3169531249996)), (np.float64(1057.875), np.float64(2343.915911458333)), (np.float64(2141.599365234375), np.float64(2343.915911458333)), (np.float64(2141.599365234375), np.float64(2295.3169531249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 371, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '61f2dc48e52278158182a62228ccaa6a'}, page_content='Figure 10-1. IP Multicast in the Velocity System'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9194208383560181, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2429.5929947916666)), (np.float64(568.75), np.float64(2492.7752864583326)), (np.float64(1494.4805908203125), np.float64(2492.7752864583326)), (np.float64(1494.4805908203125), np.float64(2429.5929947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 371, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': 'e04095d7ff7b8953b2969e21c34dc457'}, page_content='10.1.3.1 Beam/iNet Switching'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9430079460144043, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.7053833007812), np.float64(2537.2179947916666)), (np.float64(568.7053833007812), np.float64(2771.754453125)), (np.float64(2634.642333984375), np.float64(2771.754453125)), (np.float64(2634.642333984375), np.float64(2537.2179947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 371, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'e04095d7ff7b8953b2969e21c34dc457', 'category': 'NarrativeText', 'element_id': '4547205b0c86cbbd96c444e9985dd2c1'}, page_content='Beam/iNet switching, which may require a polarization or band switch, is supported on both the primary and secondary receivers. During a polarization, band or satellite switch, the receivers will switch simultaneously, since the terminal is receiving from only a single receive feed at a time.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.947193443775177, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.9520263671875), np.float64(2817.947161458333)), (np.float64(566.9520263671875), np.float64(3238.4211197916666)), (np.float64(2608.893911458333), np.float64(3238.4211197916666)), (np.float64(2608.893911458333), np.float64(2817.947161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 371, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'e04095d7ff7b8953b2969e21c34dc457', 'category': 'NarrativeText', 'element_id': '3d1ae7d6bc3ef440c2b537fe2c4f8103'}, page_content='When beam switching on the same satellite and same polarization for the unicast traffic, the secondary receiver can maintain connectivity on a wide beam to prevent un-necessary interruption of multicast services. Given this situation, preference is given to beams that do not require a change in polarity or frequency band when the primary receiver needs to beam switch. When changing the antenna to different polarizations, a beam switch will cause an interruption in the multicast traffic on the secondary receiver, of one second or less, in addition to any antenna reconfiguration time to retune and lock.'), Document(metadata={'source': '/var/folders/5z/p05w2v