61458333)), (np.float64(567.5468749999999), np.float64(1575.9211197916666)), (np.float64(2636.8209947916666), np.float64(1575.9211197916666)), (np.float64(2636.8209947916666), np.float64(1341.384661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 404, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a205b8601a425de0ee52cd580597ff83', 'category': 'ListItem', 'element_id': '2ffc933d7d90dec48d359b8a35360bc0'}, page_content='• Running Persistent Multicast along with Layer 2 — In this use case, a network operator can take advantage of Layer 2 network architecture while providing multicast service such as video distribution using the tried-and-tested persistent multicast feature in Layer 3.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8654227256774902, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(827.731201171875), np.float64(1662.2179947916663)), (np.float64(827.731201171875), np.float64(1772.7961197916663)), (np.float64(2572.618408203125), np.float64(1772.7961197916663)), (np.float64(2572.618408203125), np.float64(1662.2179947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 404, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '49d79af3942659109e68861d4cba36e3'}, page_content='In Velocity Release 2.0, Layer 2/Layer 3 Hybrid Mode is only supported on the PP. Traffic on ADMIN SVN will operate in L3 Mode.'), Document(metadata={'source': '/var/folder