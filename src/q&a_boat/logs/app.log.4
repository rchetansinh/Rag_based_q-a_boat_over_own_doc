: 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 379, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd7dced44cef095ab914bb21a698febd2', 'category': 'ListItem', 'element_id': '85ca1179d9719b2601c3382409e60d54'}, page_content='• Multicast Overlay Not Supported with Discreet Terminals — Multicast Overlay support is not available for discreet terminals.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9122627973556519, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(931.4238891601562)), (np.float64(567.5468749999999), np.float64(1046.3509521484375)), (np.float64(2446.672607421875), np.float64(1046.3509521484375)), (np.float64(2446.672607421875), np.float64(931.4238891601562))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 379, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd7dced44cef095ab914bb21a698febd2', 'category': 'ListItem', 'element_id': '3e459616699b5a8b5d4b0e552a62a117'}, page_content='• Beam-Based Geoscopes Only — Multicast overlay is only supported in a regional geoscope, which is based on beams.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9300486445426941, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(556.446044921875), np.float64(1086.91796875)), (np.float64(556.446044921875), np.float64(1263.3262939453125)), (np.float64(2546.805369791666), np.float64(1263.3262