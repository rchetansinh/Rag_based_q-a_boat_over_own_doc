c10917431b4f558c5af5fb7b'}, page_content='• QoS'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8655943274497986, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(635.4590885416666)), (np.float64(568.75), np.float64(703.7906494140625)), (np.float64(1273.027099609375), np.float64(703.7906494140625)), (np.float64(1273.027099609375), np.float64(635.4590885416666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 397, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '0ad5c4ea528b71c75a38139a3bf8714b', 'category': 'Title', 'element_id': 'd23152a23ddd59c79a6f9c99ea7df5a2'}, page_content='12.1.1 L2oS Benefits'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9337140321731567, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(709.7769775390625)), (np.float64(568.75), np.float64(875.9211197916668)), (np.float64(2563.2646484375), np.float64(875.9211197916668)), (np.float64(2563.2646484375), np.float64(709.7769775390625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 397, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd23152a23ddd59c79a6f9c99ea7df5a2', 'category': 'NarrativeText', 'element_id': '75e96fbcc4b8f3dbb51c9c57ea75fd02'}, page_content='In many VSAT applications, Layer 2 connectivity between the hub and remotes is preferred over the Layer 3 IP connections traditionally offered by iDirect. The benefits of using L2oS include:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9333062171936035, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(578.568115234375), np.float64(920.2646484375)), (np.float64(578.568115234375), np.float64(1156.6502864583335)), (np.float64(2618.7012031249997), np.float64(1156.6502864583335)), (np.float64(2618.7012031249997), np.float64(920.2646484375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 397, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd23152a23ddd59c79a6f9c99ea7df5a2', 'category': 'ListItem', 'element_id': 'eaebafed22a98edb497508f76586a3df'}, page_content='Layer 3 Transparency— Since an iDirect L2oS VSAT network behaves as a switched Ethernet network, the satellite network is invisible to higher-layer protocols. Therefore, any Layer 3 protocol, such as IPv6, OSPF, and BGP are transported transparently across the satellite network.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(922.1138281249998)), (np.float64(567.5468749999999), np.float64(970.7127864583334)), (np.float64(607.6595364583333), np.float64(970.7127864583334)), (np.float64(607.6595364583333), np.float64(922.1138281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 397, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd23152a23ddd59c79a6f9c99ea7df5a2', 'category': 'UncategorizedText', 'element_id': 'a1794d79d366dbf5bc70f0ca1a314a45'}, page_content='•'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9527258276939392, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(1195.9808349609375)), (np.float64(567.5468749999999), np.float64(1563.0146484375)), (np.float64(2632.5189114583327), np.float64(1563.0146484375)), (np.float64(2632.5189114583327), np.float64(1195.9808349609375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 397, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd23152a23ddd59c79a6f9c99ea7df5a2', 'category': 'ListItem', 'element_id': '0f1377c8c57849d7e0dd1e3a57bc9c8a'}, page_content='• Simplified Operation—In a traditional iDirect Layer 3 network, services such as Virtual Private Networks typically require allocation and configuration of a large number of IP addresses on the iDirect protocol processor and remote satellite routers. With Layer 3 transparency, this IP address allocation is no longer required. The only VLAN IP addresses required on an L2oS network are for the default VLAN used for iDirect network management and in Hybrid mode IP addresses for L3 Data VLANs only.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9287678599357605, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(564.3363647460938), np.float64(1606.0994873046875)), (np.float64(564.3363647460938), np.float64(1842.0669531249998)), (np.float64(2586.62353515625), np.float64(1842.0669531249998)), (np.float64(2586.62353515625), np.float64(1606.0994873046875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 397, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd23152a23ddd59c79a6f9c99ea7df5a2', 'category': 'ListItem', 'element_id': '64591d092010b74d0651aa76ad13253a'}, page_content='• Efficient Physical Layer—As in traditional iDirect IP networks, L2oS networks carry traffic over iDirect’s highly-optimized DVB-S2 outbound and TDMA inbound carriers. All the advantages of features such as DVB-S2 ACM and TDMA 2D 16-State coding are preserved when using L2oS.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9299831986427307, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(1885.080078125)), (np.float64(567.5468749999999), np.float64(2123.4892578125)), (np.float64(2623.60498046875), np.float64(2123.4892578125)), (np.float64(2623.60498046875), np.float64(1885.080078125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 397, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd23152a23ddd59c79a6f9c99ea7df5a2', 'category': 'ListItem', 'element_id': '757c54675f705d5838f4bc71f3d08cf2'}, page_content='• QoS Support—L2oS supports all of the QoS features that exist for iDirect IP networks. In addition, for L2oS networks, Layer 2 classifiers, such as source and destination MAC address, have been added to the Service Level and Filter Rules in Pulse NMS. IPV6 source and destination IP address classifiers have also been added.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.43043121695518494, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(342.6076965332031), np.float64(3509.264404296875)), (np.float64(342.6076965332031), np.float64(3628.525286458333)), (np.float64(1941.3131103515625), np.float64(3628.525286458333)), (np.float64(1941.3131103515625), np.float64(3509.264404296875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 397, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd23152a23ddd59c79a6f9c99ea7df5a2', 'category': 'NarrativeText', 'element_id': 'e0a7ea5c94666b9cf6c5e0c5f4d3ee3f'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.36227476596832275, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(2544.864583333333), np.float64(3514.3013281249996)), (np.float64(2544.864583333333), np.float64(3562.900286458333)), (np.float64(2624.854736328125), np.float64(3562.900286458333)), (np.float64(2624.854736328125), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 397, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'p