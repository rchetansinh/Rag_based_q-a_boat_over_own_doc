, 'detection_class_prob': 0.9033028483390808, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(668.1859741210938), np.float64(2373.1554947916666)), (np.float64(668.1859741210938), np.float64(2421.7544531249996)), (np.float64(2143.663818359375), np.float64(2421.7544531249996)), (np.float64(2143.663818359375), np.float64(2373.1554947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 324, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bf07bb9489dde3a4446822a1aa946661', 'category': 'ListItem', 'element_id': 'fc2df4a45c9cc04cfae311ca9702fc80'}, page_content='• The terminal is within the beam footprint of the candidate iNet'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8983376622200012, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(2467.947161458333)), (np.float64(673.2760416666666), np.float64(2516.5461197916666)), (np.float64(2365.0597760416663), np.float64(2516.5461197916666)), (np.float64(2365.0597760416663), np.float64(2467.947161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 324, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bf07bb9489dde3a4446822a1aa946661', 'category': 'ListItem', 'element_id': '891402083f7dd68ed532ac8e64be0e91'}, page_content='• The terminal access class and iNet access class are compatible (See Note)'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058