125), np.float64(394.8340885416665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 351, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '063ddf1b7be4e03ff709a2d146edcb53', 'category': 'Title', 'element_id': '38d78f6dd5d1b4b9314df87f8cc45670'}, page_content='8.5.3 Hybrid Skew Margin Support'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9418589472770691, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.1350708007812), np.float64(506.4888281249999)), (np.float64(563.1350708007812), np.float64(803.0044531250002)), (np.float64(2641.40576171875), np.float64(803.0044531250002)), (np.float64(2641.40576171875), np.float64(506.4888281249999))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 351, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '38d78f6dd5d1b4b9314df87f8cc45670', 'category': 'NarrativeText', 'element_id': '981fe805e1a829c5026937b0a43c5c53'}, page_content="The PSD management implementation required choosing between an angular margin mode or C/N margin (db reduction) mode, each of which produced optimal results under different conditions. Large regulatory areas, such as a single RA spanning the Earth's oceans, required an excessive C/N margin (4 to 7 dB) to avoid muting in locations of high skew, which unnecessarily penalized terminals when the skew was favorable."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9403668642044067, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(562.8676147460938), np.float64(849.1971614583332)), (np.float64(562.8676147460938), np.float64(1207.691953125)), (np.float64(2616.5869140625), np.float64(1207.691953125)), (np.float64(2616.5869140625), np.float64(849.1971614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 351, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '38d78f6dd5d1b4b9314df87f8cc45670', 'category': 'NarrativeText', 'element_id': '14b715820461f79391f20d7299dc7824'}, page_content='The Hybrid Skew Margin implementation combines the best attributes of both the C/N and angular margin modes, by permitting users to configure both parameters, which are simultaneously enforced. In this way, a sufficient operating range of skew angles can be preserved in steep regions of the PSD curve, without penalizing operations in flatter regions. In this straightforward generalization of the existing algorithm, the existing two modes of operation fall out as special cases by either setting the angular margin or dB margin to zero.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9409414529800415, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1253.884661458333)), (np.float64(568.75), np.float64(1550.400286458333)), (np.float64(2636.9668281249997), np.float64(1550.400286458333)), (np.float64(2636.9668281249997), np.float64(1253.884661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 351, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '38d78f6dd5d1b4b9314df87f8cc45670', 'category': 'NarrativeText', 'element_id': 'e19c17b879f339c6256f45b801a05a36'}, page_content='By considering angular and C/N margins concurrently, the C/N margin can be greatly reduced. In regions of favorable skew, angular margins are easily achieved such that reduction of the C/N margin permits using better MODCODs. In areas of unfavorable skew, small C/N margins are not effective and the addition of angular margins ensure that resulting skew limits are wide enough to avoid terminal muting.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9507884979248047, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.2215576171875), np.float64(1596.5929947916663)), (np.float64(566.2215576171875), np.float64(2017.6014404296875)), (np.float64(2624.060578125), np.float64(2017.6014404296875)), (np.float64(2624.060578125), np.float64(1596.5929947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 351, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '38d78f6dd5d1b4b9314df87f8cc45670', 'category': 'NarrativeText', 'element_id': '34cb2a125b5a13c8c9c29493515f161e'}, page_content="The hybrid skew margin support extends the PSD management feature to optimize the performance of Aero-terminals across a broader range of geographic regions. Network operators can specify a global minimum C/N margin, to be applied in addition to a configured angular skew margin. When calculating skew limits and maximum C/N, the PP and terminal considers both the C/N and angular margins. A further enhancement limits the application of C/N margins such that the terminal is not penalized beyond its worst-case operating point — the lowest point on the antenna's PSD curve."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8503324389457703, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(753.4337158203125), np.float64(2780.2127864583335)), (np.float64(753.4337158203125), np.float64(2828.8117447916666)), (np.float64(2446.737548828125), np.float64(2828.8117447916666)), (np.float64(2446.737548828125), np.float64(2780.2127864583335))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 351, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '18a2f178b5c99aeeebba22f0447c26c8'}, page_content='Figure 8-5. Limit determination using combined angular and PSD margins'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9161010980606079, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2883.572161458333)), (np.float64(568.75), np.float64(2932.1711197916666)), (np.float64(2218.398681640625), np.float64(2932.1711197916666)), (np.float64(2218.398681640625), np.float64(2883.572161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 351, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'fdc5c4a94358