0dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8706285953521729, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(2752.322161458333)), (np.float64(673.2760416666666), np.float64(2800.9211197916666)), (np.float64(2455.385986328125), np.float64(2800.9211197916666)), (np.float64(2455.385986328125), np.float64(2752.322161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 324, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bf07bb9489dde3a4446822a1aa946661', 'category': 'ListItem', 'element_id': '1d4ebf535622e8912baa4709397a38af'}, page_content='• The RF Terminal Type has not been excluded from Beam/iNet by the operator'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9505996704101562, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2847.1138281249996)), (np.float64(568.75), np.float64(3267.587786458333)), (np.float64(2643.335693359375), np.float64(3267.587786458333)), (np.float64(2643.335693359375), np.float64(2847.1138281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 324, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bf07bb9489dde3a4446822a1aa946661', 'category': 'NarrativeText', 'element_id': '2cf9c3a4b1de0ebd38c30ca68f285cec'}, page_content='Computation of the DM takes into account a comparison of the congestion metric (CM) values and the Figure-of-Merit (FOM) values of both the current iNet and target iNet. The FOM is a relatively static value that is proportional to the beam signal strength. Also taken into account is an additional hysteresis intended to stabilize terminal switching. This hysteresis is slightly biased in favor of the current iNet over any candidate iNets. Hysteresis values can also be operator-configured to control the amount of resistance the system will have to switching to a beam in the same, to a different satellite, or to requiring a BBM switch.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.35364362597465515, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(351.76220703125), np.float64(3514.3013281249996)), (np.float64(351.76220703125), np.float64(3562.900286458333)), (np.float64(432.252685546875), np.float64(3562.900286458333)), (np.float64(432.252685546875), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 324, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bf07bb9489dde3a4446822a1aa946661', 'category': 'NarrativeText', 'element_id': 'ed765d360ec147c0b14a6f7c62ff4220'}, page_content='290'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.49995943903923035, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1059.7149658203125), np.float64(3508.7685546875)), (np.float64(1059.7149658203125), np.float64(3628.525286458333)), (np.float64(2628.702880859375), np.float64(3628.525286458333)), (np.float64(2628.702880859375), np.float64(3508.7685546875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '20