64(845.1770833333333), np.float64(765.3429947916666)), (np.float64(845.1770833333333), np.float64(875.9211197916668)), (np.float64(2558.069580078125), np.float64(875.9211197916668)), (np.float64(2558.069580078125), np.float64(765.3429947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 130, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '662eec4240c3e526c5fe26832d665990'}, page_content='NOTE: An ACM downstream can be configured to simulate a CCM downstream by constraining the MODCOD range to a single MODCOD.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9297980666160583, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(564.09814453125), np.float64(1013.2596614583332)), (np.float64(564.09814453125), np.float64(1185.816953125)), (np.float64(2602.3678697916666), np.float64(1185.816953125)), (np.float64(2602.3678697916666), np.float64(1013.2596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 130, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '602f725fd909f3600ab3e58fd16b65f2'}, page_content="ACM allows satellite terminals operating in better signal conditions to receive data on higher MODCODs by varying the MODCOD of data to match the targeted satellite terminal's current receive capabilities."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9452369809150696, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1232.009661458333)), (np.float64(568.75), np.float64(1590.9901123046875)), (np.float64(2646.534912109375), np.float64(1590.9901123046875)), (np.float64(2646.534912109375), np.float64(1232.009661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 130, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '745018699f22da76987cff1903e39649'}, page_content='Not all data is sent to each satellite terminal at its best MODCOD. The PP/iGW transmits important system information (for example, time-plan messages), as well as broadcast traffic, at the minimum MODCOD configured for the outbound carrier. This allows all satellite terminals in the network, even those operating at the worst MODCOD, to reliably receive this information. Multicast is transmitted at a MODCOD configured in the applicable multicast subscriber service plan profile (SSPP). See Multicast Subscriber Service Plans on page 140.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9433368444442749, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.4798583984375), np.float64(1636.697161458333)), (np.float64(566.4798583984375), np.float64(1933.212786458333)), (np.float64(2623.4772447916666), np.float64(1933.212786458333)), (np.float64(2623.4772447916666), np.float64(1636.697161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 130, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '38165a6491698dd271ab3b502be1001b'}, page_content='The protocol processor determines the maximum MODCOD for all data sent to the DVB-S2 line card for transmission over the outbound carrier. However, the line card does not necessarily respect these MODCOD assignments. In the case of the ULC, this process is managed as described in the following paragraph by the line card itself; in the case of the ILC, this process is managed by the "Rook" process.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9513622522354126, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1979.4054947916663)), (np.float64(568.75), np.float64(2461.8586197916666)), (np.float64(2612.284536458333), np.float64(2461.8586197916666)), (np.float64(2612.284536458333), np.float64(1979.4054947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 130, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '24c48ce06df1d26814dff971f9c2c277'}, page_content="In the interest of downstream efficiency, some data scheduled for a high MODCOD may be transmitted at a lower one as an alternative to padding bytes into a BBFRAME. When a BBFRAME is assembled for transmission, all available data for the chosen MODCOD is first packed into the frame. If space is left in the BBFRAME, and no data left for transmission at that MODCOD, the remainder of the frame is packed with data for higher MODCODs. This method takes advantage of the fact that a satellite terminal can demodulate any MODCOD in the range between the carrier's minimum MODCOD and the current maximum MODCOD of the terminal."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9451183080673218, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2508.0513281249996)), (np.float64(568.75), np.float64(3193.60595703125)), (np.float64(2638.5830078125), np.float64(3193.60595703125)), (np.float64(2638.5830078125), np.float64(2508.0513281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 130, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '6c386b9e2834c7ae7edbc25870790177'}, page_content='The maximum MODCOD of a satellite terminal is based on the latest signal-to-noise ratio (SNR) reported by the terminal to the protocol processor. Each terminal continually measures its downstream SNR and reports the current value to the protocol processor. When the protocol processor assigns data to an individual satellite terminal, it uses the last reported SNR value to determine the highest MODCOD on which that satellite terminal can receive data without exceeding a specified bit error rate (BER). The protocol processor includes this information when sending outbound data to the line card. The line card then adjusts the MODCOD of the BBFRAMES to the targeted satellite terminals accordingly. This feedback loop, whereby the PP/iGW adjusts the MODCODs of the transmissions to the satellite terminals, is illustrated in the diagram. The SNR (or C/N) thresholds per MODCOD and the spectral efficiencies of iDirect terminals are documented in the iDirect Link Budget Analysis Guide.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.6049984693527222, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(3222.634661458333)), (np.float64(568.75), np.float64(3271.2336197916666)), (np.float64(2602.8774843749993), np.float64(3271.2336197916666)), (np.float64(2602.8774843749993), np.float64(3222.634661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 130, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'feab3f76dd2b9fe52ca59c5fb1450e62'}, page_content='For additional details on MODCODs for DVB-S2/ACM, see Outbound (DVB-S2) QoS on page 149.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(404.59766455135417), np.float64(3562.900286458333)), (np.float64(404.59766455135417), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 130, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'UncategorizedText', 'element_id': 'f0bfc383537ef323779a8d0d45c19fa4'}, page_content='96'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4984566867351532, 'is_extracted': 'true', 'coordinates': {'points': ((