Space', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 114, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'facf03006ead674329d3ab8dc2074a35', 'category': 'NarrativeText', 'element_id': '2241c6cc080abcb371ad1c4346b732e2'}, page_content='RADIUS session accounting is done by the PP server, which sends updates for any authenticated SVN to the appropriate RADIUS accounting server. These updates typically report traffic usage for the session, which includes both input and output octets. The IP addresses may also be included in these updates. The intervals between two consecutive updates is configurable, but may not be less than 30 minutes.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9300416111946106, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1875.4263281249998)), (np.float64(568.75), np.float64(1938.6086197916666)), (np.float64(1667.7000346336458), np.float64(1938.6086197916666)), (np.float64(1667.7000346336458), np.float64(1875.4263281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 114, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6242a63d9968b1ab423137ec96da0318', 'category': 'Title', 'element_id': '0ddd724e388d7fa9da716d5951778914'}, page_content='2.17.5.2 RADIUS Session Disconnect'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9426171779632568, 'is_extracted': 'true