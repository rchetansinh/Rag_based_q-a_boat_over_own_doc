 np.float64(3628.525286458333)), (np.float64(2625.425537109375), np.float64(3628.525286458333)), (np.float64(2625.425537109375), np.float64(3579.9263281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 70, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '3bb491acfe16a767ff6a5707f64a780e'}, page_content='Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9140250086784363, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1599.3525390625), np.float64(251.28049479166657)), (np.float64(1599.3525390625), np.float64(299.87945312500017)), (np.float64(2633.874755859375), np.float64(299.87945312500017)), (np.float64(2633.874755859375), np.float64(251.28049479166657))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 71, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': '13eeffebce3965f491946fc06f270111'}, page_content='2.1.1.1 FOM Threshold for Smaller Terminals'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9038543701171875, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.7503051757812), np.float64(393.08408854166646)), (np.float64(567.7503051757812), np.float64(446.56846354166674)), (np.float64(2016.5042724609375), np.float64(446.56846354166674)), (np.float64(2016.5042724609375), np.float64(393.08408854166646))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 71, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '13eeffebce3965f491946fc06f270111', 'category': 'Title', 'element_id': '94d3597016702ae666a33fdf8be75390'}, page_content='2.1.1.1.2 FOM Contour Optimization Configuration Flow'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.953043520450592, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(491.9054947916665)), (np.float64(568.75), np.float64(974.3763427734375)), (np.float64(2628.258544921875), np.float64(974.3763427734375)), (np.float64(2628.258544921875), np.float64(491.9054947916665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 71, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '94d3597016702ae666a33fdf8be75390', 'category': 'NarrativeText', 'element_id': '8abf590e9a2ba4879283fecc48d9e087'}, page_content='FOM Contours are usually based on link budget calculations that the operator should perform for terminals they are planning to deploy. For example, an operator may have a range of terminals with reflector sizes ranging from 2.4m to 60 cm. If they do link budget calculations, the 2.4 m will be the least constrained and can be used to determine the outermost Contour for the service. Smaller antenna sizes will be more constrained and will have their own outermost FOM Contour boundary, which is expected to be an inner contour with respect to that of the most unconstrained. The smallest terminals, which are most constrained, will be able to operate to yet another inner contour.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9312212467193604, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1020.5513281249998)), (np.float64(568.75), np.float64(1131.129453125)), (np.float64(2533.154541015625), np.float64(1131.129453125)), (np.float64(2533.154541015625), np.float64(1020.5513281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 71, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '94d3597016702ae666a33fdf8be75390', 'category': 'NarrativeText', 'element_id': '6a6a2dfc57b8f4686fc9b1c563cd22ba'}, page_content='The steps below give an overview of the process to follow to customize FOM Contours for different RFTTs.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9321284294128418, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(1170.0304947916666)), (np.float64(567.5468749999999), np.float64(1466.5461197916666)), (np.float64(2621.143911458333), np.float64(1466.5461197916666)), (np.float64(2621.143911458333), np.float64(1170.0304947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 71, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '94d3597016702ae666a33fdf8be75390', 'category': 'ListItem', 'element_id': '96ed315d223af46d99b428b8807b219f'}, page_content='1. Operator prepares FOM Contours for all beams and all satellites using the highest capability terminal type in the system. These represent the outer limits of performance. Note that the Maximum FOM contour that the Operator can prepare is 25400 as the outermost contour. In Figure 2-3 below, The maximum value that contour R1 can represent is 25400.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9264783263206482, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(1505.447161458333)), (np.float64(567.5468749999999), np.float64(1616.025286458333)), (np.float64(2637.8418281249997), np.float64(1616.025286458333)), (np.float64(2637.8418281249997), np.float64(1505.447161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 71, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '94d3597016702ae666a33fdf8be75390', 'category': 'ListItem', 'element_id': 'ef249cddfcdde3624edf882df97c5840'}, page_content='2. Operator determines the best FOM Contour each type of terminal can use. Smaller or less capable terminals will use contours closer to the center of the beam.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9261245131492615, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(1654.9263281249998)), (np.float64(567.5468749999999), np.float64(1765.5044531249998)), (np.float64(2616.453125), np.float64(1765.5044531249998)), (np.float64(2616.453125), np.float64(1654.9263281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 71, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '94d3597016702ae666a33fdf8be75390', 'category': 'ListItem', 'element_id': '4cd41809f3c881b1f5c56cf69972105a'}, page_content='3. Operator groups terminals that have the same RF performance in the same category and assigns them the same RFTT.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9260720610618591, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(1804.4054947916663)), (np.float64(567.5468749999999), np.float64(1914.9836197916663)), (np.float64(2615.62744140625), np.float64(1914.9836197916663)), (np.float64(2615.62744140625), np.float64(1804.4054947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 71, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '94d3597016702ae666a33fdf8be75390', 'category': 'ListItem', 'element_id': 'eb1ea58ebaf9e8c4639d22e0ff89f265'}, page_content='4. Operator configures the FOM Threshold Value for every RFTT in every beam (channel for more granular control per iNet).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8487022519111633, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(1951.8033447265625)), (np.float64(567.54687