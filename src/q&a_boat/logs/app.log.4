90dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '607b3dd461525c948ae8f3b5c5f9adb6', 'category': 'Title', 'element_id': 'c248a4f2a91c18cce3d76d7694371ee6'}, page_content='3.1.2.1 Acquisition Bursts'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9331464767456055, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(499.1971614583332)), (np.float64(568.75), np.float64(609.7752864583335)), (np.float64(2503.365966796875), np.float64(609.7752864583335)), (np.float64(2503.365966796875), np.float64(499.1971614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 122, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c248a4f2a91c18cce3d76d7694371ee6', 'category': 'NarrativeText', 'element_id': 'd27f66695e215317e2a19983ce8c02ca'}, page_content='Velocity supports two types of satellite terminal acquisition: superburst acquisition and spread spectrum acquisition.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9482111930847168, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(655.9679947916666)), (np.float64(568.75), np.float64(952.4836197916668)), (np.float64(2630.987661458333), np.float64(952.4836197916668)), (np.float64(2630.987661458333), np.float64(655.9679947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 122, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c248a4f2a91c18cce3d76d7694371ee6', 'category': 'NarrativeText', 'element_id': 'd5d8ea076a0f35ea202e8c2b886ab16d'}, page_content='Superburst acquisition greatly improves the time and bandwidth required by satellite terminals to join the network. Spread spectrum acquisition supports high-speed AERO terminals with a new acquisition burst waveform that may be received at a much lower C/N than superburst, while being similarly tolerant to Doppler. These bursts are arranged with the following properties in mind:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.934000551700592, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(998.6763281249998)), (np.float64(673.2760416666666), np.float64(1171.2336197916668)), (np.float64(2477.8991197916666), np.float64(1171.2336197916668)), (np.float64(2477.8991197916666), np.float64(998.6763281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 122, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c248a4f2a91c18cce3d76d7694371ee6', 'category': 'ListItem', 'element_id': '898e4f27d69ab2dc1b3a6903d55349b4'}, page_content='• Bursts can be received at a very low C/N, accommodating rain fade — which is unknown at the time of logon — as well as conservative estimates of the initial transmitted power that may be used to avoid violating regulatory limits.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9483373761177063, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1217.4263281249998)), (np.float64(673.2760416666666), np.float64(1514.98388671875)), (np.float64(2625.2637031249997), np.float64(1514.98388671875)), (np.float64(2625.2637031249997), np.float64(1217.4263281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 122, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c248a4f2a91c18cce3d76d7694371ee6', 'category': 'ListItem', 'element_id': '4e5492138e2ee56c6c378ecd485c526b'}, page_content='• The performance of the acquisition bursts is primarily defined by the ability of the scheme to overcome uncertainties in terms of frequency, timing, and signal level that inevitably exist when the satellite terminal has been out of the network for any length of time. It is for these reasons that the acquisition slots have sufficiently large guard times to accommodate initial timing uncertainty.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8872693181037903, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1560.134661458333)), (np.float64(673.2760416666666), np.float64(1608.7336197916666)), (np.float64(2492.27294921875), np.float64(1608.7336197916666)), (np.float64(2492.27294921875), np.float64(1560.134661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 122, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c248a4f2a91c18cce3d76d7694371ee6', 'category': 'ListItem', 'element_id': 'f14227ab17384a95324bae4de20970cf'}, page_content='• The superburst receiver has a frequency tolerance of ±7.5% of the symbol rate.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9297701120376587, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1654.9263281249998)), (np.float64(673.2760416666666), np.float64(1765.5044531249998)), (np.float64(2552.329833984375), np.float64(1765.5044531249998)), (np.float64(2552.329833984375), np.float64(1654.9263281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 122, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c248a4f2a91c18cce3d76d7694371ee6', 'category': 'ListItem', 'element_id': 'a64301a773d894fdaefcc4d3165d717b'}, page_content='• The spread-spectrum acquisition burst receiver has a tolerance of ±3% of the chip rate.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9343234896659851, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1811.697161458333)), (np.float64(673.2760416666666), np.float64(1984.2544531249998)), (np.float64(2576.02197265625), np.float64(1984.2544531249998)), (np.float64(2576.02197265625), np.float64(1811.697161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 122, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c248a4f2a91c18cce3d76d7694371ee6', 'category': 'ListItem', 'element_id': '03eededacee9e8ffee0fff478a20471c'}, page_content='• A satellite terminal may need to perform frequency sweeping that involves transmission of a small number of additional acquisition bursts. Sweep parameters are configurable in the network management system (NMS).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9316945672035217, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(667.3211059570312), np.float64(2030.447161458333)), (np.float64(667.3211059570312), np.float64(2264.9836197916666)), (np.float64(2616.5501614583327), np.float64(2264.9836197916666)), (np.float64(2616.5501614583327), np.float64(2030.447161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 122, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c248a4f2a91c18cce3d76d7694371ee6', 'category': 'ListItem', 'element_id': 'f56f28a07a41957d33ed4d8e24e42dec'}, page_content='• More acquisition attempts may be required in the case of high-speed mobile satellite terminals due to the high Doppler shift. To increase the probability of successful attempts and provide additional robustness for the spread-spectrum acquisition, Doppler correction is employed as a means of reducing frequency uncertainty.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9322082996368408, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(737.07275390625), np.float64(2303.884661458333)), (np.float64(737.07275390625), np.float64(2538.4211197916666)), (np.float64(2626.940786458333), np.float64(2538.4211197916666)), (np.float64(2626.940786458333), np.float64(2303.884661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 122, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c248a4f2a91c18cce3d76d7694371ee6', 'category': 'NarrativeText', 'element_id': 'f5ed601f9d3d475a0c6c51906fa1d1c1'}, page_content="This correction can ultimately serve to allow lower symbol rates, in particular for the high-speed profile. An initial Doppler estimate is applied to both the carrier frequency and timing drift based on the downstream frequency component and the satellite terminal's position, heading and speed values."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9133061170578003, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(296.0110168457031), np.float64(2632.4374999999995)), (np.float64(296.0110168457031), np.float64(2719.9374999999995)), (np.float64(1288.6527099609375), np.float64(2719.9374999999995)), (np.float64(1288.6527099609375), np.float64(2632.4374999999995))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 122, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '607b3dd461525c948ae8f3b5c5f9adb6', 'category': 'Title', 'element_id': '23f6bed46427c0f8df87a95500c65743'}, page_content='3.2 DVB-S2 Overview'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9396944642066956, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2763.25