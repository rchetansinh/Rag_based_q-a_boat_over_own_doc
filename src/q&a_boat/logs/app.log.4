b69f3e70'}, page_content='7.8 Link Encryption Terminal Licensing'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8917670249938965, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(303.7558898925781), np.float64(397.541666666667)), (np.float64(303.7558898925781), np.float64(485.041666666667)), (np.float64(2029.6505126953125), np.float64(485.041666666667)), (np.float64(2029.6505126953125), np.float64(397.541666666667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 293, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '5242e6565b021d1b8e5852adb69f3e70', 'category': 'Title', 'element_id': '25678659d9bd56366f8490f61cc47eb4'}, page_content='7.8 Link Encryption Terminal Licensing'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9351612329483032, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(528.3638281249998)), (np.float64(568.75), np.float64(762.9002864583334)), (np.float64(2611.555369791666), np.float64(762.9002864583334)), (np.float64(2611.555369791666), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 293, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '25678659d9bd56366f8490f61cc47eb4', 'category': 'NarrativeText', 'element_id': '469cd65ba39ce830c430871220e0619e'}, page_content='Pulse enforces the use of Encryption Licensing on terminals deployed after the installation of Pulse Version 2.9.1.x. While terminals already operating in encrypted mode will remain in that mode after a Pulse upgrade to version 2.9.1.x, adding encryption to any terminal requires the network operator to first obtain and install a license file to Pulse.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9488152861595154, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.15234375), np.float64(809.0929947916666)), (np.float64(568.15234375), np.float64(1229.6759033203125)), (np.float64(2660.26513671875), np.float64(1229.6759033203125)), (np.float64(2660.26513671875), np.float64(809.0929947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 293, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '25678659d9bd56366f8490f61cc47eb4', 'category': 'NarrativeText', 'element_id': 'd536c4c6d3dc5a97a6fb07f86abb64cc'}, page_content='The Pulse NMS will only accept one license file. When licenses are added or subtracted, a new license file is issued by iDirect. This license file specifies the remote types that can operate in encrypted mode and the quantity of each remote type that can operate in encrypted mode. For each network, iDirect issues a license file based on the accumulated sales records of encryption licenses for each modem type. No license file will be issued if an operator does not purchase an encryption license. In addition, a license file may also be issued based on previously-established contractual terms between an operator and iDirect.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9506164789199829, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1275.759661458333)), (np.float64(568.75), np.float64(1820.1919531249998)), (np.float64(2640.904328125), np.float64(1820.1919531249998)), (np.float64(2640.904328125), np.float64(1275.759661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 293, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '25678659d9bd56366f8490f61cc47eb4', 'category': 'NarrativeText', 'element_id': '39a69a10d737ba1fdca1197bebe04938'}, page_content='The Network Operator is responsible for managing the export control compliance aspect of enabling encryption for any terminals. Pulse will allow an operator to add encryption to a terminal of a specific remote type as long as unused license is available for that type based on the installed license file. For example, if a license file is installed on the NMS that contains a license for (10) X7 remotes and (20) CX780 remotes, then any 10 (but no more than 10) X7s can be configured to operate in encrypted mode, and 20 (but no more than 20) CX780s can be configured to operate in encrypted mode. If encryption needs to be enabled for more terminals than are specified in the license, a new license with additional licenses must be obtained.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9230730533599854, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(782.3967895507812), np.float64(1903.938720703125)), (np.float64(782.3967895507812), np.float64(2204.665283203125)), (np.float64(2574.611328125), np.float64(2204.665283203125)), (np.float64(2574.611328125), np.float64(1903.938720703125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 293, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '25aa39eac452ae966aa14bead0b07258'}, page_content='NOTE: Existing Velocity networks with link encryption enabled on one or more terminals via Pulse configuration (not via EDK) can be upgraded to Pulse 2.9.1.x without network disruption. Terminals operating in encrypted mode before the upgrade will continue to operate in encrypted mode after the upgrade without first installing a license file to Pulse.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9040276408195496, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(837.1889038085938), np.float64(2376.213623046875)), (np.float64(837.1889038085938), np.float64(2680.755126953125)), (np.float64(2579.3991197916666), np.float64(2680.755126953125)), (np.float64(2579.3991197916666), np.float64(2376.213623046875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 293, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '1a8bc27f777c17bab295c43b208ace3b'}, page_content='NOTE: Existing Velocity networks should not have any terminals with pending EDKs before upgrade to Pulse 2.9.1.x. If there are any pending EDKs when the upgrade is performed, a warning will be shown, and the upgrade will continue. When the upgrade to Pulse 2.9.1.x is complete, any terminals with pending EDKs will be in the “Changes Pending” state.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.7957853674888611, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(838.496826171875), np.float64(2854.4054947916666)), (np.float64(838.496826171875), np.float64(3026.962786458333)), (np.float64(2584.0293281249997), np.float64(3026.962786458333)), (np.float64(2584.0293281249997), np.float64(2854.4054947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 293, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '9d38ef8c8b5c8879210a766ec73b26d5'}, page_content='NOTE: tion on any terminals not operating in encrypted mode before the Pulse 2.9.1.x upgrade. For more information on installing Link Encryption Licenses, see the Pulse 4.0 Network Management System User Guide.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4432196617126465, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3511.3271484375)), (np.float64(353.6458333333333), np.float64(3628.525286458333)), (np.float64(1940.1937255859375), np.float64(3628.525286458333)), (np.float64(1940.1937255859375), np.float64(3511.3271484375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 293, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'e83da3e42168594ca9ff4608cc87