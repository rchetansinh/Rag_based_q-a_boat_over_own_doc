le_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '8b20234516d04c2643bf1b0b5e474056'}, page_content='NOTE: Note that when this option is used, the best-effort round used to allocate bandwidth in excess of the CIR and up to the MIR will also be proportional to the current CIR.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9167430996894836, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1685.8429947916666)), (np.float64(568.75), np.float64(1749.025286458333)), (np.float64(2103.9647317335935), np.float64(1749.025286458333)), (np.float64(2103.9647317335935), np.float64(1685.8429947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 204, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '0ec60f4453153d4655fcb546326fab58'}, page_content='4.6.4.3 Allocation Fairness Relative to CIR and MIR'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9436953663825989, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1793.4679947916663)), (np.float64(568.75), np.float64(2151.962786458333)), (np.float64(2606.4147447916666), np.float64(2151.962786458333)), (np.float64(2606.4147447916666), np.float64(1793.4679947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 204, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '0ec60f4453153d4655fcb546326fab58', 'category': 'NarrativeText', 'element_id': '240f2705988c6267763f03fbd88bbc36'}, page_content='Allocation fairness relative to CIR and MIR allows CIR/MIR allocation to be proportional to the current CIR value in CIR round and current MIR in the MIR round during periods of contention. The system computes an internal cost parameter that is used by the demand allocation algorithm to implement the proportional allocation behavior. The GSP cost parameter is still available to the user. It may be used in both the inbound and outbound directions.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.856732189655304, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(825.4265747070312), np.float64(2933.3377864583335)), (np.float64(825.4265747070312), np.float64(2981.9367447916666)), (np.float64(2362.8416914199997), np.float64(2981.9367447916666)), (np.float64(2362.8416914199997), np.float64(2933.3377864583335))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 204, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '02d4ffe0fc0f8e2b63c65770645db4bc'}, page_content='Figure 4-24. Example of Allocation Fairness Relative to CIR and MIR'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9190623164176941, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(3067.6138281249996)), (np.float64(568.75), np.float64(3130.796119791666)), (np