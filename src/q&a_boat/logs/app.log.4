ar/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '8bc8970ee45a6aecdf08aaadb3425514'}, page_content='Figure 5-13. RF Gateway Switchover Across HEO Satellites'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9434255361557007, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.74951171875), np.float64(2074.197161458333)), (np.float64(566.74951171875), np.float64(2618.629453125)), (np.float64(2635.326203125), np.float64(2618.629453125)), (np.float64(2635.326203125), np.float64(2074.197161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 234, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'f784c1c064b060c169571d7ab40990c4'}, page_content='Velocity and Pulse enable an external management system or an operator to dynamically create a relationship between an Active RF Gateway and a Backup RF Gateway, which will become the Active RF Gateway\'s "Hot Standby". When a “Hot Standby” relationship is established, the Velocity PP configures the linecards in the “Hot Standby” RF Gateway to support the iNets in the Primary RF Gateway, and the linecards calibrate and begin processing received bursts. If the Primary RF Gateway is unable to provide service for any reason, including rain fade, an external management system or an operator can trigger an RF Gateway switchover to the “Hot Standby” RF Gateway, with minimal impact to traffic. This approach is based on the 1:1 RF Gateway Automatic Rain Diversity feature.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/ra