))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 96, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'e1439546addedf1efaa8f70e056d548f', 'category': 'NarrativeText', 'element_id': '480c4f041c97e4e0f3581046d1940a44'}, page_content='This improves the Velocity software for situations where multiple satellites are landing at the same teleport, or different teleports (RF Gateways) connected to a common CDC, and allows for the chassis (15152 or iHub) to be shared with multiple satellites, as well as consolidation of CDCs.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8586199283599854, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(845.140625), np.float64(1129.9263281249998)), (np.float64(845.140625), np.float64(1240.504453125)), (np.float64(2548.28076171875), np.float64(1240.504453125)), (np.float64(2548.28076171875), np.float64(1129.9263281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 96, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'b5e09223a34adda218faedba499c3c3e'}, page_content='NOTE: The number of terminals that can be supported by a CDC is limited by the SAS NMS implementation and the size of the PP cluster.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9373344779014587, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(