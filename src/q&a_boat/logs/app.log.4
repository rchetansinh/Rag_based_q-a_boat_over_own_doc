69089126587, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1910.34375), np.float64(251.28049479166657)), (np.float64(1910.34375), np.float64(299.87945312500017)), (np.float64(2626.705078125), np.float64(299.87945312500017)), (np.float64(2626.705078125), np.float64(251.28049479166657))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': 'bf71803cc4a6b9aaa4440e4809b3751e'}, page_content='4.5.5.1 Outbound (DVB-S2) QoS'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9175974726676941, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(400.7596614583332)), (np.float64(568.75), np.float64(449.35861979166685)), (np.float64(1469.9525244982813), np.float64(449.35861979166685)), (np.float64(1469.9525244982813), np.float64(400.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bf71803cc4a6b9aaa4440e4809b3751e', 'category': 'NarrativeText', 'element_id': '29cc7f1084ba499511069818bc0c7029'}, page_content='provider must define a nominal MODCOD.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9410623908042908, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(667.583740234375), np.float64(495.5513281249999)), (np.float64(667.583740234375), np.float64(856.3978881835938)), (np.float64(2656.493408203125), np.float64(856.3978881835938)), (np.float64(2656.493408203125), np.float64(495.5513281249999))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bf71803cc4a6b9aaa4440e4809b3751e', 'category': 'ListItem', 'element_id': '30c2eda21693e727b7ea96232682d413'}, page_content='• Nominal MODCOD (for GSPs) — Nominal MODCOD is the estimated average operating MODCOD for all satellite terminals in a group. It is used by a service provider to estimate the capacity required by a group of satellite terminals in the equivalent of satellite bandwidth rather than information rate. The nominal MODCOD is a GSP parameter that enables the primary service provider to sell capacity based on a contractual MODCOD, and is only applicable when operating in Symbol-based mode.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9267926216125488, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(740.8401489257812), np.float64(892.9471614583332)), (np.float64(740.8401489257812), np.float64(1375.400286458333)), (np.float64(2622.237661458333), np.float64(1375.400286458333)), (np.float64(2622.237661458333), np.float64(892.9471614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bf71803cc4a6b9aaa4440e4809b3751e', 'category': 'NarrativeText', 'element_id': '6adb9e96cd09b8916cf6a028bfdf076e'}, page_content='For example, if a service provider purchases 10 Mbps based on a nominal MODCOD of QPSK 7/8 and most satellite terminals are in a hurricane area operating between QPSK 1/2 and QPSK 1/4, a significant amount of additional satellite bandwidth would be required to achieve the 10 Mbps information rate. In a situation like this, the service plan does not obligate the primary service provider to meet the 10 Mbps because the nominal MODCOD specified in the GSP plan is QPSK 7/8. Note that when the average operating MODCOD for the group is above the nominal MODCOD, the group will get a higher CIR/MIR while the consumed bandwidth remains the same.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.7172356247901917, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(837.5750122070312), np.float64(1461.697161458333)), (np.float64(837.5750122070312), np.float64(1572.275286458333)), (np.float64(2442.409423828125), np.float64(1572.275286458333)), (np.float64(2442.409423828125), np.float64(1461.697161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '41d1dff343edfce272d82bd973a835b2'}, page_content='NOTE: Nominal MODCOD is only available in the downstream direction, and when the QoS Service Mode options is set for Symbol-based.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8533834218978882, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(831.2357177734375), np.float64(1611.1763281249998)), (np.float64(831.2357177734375), np.float64(1721.7544531249998)), (np.float64(2509.569580078125), np.float64(1721.7544531249998)), (np.float64(2509.569580078125), np.float64(1611.1763281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '5ad77024d9f7222770972c9da4008834'}, page_content='For additional details on how to determine the nominal MODCOD for a GSP, see Calculation of the Nominal MODCOD for an Outbound GSP on page 154.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9015364646911621, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1851.417421875)), (np.float64(568.75), np.float64(1904.901796875)), (np.float64(1929.221435546875), np.float64(1904.901796875)), (np.float64(1929.221435546875), np.float64(1851.417421875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '8970b198eb22692f4d7e0616493583a0'}, page_content='Base MODCOD and Operating MODCOD (for SSPCs only)'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9489172697067261, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(562.597900390625), np.float64(1950.2388281249998)), (np.float64(562.597900390625), np.float64(2370.712786458333)), (np.float64(2590.847036458333), np.float64(2370.712786458333)), (np.float64(2590.847036458333), np.float64(1950.2388281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '8970b198eb22692f4d7e0616493583a0', 'category': 'NarrativeText', 'element_id': '38c9c856afd5353a9718230c9eb70d1f'}, page_content='An SSPC exists on a specific satellite terminal that will experience changing RF signal conditions over time. Adaptive coding and modulation (ACM) allows satellite terminals to operate at their optimal MODCOD, based on their real-time signal-to-noise ratio (SNR). The SNR is dependent on the satellite terminal antenna size, the carrier downlink EIRP, geographic location within the beam coverage, and rain fade conditions. Those real-time RF conditions will determine the operating MODCOD for traffic received by that satellite terminal. Operating MODCOD is not a configured parameter.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9299850463867188, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(2416.9054947916666)), (np.float64(673.2760416666666), np.float64(2589.4627864583335)), (np.float64(2589.628810484114), np.float64(2589.4627864583335)), (np.float64(2589.628810484114), np.float64(2416.9054947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '8970b198eb22692f4d7e0616493583a0', 'category': 'ListItem', 'element_id': '4a9a5f9f0c83165b0b670c91dcb6a8ea'}, page_content="• Operating MODCOD — The operating MODCOD refers to the satellite terminal's real- time operating point. Under normal operation, a satellite terminal's operating MODCOD is expected to be above the base MODCOD."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9471735954284668, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.0341186523438), np.float64(2635.6554947916666)), (np.float64(568.0341186523438), np.float64(2994.150286458333)), (np.float64(2645.743896484375), np.float64(2994.150286458333)), (np.float64(2645.743896484375), np.float64(2635.6554947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '8970b198eb22692f4d7e0616493583a0', 'category': 'NarrativeText', 'element_id': 'f360a7358009656a43b01f1fe596bd97'}, page_content='The amount of bandwidth (in MHz or Msps) required to deliver the CIR configured for the SSPC will vary depending upon the signal conditions at the satellite terminal. Satellite terminals operating in clear-sky conditions will require fewer MHz to deliver the CIR in the service plan. However, if that satellite terminal experiences fade, ACM will use more robust and less efficient MODCODs to transmit data to the satellite terminal, requiring more MHz or Msps to deliver the same CIR Mbps required by the service plan.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9193926453590393, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.6155395507812), np.float64(3040.342994791666)), (np.float64(565.6155395507812), np.float64(3150.9211197916666)), (np.float64(2597.781982421875), np.float64(3150.9211197916666)), (np.float64(2597.781982421875), np.float64(3040.342994791666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '8970b198eb22692f4d7e0616493583a0', 'category': 'NarrativeText', 'element_id': 'a3b8f3ca597553fd83ea076ea4439490'}, page_content='The diagram illustrates that the bandwidth needed to deliver a fixed information rate increases significantly when terminals operate at lower SNR, and therefore, lower MODCODs.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4843061864376068, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3512.494873046875)), (np.float64(353.6458333333333), np.float64(3628.525286458333)), (np.float64(1940.84228515625), np.float64(3628.525286458333)), (np.float64(1940.84228515625), np.float64(3512.494873046875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '8970b198eb22692f4d7e0616493583a0', 'category': 'NarrativeText', 'element_id': 'c44cdaa58d44adb4d2bdb6428628a00f'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5581090450286865, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(2544.864583333333), np.float64(3514.3013281249996)), (np.float64(2544.864583333333), np.float64(3562.900286458333)), (np.float64(2624.03369140625), np.float64(3562.900286458333)), (np.float64(2624.03369140625), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 185, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '8970b198eb22692f4d7e0616493583a0', 'category': 'NarrativeText', 'element_id': '43c58cbac27ac4fc97b2b69d57aba4fb'}, page_content='151'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9160056710243225, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(350.0), np.float64(251.28049479166657)), (np.float64(350.0), np.float64(299.87945312500017)), (np.float64(1067.1817626953125), np.float64(299.87945312500017)), (np.float64(1067.1817626953125), np.float64(251.28049479166657))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 186, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': '0211332080bd5a9943fb7e7de5c66245'}, page_content='4.5.5.1 Outbound (DVB-S2) QoS'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5326298475265503, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(790.6043701171875), np.float64(1774.1400146484375)), (np.float64(790.6043701171875), np.float64(1826.2075781249996)), (np.float64(2392.7060546875), np.float64(1826.2075781249996)), (np.float64(2392.7060546875), np.float64(1774.1400146484375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 186, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': 'a092bbe29292e0e30e5bf338e4581ba5'}, page_content='Figure 4-11. Bandwidth (in symbols, normalized) vs. Information Rate'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9338216781616211, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(559.6424560546875), np.float64(1880.9679947916663)), (np.float64(559.6424560546875), np.float64(2053.525286458333)), (np.float64(2571.742869791666), np.float64(2053.525286458333)), (np.float64(2571.742869791666), np.float64(1880.9679947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 186, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'd10dbd6ab2570fa9910f92a3e4162aba'}, page_content="To prevent the situation where a satellite terminal goes into deep fade, where the system would consume a large number of Msps in attempting to satisfy this satellite terminal's CIR, the concept of a base MODCOD is introduced."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9447895884513855, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(665.994384765625), np.float64(2098.23583984375)), (np.float64(665.994384765625), np.float64(2644.1502864583335)), (np.float64(2635.289744791666), np.float64(2644.1502864583335)), (np.float64(2635.289744791666), np.float64(2098.23583984375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 186, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'ListItem', 'element_id': '27ab7630b5183f8dfbb7ed2c53775c1a'}, page_content="• Base MODCOD — The base MODCOD is the lowest MODCOD at which an application's (SSPC) CIR/MIR is honored in DVB-S2/ACM. The satellite terminal can still operate in rain fade all the way down to the beam's minimum MODCOD. In a mobile environment, the base MODCOD is typically selected based on the expected operating point at the beam edge with reasonable rain fade. It allows service providers to specify a base MODCOD in the service plan and offer lower pricing, if desired, for customers using larger antennas or customers with no requirements for maintaining CIR/MIR in deep rain fade. When a satellite terminal is in deep rain fade operating below its base MODCOD, its CIR/MIR is scaled down."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9443982839584351, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2689.651611328125)), (np.float64(568.75), np.float64(3420.712786458333)), (np.float64(2627.7428697916666), np.float64(3420.712786458333)), (np.float64(2627.7428697916666), np.float64(2689.651611328125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 186, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'c2eaa616020135d5e05863c58cbfc1f7'}, page_content="On the ACM outbound, the system allows the user to configure a base MODCOD for each satellite terminal SSPC. The CIR/MIR configured for the SSPC is honored as long as the satellite terminal is operating above or at the base MODCOD. When the satellite terminal operates above its base MODCOD, the SSPC's CIR/MIR is not increased to a higher value. However, if the satellite terminal operates below the base MODCOD, the CIR/MIR is scaled down based on the bandwidth efficiency of the operating MODCOD. The allocated bandwidth remains fixed at the base MODCOD bandwidth, but the CIR/MIR is gradually degraded because the SSPC continues to use the same amount of satellite bandwidth that was allocated at the base MODCOD. The comparable concept on the inbound is that of inbound fairness, which limits CIR commitments to an SSPC if its satellite terminal is operating below a defined operating point. For information on inbound fairness, see Inbound Fairness Base Bitrate (for SSPCs only) on page 159."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.3274388909339905, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(430.41668701171875), np.float64(3562.900286458333)), (np.float64(430.41668701171875), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 186, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'bcaf056995413ec10b755b44e53cdeef'}, page_content='152'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4548123776912689, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1063.5225830078125), np.float64(3508.979736328125)), (np.float64(1063.5225830078125), np.float64(3628.525286458333)), (np.float64(2626.447265625), np.float64(3628.525286458333)), (np.float64(2626.447265625), np.float64(3508.979736328125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 186, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '0389311b1f6b7d0213353a939ad98944'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9203256964683533, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1319.4635416666665), np.float64(251.28049479166657)), (np.float64(1319.4635416666665), np.float64(299.87945312500017)), (np.float64(2624.90827851), np.float64(299.87945312500017)), (np.float64(2624.90827851), np.float64(251.28049479166657))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 187, '