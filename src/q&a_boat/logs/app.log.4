175.234375), np.float64(1899.1242447916661)), (np.float64(2021.3856201171875), np.float64(1899.1242447916661)), (np.float64(2021.3856201171875), np.float64(1850.5252864583329))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 59, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '3d5b815a04c0c354912a2043f6226ea3'}, page_content='Figure 1-9. Velocity Routing Domains'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9391084313392639, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1953.884661458333)), (np.float64(568.75), np.float64(2250.400286458333)), (np.float64(2639.774119791666), np.float64(2250.400286458333)), (np.float64(2639.774119791666), np.float64(1953.884661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 59, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '8a2900d466c10ef532b24e4f3c272458'}, page_content='The SAS or CDC routing domain of an SVN includes the IP interfaces of all PP servers and the IP interface of SAS access routers in the SAS network segment. The routing protocols available in this domain are iBGP (internal Border Gateway Protocol) and eBGP (external Border Gateway Protocol). Static IP routes may also be configured. Administrative distances are used in route selection decisions, and may be configured for iBGP, eBGP, static and connected routes.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9393472671508789, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2296.5929947916666)), (np.float64(568.75), np.float64(2593.1086197916666)), (np.float64(2643.92431640625), np.float64(2593.1086197916666)), (np.float64(2643.92431640625), np.float64(2296.5929947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 59, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'a4795527a815b0349dcd559d5802c9fa'}, page_content='The OTA routing domain of an SVN includes all of the virtual IP interfaces automatically created by the PP to represent the terminals it is currently serving and that are configured to support that SVN. This domain also includes the satellite interfaces (sat0) configured on the satellite terminals. In this routing domain, either eBGP or iBGP may be selected, or no routing protocol if all routes to equipment in the terminal routing domain are statically configured.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9380171895027161, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(561.1124877929688), np.float64(2639.3013281249996)), (np.float64(561.1124877929688), np.float64(2873.837786458333)), (np.float64(2634.669953125), np.float64(2873.837786458333)), (np.float64(2634.669953125), np.float64(2639.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 59, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'baa14292769f1d326490e45e063ea02e'}, page_content='The terminal routing domain of an SVN is the satellite terminal LAN, and includes the IP interface (eth0) configured on the terminal, as well as the IP interfaces of all the devices (i.e., hosts and routers) in the terminal LAN. Static routes may be used in this domain, as well as iBGP or eBGP. Administrative distances are used for route selection decisions.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9356064200401306, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2920.030494791666)), (np.float64(568.75), np.float64(3154.566953125)), (np.float64(2590.1907864583336), np.float64(3154.566953125)), (np.float64(2590.1907864583336), np.float64(2920.030494791666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 59, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '7f6c69eb688e08d1c809e7839d16d11c'}, page_content="DHCP (Dynamic Host Configuration Protocol) may be used to dynamically assign IP addresses to the equipment on the terminal LAN, and RADIUS (remote authentication dial-in user service) may be used to assign the IP address of the terminal's interface to the LAN (i.e., eth0). If RADIUS is used, DHCP server must also be enabled."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8868529200553894, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.flo