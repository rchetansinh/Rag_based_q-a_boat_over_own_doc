ff83f'}, page_content='Figure 4-13. Example Procedure for Calculating Nominal MODCOD for each Beam'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9359975457191467, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(559.5514526367188), np.float64(2118.603411458333)), (np.float64(559.5514526367188), np.float64(2356.1294531249996)), (np.float64(2628.873078124999), np.float64(2356.1294531249996)), (np.float64(2628.873078124999), np.float64(2118.603411458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 190, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '13033037aa6f19657bb4ac553d78eb10'}, page_content='The initial estimate of the CIR in each beam is αiX. αi is a decimal factor representing the percentage of the CIR that will be allocated to Beam i. These estimates can be changed as needed if the traffic density is known. A survey may be used to solicit information from which to create the initial estimates.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9331130385398865, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.337646484375), np.float64(2402.322161458333)), (np.float64(565.337646484375), np.float64(2636.8586197916666)), (np.float64(2592.1230781249997), np.float64(2636.8586197916666)), (np.float64(2592.1230781249997), np.float64(2402.322161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 190, 'file_directory': '/var/f