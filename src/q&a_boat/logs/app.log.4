dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.906755805015564, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(2066.52099609375)), (np.float64(567.5468749999999), np.float64(2177.4836197916666)), (np.float64(2606.11572265625), np.float64(2177.4836197916666)), (np.float64(2606.11572265625), np.float64(2066.52099609375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 127, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd2df6adec3e7506677f8dc60134c59ea', 'category': 'ListItem', 'element_id': '288a2d954eed719845e654bb2e4d65bd'}, page_content='• With strong, narrow-band adjacent carriers that occupy 5% to 10% of symbol rate of the wanted carrier on either side'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9459716081619263, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.25537109375), np.float64(2223.466064453125)), (np.float64(567.25537109375), np.float64(2520.191953125)), (np.float64(2636.3834947916666), np.float64(2520.191953125)), (np.float64(2636.3834947916666), np.float64(2223.466064453125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 127, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd2df6adec3e7506677f8dc60134c59ea', 'category': 'NarrativeText', 'element_id': 'dfc277be32ec7c685a80d0c7f6de044d'}, page_content='In most cases, the DVB-S2 downstream carrier operates at the highest power spectral density in the transponder, maximizing the contracted equal power equal bandwidth (EPEBW) limit. This makes ACI levels exceeding +4 dBc unlikely. In addition, adjacent carriers shaped at 5% (bullet 1) or narrow-band carriers stronger than the DVB-S2 downstream carrier (bullet 2) that are likely to violate the EPEBW mask are unusual.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8791208267211914, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2566.384661458333)), (np.float64(568.75), np.float64(2614.9836197916666)), (np.float64(2619.034912109375), np.float64(2614.9836197916666)), (np.float64(2619.034912109375), np.float64(2566.384661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 127, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd2df6adec3e7506677f8dc60134c59ea', 'category': 'NarrativeText', 'element_id': 'dd34733fea79ec450346daf77c358d27'}, page_content='Network designers can realize benefit of 5% roll-off by planning around identified constraints.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.864319920539856, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2664.438255208333)), (np.float64(568.75), np.float64(2717.9226302083334)), (np.float64(1957.24169921875), np.float64(2717.9226302083334)), (np.float64(1957.24169921875), np.float64(2664.438255208333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 127, 'file_directory': '/var/fo