700561523438), np.float64(2957.691953125)), (np.float64(2601.018911458333), np.float64(2957.691953125)), (np.float64(2601.018911458333), np.float64(2658.137451171875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 283, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '5a40c1f3e06dbc155331f86c3b61f037', 'category': 'NarrativeText', 'element_id': 'd82756c1b259caeb4ebedc6daba28afc'}, page_content='For resiliency, terminals have two software partitions. New software packages are downloaded, verified, and put into the partition that is not currently active. It is then installed, becomes active, and the remote restarts. If there is a problem with the new software package and the terminal is unable to come into the network, the terminal will fall back to the previous version located in the other partition.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8719018697738647, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(845.2135416666666), np.float64(3043.97705078125)), (np.float64(845.2135416666666), np.float64(3216.5461197916666)), (np.float64(2547.169953125), np.float64(3216.5461197916666)), (np.float64(2547.169953125), np.float64(3043.97705078125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 283, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'df3b93ec8bde98a2d4c1967aeb4ce27e'}, page_content='NOTE: The fact that there are two partitions is not visible to the operator or the NMS (i.e., the operator is not able to choose which partition the software is loaded into.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4675011932849884, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3511.18798828125)), (np.float64(353.6458333333333), np.float64(3628.525286458333)), (np.float64(1938.6317138671875), np.float64(3628.525286458333)), (np.float64(1938.6317138671875), np.float64(3511.18798828125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 283, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'b16963ba808c344938fbca7fd31f5bff'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(2544.864583333333), np.float64(3514.3013281249996)), (np.float64(2544.864583333333), np.float64(3562.900286458333)), (np.float64(2621.302391602708), np.float64(3562.900286458333)), (np.float64(2621.302391602708), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 283, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'UncategorizedText', 'element_id': '922038586013b0da49396113d62a54e8'}, page_content='249'), Document