90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd95cea6c69675503e705674d6f826669', 'category': 'Title', 'element_id': 'dc29fa7f7f45035b07ea3f2f368d9b03'}, page_content='5.4.2.1 NOC Switchover — Service Implications and Timing'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9415287971496582, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(499.1971614583332)), (np.float64(568.75), np.float64(733.7336197916668)), (np.float64(2638.14013671875), np.float64(733.7336197916668)), (np.float64(2638.14013671875), np.float64(499.1971614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 238, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'dc29fa7f7f45035b07ea3f2f368d9b03', 'category': 'NarrativeText', 'element_id': '9d5307c5ac71cd60985a246365362199'}, page_content='A NOC NMS switchover has no impact on customer traffic over the satellite because customer data and control protocols do not flow through the Pulse NMS. Configuration activities must cease during a switchover, however, and the flow of events and statistics from the SAS to the NOC are delayed. The SAS components will buffer events and statistics during the switchover.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.952484667301178, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.8590698242188), np.float64(779.9263281249998)), (np.float64(566.8590698242188), np.float64(1200.4002864583335)), (np.float64(2631.461619791666), np.float64(1200.4002864583335)), (np.float64(2631.461619791666), np.float64(779.9263281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 238, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'dc29fa7f7f45035b07ea3f2f368d9b03', 'category': 'NarrativeText', 'element_id': '0f1abb6ac73b0938947d2b161bb3271b'}, page_content='The GBWM cluster is responsible for GBWM enforcement across SASs, and for Fair Access Policy (FAP). FAP will not be available for the duration of the NOC switchover procedure because it requires access to real-time statistics and events provided by the NMS. However, satellite network-wide GBWM enforcement will not be affected by a NOC switchover, because it does not require data from the NOC NMS. The GBWM enforcement feature functions in active-active mode and the PPs automatically send their requests to the standby (redundant) GBWM if the primary GBWM does not respond.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8710649609565735, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1288.4471614583333)), (np.float64(568.75), np.float64(1351.6294531249996)), (np.float64(2611.07666015625), np.float64(1351.6294531249996)), (np.float64(2611.07666015625), np.float64(1288.4471614583333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 238, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd95cea6c69675503e705674d6f826669', 'category': 'Title', 'element_id': 'f593e275cef5487acac3d5413590d0e1'}, page_content='5.4.2.2 NOC Switchover — Backbone Network Traffic Requirements'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9464667439460754, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1396.072161458333)), (np.float64(568.75), np.float64(1692.587786458333)), (np.float64(2623.36279296875), np.float64(1692.587786458333)), (np.float64(2623.36279296875), np.float64(1396.072161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 238, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f593e275cef5487acac3d5413590d0e1', 'category': 'NarrativeText', 'element_id': 'bf6942978fb4c96111c55fc1cc154f55'}, page_content='During a NOC switchover operation, there is no spike in traffic on the backbone network. All active NOC NMS processes perform continuous regular block-level replication of stats and events data to the standby (redundant) NOC NMS. After the NOC switchover operation, the newly active NOC will receive an increase in traffic, as the SAS NMSs direct statistics, events, and GBWM queries to it.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(430.0836416027083), np.float64(3562.900286458333)), (np.float64(430.0836416027083), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 23