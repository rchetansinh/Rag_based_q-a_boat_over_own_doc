/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.935431957244873, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(400.7596614583332)), (np.float64(568.75), np.float64(573.3169531250002)), (np.float64(2636.86572265625), np.float64(573.3169531250002)), (np.float64(2636.86572265625), np.float64(400.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 276, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '02a6a0e0c5521eaa66a14f74301d1369', 'category': 'NarrativeText', 'element_id': '634167c97e23b4ebecfea76c72c15ad6'}, page_content='amount of alignment in order to keep the interference within regulatory limits. For additional details on terminal operation with this type of antenna, see Mitigating Skew Impairment in Mobile Terminals on page 312.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.918739378452301, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(664.6257552083332)), (np.float64(568.75), np.float64(732.6934635416668)), (np.float64(1512.3953857421875), np.float64(732.6934635416668)), (np.float64(1512.3953857421875), np.float64(664.6257552083332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 276, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '02a6a0e0c5521eaa66a14f74301d1369', 'category': 'Title', 'element_id': '0682db4f7e80b4e0446b8bc761b34473'}, page_content='7.2.4 Antenna Control Unit'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9449608325958252, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.5938110351562), np.float64(775.6785278320312)), (np.float64(565.5938110351562), np.float64(1072.7961197916668)), (np.float64(2618.96630859375), np.float64(1072.7961197916668)), (np.float64(2618.96630859375), np.float64(775.6785278320312))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 276, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '0682db4f7e80b4e0446b8bc761b34473', 'category': 'NarrativeText', 'element_id': 'bf7d580d88af53e2c625950ebc611968'}, page_content='The antenna control unit communicates with the satellite router using the OpenAMIP protocol. The ACU provides geo-location information to the satellite router, points the antenna at the satellite, and performs related functions such as providing antenna status and (in some terminals) muting the transmitter when off-pointed or blocked. For additional details on this protocol, see OpenAMIP on page 252.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8411288857460022, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.8851928710938), np.float64(1162.386474609375)), (np.float64(567.8851928710938), np.float64(1232.1726302083334)), (np.float64(959.4081420898438), np.float64(1232.1726302083334)), (np.float64(959.4081420898438), np.float64(1162.386474609375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 276, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '02a6a0e0c5521eaa66a14f74301d1369', 'category': 'Title', 'element_id': '70807b94a75acb2773a6d3af810d858e'}, page_content='7.2.5 LNB'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9448910355567932, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1270.787109375)), (np.float64(568.75), np.float64(1573.5098876953125)), (np.float64(2535.1387031249997), np.float64(1573.5098876953125)), (np.float64(2535.1387031249997), np.float64(1270.787109375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 276, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '70807b94a75acb2773a6d3af810d858e', 'category': 'NarrativeText', 'element_id': '977025ea3fc9812a12d6bf1aafc2feca'}, page_content='Single and multiple band LNBs are supported by the satellite router. Control over band selection is provided by setting the DC voltage to either 13V or 18V and by enabling or disabling a 22 KHz control tone on the receive inter-facility link (IFL). The combination of these parameters provide support of LNBs with up to four receive frequency bands. LO frequencies of multiple LNBs can be configured based on downlink frequencies.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8409464359283447, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.6882934570312), np.float64(1663.5840885416667)), (np.float64(567.6882934570312), np.float64(1731.651796875)), (np.float64(963.2438354492188), np.float64(1731.651796875)), (np.float64(963.2438354492188), np.float64(1663.5840885416667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 276, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '02a6a0e0c5521eaa66a14f74301d1369', 'category': 'Title', 'element_id': '0503fb58963e962a6c46518bec53e895'}, page_content='7.2.6 BUC'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.932483434677124, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.9974975585938), np.float64(1775.2388281249998)), (np.float64(567.9974975585938), np.float64(2009.775286458333)), (np.float64(2556.9780447596872), np.float64(2009.775286458333)), (np.float64(2556.9780447596872), np.float64(1775.2388281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 276, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '0503fb58963e962a6c46518bec53e895', 'category': 'NarrativeText', 'element_id': '71a6f8ff79d8d07c3abaacbde66ffea1'}, page_content='Velocity systems now support multi-band BUC along with multi-band LNB devices, on the 7- Series and CX780 Remotes. LO frequencies of multiple BUCs and/or multiple LNBs can be configured based on uplink and downlink frequencies respectively. Using Pulse NMS, BUC multi-band devices can be configured with up to eight frequency bands.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.939379096031189, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.0139770507812), np.float64(2055.9679947916666)), (np.float64(566.0139770507812), np.float64(2290.5044531249996)), (np.float64(2614.89208984375), np.float64(2290.5044531249996)), (np.float64(2614.89208984375), np.float64(2055.9679947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 276, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '0503fb58963e962a6c46518bec53e895', 'category': 'NarrativeText', 'element_id': '652b08232245c7fa87c67e2ed0a68670'}, page_content='At acquisition, the LNB band is selected based on the associated frequency of the selected signaling carrier in the constellation file or the selected service carrier in the OTA beam map file. Subsequently, when locked to the downstream, the BUC band is selected based on the uplink frequency communicated over-the-air to the terminal.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9413256645202637, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(562.9514770507812), np.float64(2336.413818359375)), (np.float64(562.9514770507812), np.float64(2695.191953125)), (np.float64(2633.5397447916666), np.float64(2695.191953125)), (np.float64(2633.5397447916666), np.float64(2336.413818359375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 276, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '0503fb58963e962a6c46518bec53e895', 'category': 'NarrativeText', 'element_id': '2bc219a410ff80e159b70d8e11864a39'}, page_content='During acquisition or beam switching on the same satellite or between satellites, the terminal selects the appropriate band, including the associated LO and filter. When the uplink/downlink frequency is known during beam or satellite switch, the BUC/LNB band options are searched to find the first available band that can accommodate the uplink/downlink frequency. Once the appropriate band is determined, the antenna control unit is instructed to set the BUC or LNB local oscillator to the LO frequency of the band.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9157671928405762, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(827.1747436523438), np.float64(2781.4888281249996)), (np.float64(827.1747436523438), np.float64(3079.437744140625)), (np.float64(2564.4147447916666), np.float64(3079.437744140625)), (np.float64(2564.4147447916666), np.float64(2781.4888281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 276, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '69c81227ac3d84941fb2d2528f5cbe56'}, page_content='NOTE: Supporting multiple bands requires an ACU supporting multi-band LNBs and/or multi-band BUCs, and the ability to reconfigure LNB and BUC LO frequency based on downstream and upstream frequencies respectively. A multi-band capable ACU uses OpenAMIP messages from the satellite router to configure the LNB and BUC bands.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class