p.float64(3562.900286458333)), (np.float64(2624.971923828125), np.float64(3562.900286458333)), (np.float64(2624.971923828125), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 295, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'cba5349191c085bdbcdd8bd63c245c98', 'category': 'NarrativeText', 'element_id': 'df2a8b56b66da0b4126033263f8a92c4'}, page_content='261'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.7576284408569336, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(347.8529968261719), np.float64(251.28049479166657)), (np.float64(347.8529968261719), np.float64(299.87945312500017)), (np.float64(1570.6334228515625), np.float64(299.87945312500017)), (np.float64(1570.6334228515625), np.float64(251.28049479166657))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 296, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': '4dcd95672ab1089d144d618dd9079f15'}, page_content='7.9.2 Authentication and Admission Control Sequence'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8738663792610168, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(394.8340885416665)), (np.float64(568.75), np.float64(463.4088439941406)), (np.float64(2372.08642578125), np.float64(463.4088439941406)), (np.float64(2372.08642578125), np.float64(394.8340885416665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 296, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '4dcd95672ab1089d144d618dd9079f15', 'category': 'Title', 'element_id': '31d7b4fc9dc6d5ac1e6ae2384edb9bbf'}, page_content='7.9.2 Authentication and Admission Control Sequence'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9531735777854919, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(506.4888281249999)), (np.float64(568.75), np.float64(988.9419531250002)), (np.float64(2635.3991197916666), np.float64(988.9419531250002)), (np.float64(2635.3991197916666), np.float64(506.4888281249999))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 296, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '31d7b4fc9dc6d5ac1e6ae2384edb9bbf', 'category': 'NarrativeText', 'element_id': 'cba90f3357a0a01a3b14d43f8c0e286c'}, page_content="Once bi-directional communications have been established, authentication can be performed. Authentication, if enabled, is performed at both ends of the connection-not only does the SAS authenticate the terminal, but the terminal authenticates the SAS. Authentication of the SAS is performed by using the PKI (Public Key Infrastructure) data that has been loaded onto the terminal to validate the signature on an X.509 certificate sent from the SAS to the terminal. However, since the terminal's X.509 certificate is only self-signed and hasn't been signed by an authority by the time the terminal initially enters the network, it can't be used for authenticating the terminal."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9496932625770569, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1035.134661458333)), (np.float64(568.75), np.float64(1703.525286458333)), (np.float64(2634.312255859375), np.float64(1703.525286458333)), (np.float64(2634.312255859375), np.float64(1035.134661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 296, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '31d7b4fc9dc6d5ac1e6ae2384edb9bbf', 'category': 'NarrativeText', 'element_id': '245675b860bb66caf0b3cc784eea2bdc'}, page_content="Instead of using the terminal's certificate, the terminal is loaded with a secret that is shared with the SAS, so both the terminal and the SAS know that secret. The terminal uses cryptographic hardware to secure the secret, and this hardware supports a challenge- response approach to testing the secret without exposing it. The SAS sends a challenge, in the form of a large random number, to the terminal, and the terminal feeds that challenge into the cryptographic hardware. This hardware performs a cryptographic operation using that challenge, the shared secret, and a hardware serial number as inputs, and returns a response that is then sent back to the SAS. The same operation is performed at the SAS using the same inputs. If the response from the terminal matches that generated at the SAS, then the secret at the terminal must match the secret the SAS has on record for that terminal, and the terminal can be considered authenticated."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9463782906532288, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.1624145507812), np.float64(1749.7179947916663)), (np.float64(567.1624145507812), np.float64(2356.1294531249996)), (np.float64(2637.9876614583327), np.float64(2356.1294531249996)), (np.float64(2637.9876614583327), np.float64(1749.7179947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 296, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '31d7b4fc9dc6d5ac1e6ae2384edb9bbf', 'category': 'NarrativeText', 'element_id': '26374f356048c7a5b80afe2ef1ad220e'}, page_content='The shared secret must be loaded onto the terminal without exposing the secret. This is accomplished by first installing a single-use token onto the terminal, then using this token as a temporary shared secret to perform a single, first-time authentication of the terminal. Although this token is exposed to whoever installs it (usually, this is the terminal installer), its use is limited to a single authentication of a single terminal, preventing it from being used to authenticate an unauthorized terminal. Authentication using this token provides a sufficient level of trust in the terminal to then send the terminal its shared secret, over the air and encrypted. This shared secret is loaded into the cryptographic hardware on the terminal without exposing it, and it remains stored in that hardware where it can never be exposed. Subsequent authentications of the terminal are performed using this secured shared secret.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9485958814620972, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2402.322161458333)), (np.float64(568.75), np.float64(2698.8377864583335)), (np.float64(2611.2272447916666), np.float64(2698.8377864583335)), (np.float64(2611.2272447916666), np.float64(2402.322161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 296, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '31d7b4fc9dc6d5ac1e6ae2384edb9bbf', 'category': 'NarrativeText', 'element_id': 'a869d1c29cdfbb916a42eecef22d8e59'}, page_content="After the satellite terminal's identity is authenticated, the Velocity network is able to allow or deny a satellite terminal into the network based on configuration, network, and satellite terminal conditions. The SAS can also move the satellite terminal to a different iNet for load balancing. The following diagram illustrates the network authorization and admission control sequence that is described below."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(430.0836416027083), np.float64(3562.900286458333)), (np.float64(430.0836416027083), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 296, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '31d7b4fc9dc6d5a