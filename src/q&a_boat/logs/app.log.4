oat64(568.75), np.float64(1904.0461197916663)), (np.float64(2633.977244791667), np.float64(1904.0461197916663)), (np.float64(2633.977244791667), np.float64(1731.4888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 403, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '78ea78ebcfce30365239e612599d4ad1', 'category': 'NarrativeText', 'element_id': 'a676b782d34daa73323798687fd77420'}, page_content='The remote modem and satellite hub are responsible for mapping user Ethernet frames to the appropriate VPWS connection, and for forwarding the frames to the correct destinations. (See Forwarding Rules on page 374.) A VPWS can contain a single VLAN or multiple VLANs.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9297274947166443, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.08935546875), np.float64(1950.2388281249998)), (np.float64(563.08935546875), np.float64(2122.7961197916666)), (np.float64(2585.3918415948433), np.float64(2122.7961197916666)), (np.float64(2585.3918415948433), np.float64(1950.2388281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 403, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '78ea78ebcfce30365239e612599d4ad1', 'category': 'NarrativeText', 'element_id': '2a11838f97b0a2d32b8c3cca2134608e'}, page_content='Although the VPWS model provides multiple point-to-point Ethernet connections in the satellite network, these connections are not bridged or switched together at the hub. Switching is the responsibility of the external Customer Edge equipment or upstream router.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9437193274497986, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2168.9888281249996)), (np.float64(568.75), np.float64(2403.525286458333)), (np.float64(2633.233154296875), np.float64(2403.525286458333)), (np.float64(2633.233154296875), np.float64(2168.9888281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 403, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '78ea78ebcfce30365239e612599d4ad1', 'category': 'NarrativeText', 'element_id': 'e9061284b453aa3ac0b8ee2a2df44a7d'}, page_content='In VPWS mode, when the Hub receives an upstream Ethernet frame destined for a known MAC address behind another remote, it does not forward the frame on the downstream carrier. It does, however, forward the frame to the hub CE to allow the Layer 3 router to determine whether or not to route the frame back to the iDirect hub for downstream transmission.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8800477981567383, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(814.9981079101562), np.float64(2489.822161458333)), (np.float64(814.9981079101562), np.float64(2724.3586197916666)), (np.float64(2590.3366197916666), np.float64(2724.3586197916666)), (np.float64(2590.3366197916666), np.float64(2489.822161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 