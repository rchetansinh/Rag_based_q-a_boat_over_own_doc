25)), (np.float64(568.0933837890625), np.float64(2684.254453125)), (np.float64(2579.435578125), np.float64(2684.254453125)), (np.float64(2579.435578125), np.float64(2447.85791015625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 207, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '99a7d7f91fded310a70fcd396b5dacf3', 'category': 'NarrativeText', 'element_id': 'd92203cb52c4f425668813300009b1b3'}, page_content='For each service level defined, one of the following queue types is used to determine how packets are selected for transmission: Priority Queue, Class-Based Weighted Fair Queue (CBWFQ), and Best-Effort Queue. Priority Queues are emptied before CBWFQs are serviced; CBWFQs, in turn, are emptied before Best-Effort queues are serviced.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9354583621025085, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2730.447161458333)), (np.float64(568.75), np.float64(2903.004453125)), (np.float64(2528.832275390625), np.float64(2903.004453125)), (np.float64(2528.832275390625), np.float64(2730.447161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 207, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '99a7d7f91fded310a70fcd396b5dacf3', 'category': 'NarrativeText', 'element_id': 'bbf2c6a8c8ba4ca11cf9feed63a6deda'}, page_content='The packet scheduling algorithm first services packets from Priority Queues in order of priority, P1 being