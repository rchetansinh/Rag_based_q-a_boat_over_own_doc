458333)), (np.float64(567.5468749999999), np.float64(1914.9836197916663)), (np.float64(607.6595364583333), np.float64(1914.9836197916663)), (np.float64(607.6595364583333), np.float64(1866.384661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 84, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'adc310d851a8f39fb82364a46c97f41f', 'category': 'UncategorizedText', 'element_id': '8da93dab322336b18fc542d89eaa7504'}, page_content='•'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9339522123336792, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(575.9674682617188), np.float64(1866.384661458333)), (np.float64(575.9674682617188), np.float64(2100.9211197916666)), (np.float64(2596.5185546875), np.float64(2100.9211197916666)), (np.float64(2596.5185546875), np.float64(1866.384661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 84, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'adc310d851a8f39fb82364a46c97f41f', 'category': 'ListItem', 'element_id': '80eef079213bb2611e8f8175065e10f2'}, page_content='Each Data SVN has its own independent IP address space, which may be allocated and managed by the subscriber or by the service provider. The service provider also has the option to manage IP addresses in the SAS and OTA routing domains, and to delegate IP address assignment, to their subscribers, in the terminal routing domain .'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9338172078132629, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(561.140869140625), np.float64(2147.1138281249996)), (np.float64(561.140869140625), np.float64(2320.34130859375)), (np.float64(2584.284536458333), np.float64(2320.34130859375)), (np.float64(2584.284536458333), np.float64(2147.1138281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 84, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'adc310d851a8f39fb82364a46c97f41f', 'category': 'ListItem', 'element_id': 'f12c662203d4e68d17723180e10188db'}, page_content='• Unless otherwise stated below, the IP interface address assignments must be unique within the global Data SVN — that is, across all PP servers, access routers, and satellite routers in all locations and sites of the satellite network.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9501296281814575, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.26416015625), np.float64(2362.18017578125)), (np.float64(563.26416015625), np.float64(2662.379453125)), (np.float64(2623.197021484375), np.float64(2662.379453125)), (np.float64(2623.197021484375), np.float64(2362.18017578125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 84, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'adc310d851a8f39fb82364a46c97f41f', 'category': 'ListItem', 'element_id': '4aa1ddcd3974778d9a699c421d712e2f'}, page_content='• Protocol Processor (PP) servers have an IP interface (ETH0), in each Data SVN on the SAS network, to which the operator assigns an IP address. Sometimes this interface is referred to with a name that includes the SVN ID, for example, “eth0.5” for SVN 5. PP servers also have an IP interface in the OTA routing domain, but that IP interface is not explicitly configured and does not have an IP address.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9161393642425537, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(2706.677001953125)), (np.float64(567.5468749999999), np.float64(2819.150286458333)), (np.float64(2460.535888671875), np.float64(2819.150286458333)), (np.float64(2460.535888671875), np.float64(2706.677001953125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 84, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'adc310d851a8f39fb82364a46c97f41f', 'category': 'ListItem', 'element_id': '4912b288d92479c49416fa48ff0ead12'}, page_content='• Access Routers, like PP servers, have an IP interface with an operator assigned IP address, in every Data SVN.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(2865.3429947916666)), (np.float64(567.5468749999999), np.float64(2913.941953125)), (np.float64(607.6595364583333), np.float64(2913.941953125)), (np.float64(607.6595364583333), np.float64(2865.3429947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_mo