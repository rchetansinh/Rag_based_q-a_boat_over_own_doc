720703125), np.float64(400.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 353, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '57a3dd9ab9216b1bcd2ebb02d9612809', 'category': 'NarrativeText', 'element_id': 'd84045ff791c02ac7f78ece273806dd6'}, page_content='value calculated from the geometry). The table could potentially provide a PSD limit, or be factored to scale the PSD limit from a value in dB, to a value in the range of 0-90 degrees. The 0-90 value is what the antenna provides as “Real Skew,” using OpenAMIP. Next, a lookup of the “Real Skew” from the table configured in Velocity, and then the index is translated back to a PSD limit value (actually C/N limit), which is what the hub actually measures on the ground.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9379406571388245, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(805.4471614583332)), (np.float64(568.75), np.float64(1101.9627864583335)), (np.float64(2632.9928697916666), np.float64(1101.9627864583335)), (np.float64(2632.9928697916666), np.float64(805.4471614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 353, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '57a3dd9ab9216b1bcd2ebb02d9612809', 'category': 'NarrativeText', 'element_id': '5d4629d14bf74e6d9e2324556b358289'}, page_content='When the beam pattern of the antenna is irregular, and the PSD limit can vary rapidly in some regions of 3D space, then the 3D table will be somewhat irregular as well. Some regions will be smooth, and other regions irregular. These irregular areas are of more concern on a moving platform — in those areas, a bit more margin might be required. This additional margin is added by adjusting the 3D table to “pessimize” the PSD limit in those regions.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9451081156730652, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1148.1554947916666)), (np.float64(568.75), np.float64(1630.6086197916666)), (np.float64(2637.9147447916666), np.float64(1630.6086197916666)), (np.float64(2637.9147447916666), np.float64(1148.1554947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 353, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '57a3dd9ab9216b1bcd2ebb02d9612809', 'category': 'NarrativeText', 'element_id': '3db4461e0e0584ffc002a7fd1ae24c9a'}, page_content='The concept of “pessimization” can be visualized by simplifying the table from 3D to 2D. Given a raw calculated table as the start, for any cell in the middle, look at the block of 9 cells, which includes the targeted cell in the center of the block. Take the worst PSD for the 9 adjacent cells, and in the new pessimized table, place that worst PSD in the corresponding cell. For edge cells, the concept is similar but fewer adjacent cells to include. The resulting table automatically adjusts skew margin to accommodate regions where skew will vary more rapidly with maneuvers. The following is an example, in which the table on the right is a pessimized version of the table on the left.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5749631524085999, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(780.8335571289062), np.float64(2966.1502864583335)), (np.float64(780.8335571289062), np.float64(3014.7492447916666)), (np.float64(2408.338446803698), np.float64(3014.7492447916666)), (np.float64(2408.338446803698), np.float64(2966.1502864583335))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 353, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '3775d4b71c4b95a7061a230dd3696d40'}, page_content='Figure 8-6. Example a) Standard Skew Table b) Pessimized Skew Table.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.45040813088417053, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(344.1986999511719), np.float64(3513.399169921875)), (np.float64(344.1986999511719), np.float64(3628.525286458333)), (np.float64(1945.6236572265625), np.float64(3628.525286458333)), (np.float64(1945.6236572265625), np.float64(3513.399169921875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 353, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '83edca868865c1b2329af0b747f96310'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/