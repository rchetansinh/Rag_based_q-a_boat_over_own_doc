lications.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.936896026134491, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.4822387695312), np.float64(995.0304947916665)), (np.float64(566.4822387695312), np.float64(1105.6086197916668)), (np.float64(2587.3105781249997), np.float64(1105.6086197916668)), (np.float64(2587.3105781249997), np.float64(995.0304947916665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 46, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '60dda919f2a06ad53f105388b3a84cd7', 'category': 'NarrativeText', 'element_id': '897472d32438cf84bda13177399ad53e'}, page_content='The Velocity System is complemented by complete management and configuration software services enabled by the iDirect Pulse® Network Management System.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9169999957084656, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1151.8013281249998)), (np.float64(568.75), np.float64(1262.379453125)), (np.float64(2485.7012031249997), np.float64(1262.379453125)), (np.float64(2485.7012031249997), np.float64(1151.8013281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 46, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '60dda919f2a06ad53f105388b3a84cd7', 'category': 'NarrativeText', 'element_id': 'cf4b144319bc22d1e52881a0