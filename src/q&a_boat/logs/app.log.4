': 266, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bcdbdd31a3ff8b8068f6bb8a2e11373b', 'category': 'Title', 'element_id': '8223c0df153755bf9df5c00c01ce9e12'}, page_content='6.4.7 Latency Measurement Manager'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9345601797103882, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.1156005859375), np.float64(1587.9886474609375)), (np.float64(567.1156005859375), np.float64(1824.1536865234375)), (np.float64(2619.5762031249997), np.float64(1824.1536865234375)), (np.float64(2619.5762031249997), np.float64(1587.9886474609375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 266, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '8223c0df153755bf9df5c00c01ce9e12', 'category': 'NarrativeText', 'element_id': 'be4ca7557c7362abe0734d2970d418ba'}, page_content='The latency measurement manager process performs periodic polling of all network elements based on configured parameters. It uses Internet Control Message Protocol (ICMP) Echo requests to measure the round trip time (RTT) in the same way the ping utility does. It also generates and stores latency statistics.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8590036630630493, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1909.651123046875)), (np.float64(568.75), np.float64(1983.7220458984375)), (np.float64(1254.7763671875), np.float64(1983.7220458984375)), (np.float64(1254.7763671875), np.f