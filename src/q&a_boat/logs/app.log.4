': 0.9299241900444031, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1908.2388281249998)), (np.float64(568.75), np.float64(1971.4211197916666)), (np.float64(1401.4903564453125), np.float64(1971.4211197916666)), (np.float64(1401.4903564453125), np.float64(1908.2388281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 182, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '1bb766cf9b4bd16d9818c25f78e8fa86', 'category': 'Title', 'element_id': '7787b3cb118948a465188a9ec3e761f8'}, page_content='4.5.4.3 Service Scheduling'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9460504055023193, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2015.8638281249998)), (np.float64(568.75), np.float64(2312.3794531249996)), (np.float64(2601.270751953125), np.float64(2312.3794531249996)), (np.float64(2601.270751953125), np.float64(2015.8638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 182, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '7787b3cb118948a465188a9ec3e761f8', 'category': 'NarrativeText', 'element_id': '226fd46191e7da6c28fa79f44c2e0e9a'}, page_content='Service scheduling provides a service provider with the means to configure the start and end times of a service plan (GSP or subscriber service plan), or to configure a temporary modification in the characteristics of the service plan such as CIR/MIR, in both the GSP and the SSPC, as well as the priority and/or cost in the SSPC. Unicast and multicast service plans both support service scheduling in the same way.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9066081047058105, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2361.8340885416665)), (np.float64(568.75), np.float64(2415.3184635416665)), (np.float64(968.0346392751561), np.float64(2415.3184635416665)), (np.float64(968.0346392751561), np.float64(2361.8340885416665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 182, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '1bb766cf9b4bd16d9818c25f78e8fa86', 'category': 'Title', 'element_id': 'd0d8b0c770b4331d4016f1bc99a02914'}, page_content='Start/End Times'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.94467693567276, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2457.954833984375)), (np.float64(568.75), np.float64(2757.1711197916666)), (np.float64(2629.675161458333), np.float64(2757.1711197916666)), (np.float64(2629.675161458333), np.float64(2457.954833984375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 182, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd0d8b0c770b4331d4016f1bc99a02914', 'category': 'NarrativeText', 'element_id': '6fef36c197fe0d228644ce5e1f455297'}, page_content='Service scheduling supports time-of-day GSP/SSPCs, where different service plans may be used at certain times during the day. For example, a group may have different service plans for business hours, after hours, and weekends. Service scheduling also supports the scheduled creation of a service plan, where a customer requests a temporary GSP or SSPC for a duration specified by start/end dates and times.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9383805394172668, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2803.3638281249996)), (np.float64(568.75), np.float64(3037.900286458333)), (np.float64(2585.440185546875), np.float64(3037.900286458333)), (np.float64(2585.440185546875), np.float64(2803.3638281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 182, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd0d8b0c770b4331d4016f1bc99a02914', 'category': 'NarrativeText', 'element_id': '3dee8f801fea791ec1439ded4c32b6f7'}, page_content='When a GSP that is parent to other GSPs or SSPCs reaches its end date, all of its child nodes will also be effectively ended, regardless of their own start/end date configurations. The exception is an SSPC configured with multiple parent GSPs. In that case, the ending of one GSP will simply cause the SSPC to attempt to draw bandwidth from another eligible GSP.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9307734370231628, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.082275390625), np.float64(3084.092994791666)), (np.float64(566.082275390625)