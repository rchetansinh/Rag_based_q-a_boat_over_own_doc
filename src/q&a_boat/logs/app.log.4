, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 360, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': '7ef0f186e1a5fa129aa7469d4de9d2ea'}, page_content='9.1 About Fair Access Policy'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8989923596382141, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(305.84375), np.float64(397.541666666667)), (np.float64(305.84375), np.float64(485.041666666667)), (np.float64(1572.5189911666664), np.float64(485.041666666667)), (np.float64(1572.5189911666664), np.float64(397.541666666667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 360, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '7ef0f186e1a5fa129aa7469d4de9d2ea', 'category': 'Title', 'element_id': '1df1838d4db77b7566dadac795b962f3'}, page_content='9.1 About Fair Access Policy'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9414882063865662, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.748779296875), np.float64(528.3638281249998)), (np.float64(568.748779296875), np.float64(762.9002864583334)), (np.float64(2621.617869791666), np.float64(762.9002864583334)), (np.float64(2621.617869791666), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 360, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '1df1838d4db77b7566dadac795b962f3', 'category': 'NarrativeText', 'element_id': '693154ddcbd9864d5ab5bf997b4f9238'}, page_content='Fair Access Policy (FAP) allows the service provider to cap and control the bytes consumed by a customer during a given time period. It is often used to implement a type of service referred to as “Pay as you go”. FAP provides the service provider with a rich set of tools, including capped overage bytes, account top-up, rollover, and HTTP redirect.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9443625211715698, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.412109375), np.float64(809.0929947916666)), (np.float64(566.412109375), np.float64(1106.704345703125)), (np.float64(2626.14501953125), np.float64(1106.704345703125)), (np.float64(2626.14501953125), np.float64(809.0929947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 360, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '1df1838d4db77b7566dadac795b962f3', 'category': 'NarrativeText', 'element_id': '91e7fb075530fe80578ec9941ff01552'}, page_content="The policies configured using FAP govern the volume of inbound and outbound traffic (in Mbytes) a GSP or subscriber service plan may consume within a given period of time. When that volume of traffic is used up, depending on the FAP rules configured, the service provider may take various actions such as throttling or blocking the customer's data usage, differential billing, or requiring the user to pay for additional traffic."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9429134130477905, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1151.8013281249998)), (np.float64(568.75), np.float64(1324.3586197916668)), (np.float64(2611.6647447916666), np.float64(1324.3586197916668)), (np.float64(2611.6647447916666), np.float64(1151.8013281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 360, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '1df1838d4db77b7566dadac795b962f3', 'category': 'NarrativeText', 'element_id': '578b31ab9f0364f2c93debf9a7ce8e58'}, page_content='FAP manages the total amount of data (in Mbytes) used under a service plan within a specific period of time (day, week, or month). FAPs can be configured for both GSPs and SSPCs. Assigning a FAP to a GSP or SSPC is optional, and is not required for the system to function.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.937663197517395, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1370.5513281249998)), (np.float64(568.75), np.float64(1543.1086197916666)), (np.float64(2574.43212890625), np.float64(1543.1086197916666)), (np.float64(2574.43212890625), np.float64(1370.5513281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 360, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '1df1838d4db77b7566dadac795b962f3', 'category': 'NarrativeText', 'element_id': '75ecf3601a6312b1f3560b1cfa75ac5d'}, page_content='Multiple FAP rules may be configured for each service plan, and a violation of the FAP rules may result in a notification to the service provider, bandwidth allocation throttling or blocking, or redirection of the user to an “Out of Data Allowance” website.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8928507566452026, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(300.0641174316406), np.float64(1637.125)), (np.float64(300.0641174316406), np.float64(1724.625)), (np.float64(1511.367298875), np.float64(1724.625)), (np.float64(1511.367298875), np.float64(1637.125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 360, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '7ef0f186e1a5fa129aa7469d4de9d2ea', 'category': 'Title', 'element_id': '8220e247e2ab1a1a73804210a66bfe29'}, page_content='9.2 FAP Volume Allowance'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9453494548797607, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.3916625976562), np.float64(1767.947161458333)), (np.float64(567.3916625976562), np.float64(2064.462786458333)), (np.float64(2625.810578125), np.float64(2064.462786458333)), (np.float64(2625.810578125), np.float64(1767.947161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 360, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '8220e247e2ab1a1a73804210a66bfe29', 'category': 'NarrativeText', 'element_id': '582103dd10e677b6d9fbaee5be2cc0a0'}, page_content='Volume allowance is the basic volume of data (in Mbytes) that may be transferred during a FAP allowance period. A FAP allowance can be defined separately for downstream and upstream traffic, or combined for an aggregate allowance — where the same allowance is used for both outbound and inbound traffic. The volume allowance may also be referred to as the regular allowance or periodic allowance.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8743112087249756, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2155.718505859375)), (np.float64(568.75), np.float64(2223.839296875)), (np.float64(1665.19970703125), np.float64(2223.839296875)), (np.float64(1665.19970703125), np.float64(2155.718505859375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 360, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '7ef0f186e1a5fa129aa7469d4de9d2ea', 'category': 'Title', 'element_id': 'b9b550451ddcd0e81a8296b1a04aafdd'}, page_content='9.2.1 FAP with Multicast Traffic'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.950170636177063, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2264.814208984375)), (np.float64(568.75), np.float64(2687.9002864583335)), (np.float64(2612.3574531249997), np.float64(2687.9002864583335)), (np.float64(2612.3574531249997), np.float64(2264.814208984375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 360, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b9b550451ddcd0e81a8296b1a04aafdd', 'category': 'NarrativeText', 'element_id': '9428c72457c906b3e957a9a8e189db43'}, page_content='When tracking multicast bytes used in a FAP, the traffic transmitted in each beam is counted separately. For example, if a single multicast stream was configured to transmit on five beams, 1 Mbyte of transmitted multicast data should be accounted for in FAP as 5 Mbytes of transmitted data. The goal here is to allow the service provider to track the bandwidth actually occupied by the multicast traffic, and thus not available to other customers. If no multicast-SSPCs have joined the multicast stream in a beam, multicast traffic will not be transmitted in that beam and thus no usage is counted against that FAP.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8640847206115723, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2730.3193359375)), (np.float64(568.75), np.float64(2782.9619140625)), (np.float64(2566.217360622343), np.float64(2782.9619140625)), (np.float64(2566.217360622343), np.float64(2730.3193359375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 360, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b9b550451ddcd0e81a8296b1a04aafdd', 'category': 'NarrativeText', 'element_id': '63c333ee2ffa149571d44986964fae4f'}, pag