/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.940876841545105, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(557.5304947916666)), (np.float64(568.75), np.float64(855.3013305664062)), (np.float64(2626.8314114583336), np.float64(855.3013305664062)), (np.float64(2626.8314114583336), np.float64(557.5304947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 343, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '3ee4baaaac252722976a31d5fa974e96', 'category': 'NarrativeText', 'element_id': '9153c45b1c11743322185a064b8a7dc4'}, page_content='It should be noted that once the master modem has acquired into the network, subordinate modems, having no ability to choose satellites, will cycle through available satellite/signaling carriers. For each failed attempt to acquire, there is a delay of up to 25 seconds, which causes the slave acquisition to lag the master modem, and to some extent delay the availability of the expected increased capacity.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8218250274658203, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(825.5800170898438), np.float64(940.3429947916665)), (np.float64(825.5800170898438), np.float64(1051.6302490234375)), (np.float64(2573.740234375), np.float64(1051.6302490234375)), (np.float64(2573.740234375), np.float64(940.3429947916665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 343, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpnt