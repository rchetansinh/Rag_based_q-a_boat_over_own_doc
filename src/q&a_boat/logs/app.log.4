484375), np.float64(528.3638281249998)), (np.float64(567.040771484375), np.float64(824.8794531250002)), (np.float64(2634.925161458333), np.float64(824.8794531250002)), (np.float64(2634.925161458333), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 156, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2a69fff6516fd2ca229d4f9681729a80', 'category': 'NarrativeText', 'element_id': '7eded531158be177bedd7a92f30fab4b'}, page_content='In Velocity systems, Network Operators are able to select between two QoS Service Mode options for system operation. These options, which include the Symbol-based mode of operation and the new IP-based mode, determine the type of service the network will provide in the downstream direction (hub to remotes), and impacts the manner in which global bandwidth management is handled.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9384328126907349, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(871.0721614583332)), (np.float64(568.75), np.float64(1043.629453125)), (np.float64(2590.6767578125), np.float64(1043.629453125)), (np.float64(2590.6767578125), np.float64(871.0721614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 156, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2a69fff6516fd2ca229d4f9681729a80', 'category': 'NarrativeText', 'element_id': '2283b28f46b45418be0bf66737667932'}, page_content='The Symbol-based mode, the QoS operation of all iDirect Evolution networks, and previous Velocity networks, supports data rates in terms of Mbps at a nominal MODCOD or the equivalent of Symbols/s or MHz bandwidth.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9403197169303894, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1089.822161458333)), (np.float64(568.75), np.float64(1324.3586197916668)), (np.float64(2633.83544921875), np.float64(1324.3586197916668)), (np.float64(2633.83544921875), np.float64(1089.822161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 156, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '2a69fff6516fd2ca229d4f9681729a80', 'category': 'NarrativeText', 'element_id': '8cd7e4469e45c12645ed6e168d2c90fb'}, page_content='With the IP-based mode, Service Providers (SPs) can provide Layer-3/IP outbound services, with CIR/MIR specified, strictly in Mbps. This option allows Service Providers to both purchase and further distribute bandwidth in Mbps, and to monitor QoS stats against a given region, based on the IP data rate without overhead.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9275198578834534, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1370.5513281249998)), (np.float64(568.75), np.float64(1481.1294531249998)), (np.float64(2628.760498046875), np.float64(1481.1294531249998)), (np.float64(2628.760498046875), np.float64(1370.5513281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-0