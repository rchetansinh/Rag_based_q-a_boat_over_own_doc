4(2380.447161458333)), (np.float64(568.75), np.float64(2614.9836197916666)), (np.float64(2618.044953125), np.float64(2614.9836197916666)), (np.float64(2618.044953125), np.float64(2380.447161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 112, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f69e64e4c7baa46855d92791c8086c0d', 'category': 'NarrativeText', 'element_id': '58bc0044a3bbfa98d778f61d75e98497'}, page_content='Session Initiation Protocol/Application Layer Gateway (SIP ALG) packets can make use of UDP or TCP as the transport protocol, but the use of UDP is more common. Thus, they are transported through the Velocity system and are treated in the same way as other TCP/UDP packets. In particular, header compression may be enabled.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.940852165222168, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2661.1763281249996)), (np.float64(568.75), np.float64(2833.7336197916666)), (np.float64(2629.009765625), np.float64(2833.7336197916666)), (np.float64(2629.009765625), np.float64(2661.1763281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 112, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f69e64e4c7baa46855d92791c8086c0d', 'category': 'NarrativeText', 'element_id': '8188ec4ec27b4020c4f26d6789aeea0e'}, page_content='However, when NAT is enabled at the satellite router, the SIP protocol is unable to establish connections, because SIP connection negotiation includes the RTP connection information including IP address within the SDP. iDirect has implemented a SIP ALG to solve this problem.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9475368857383728, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.8818969726562), np.float64(2879.9263281249996)), (np.float64(567.8818969726562), np.float64(3176.441953125)), (np.float64(2649.59423828125), np.float64(3176.441953125)), (np.float64(2649.59423828125), np.float64(2879.9263281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 112, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f69e64e4c7baa46855d92791c8086c0d', 'category': 'NarrativeText', 'element_id': 'b0c6ea342402391f67ecac82435201ba'}, page_content='The SIP packets are snooped by the SIP ALG. When the SIP message contains IP addresses that are subject to NAT, a port forwarding rule is dynamically created in the NAT layer and the SIP proxy modifies the contents of the address field with the address provided by the NAT layer for this port forwarding rule. When the call is terminated, the port forwarding rule is removed from the NAT table.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(404.59766455135417), np.float64(3562.900286458333)), (np.float64(404.59766455135417), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 