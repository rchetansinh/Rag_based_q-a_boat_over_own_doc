5445312499966)), (np.float64(2143.47509765625), np.float64(454.75445312499966)), (np.float64(2143.47509765625), np.float64(391.57216145833326))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 175, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f4ea9adb1cc7ee731d8c2fa8edf0014d', 'category': 'Title', 'element_id': 'bce040c4addd35a41599e439b8bf1b56'}, page_content='4.5.1.3 Subscriber Service Plan Limits per Terminal'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9413986206054688, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(560.5294799804688), np.float64(499.1971614583332)), (np.float64(560.5294799804688), np.float64(733.7336197916668)), (np.float64(2600.690786458333), np.float64(733.7336197916668)), (np.float64(2600.690786458333), np.float64(499.1971614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 175, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bce040c4addd35a41599e439b8bf1b56', 'category': 'NarrativeText', 'element_id': 'ddf5f907cb14c7b0efa07d73f593af1b'}, page_content='While there is no explicit limit on the number of SSPPs that can be created in the system, an explicit limit is placed on the number of unicast SSPCs, applications (VRs) and service levels that can be applied to a terminal. Each terminal can support up to 13 active unicast SSPCs plus one for NMS management unicast SSPC (per direction).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9378841519355774, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(560.6026000976562), np.float64(783.5721614583332)), (np.float64(560.6026000976562), np.float64(1018.1086197916668)), (np.float64(2596.46337890625), np.float64(1018.1086197916668)), (np.float64(2596.46337890625), np.float64(783.5721614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 175, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bce040c4addd35a41599e439b8bf1b56', 'category': 'NarrativeText', 'element_id': '51286af6b64e9247839bd0d8ef44214f'}, page_content='If the user decides to create one or more separate unicast SSPC for IGMP (multicast control) unicast traffic, multicast counts against the terminal limits. However, the operator is not required to create a separate unicast SSPC, they could instead cover IGMP traffic in the NMS unicast SSPC, or in one of their other unicast customer SSPC(s).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9511379599571228, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.990478515625), np.float64(1067.947161458333)), (np.float64(563.990478515625), np.float64(1550.400286458333)), (np.float64(2623.8053697916666), np.float64(1550.400286458333)), (np.float64(2623.8053697916666), np.float64(1067.947161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 175, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bce040c4addd35a41599e439b8bf1b56', 'category': 'NarrativeText', 'element_id': '8138c67d1bc90fd0ff2eea8f61cc27df'}, page_content='Furthermore, a unicast SSPC is not restricted to handling a certain type of traffic, but may be configured to handle multiple types of traffic — they may be configured with multiple service levels (for additional information, see Packet Classification on page 173). While multiple service levels can be configured per unicast SSPC, and there is a maximum 13 active unicast SSPCs per terminal, there is also a maximum of 31 service levels across all unicast SSPCs per terminal. The network administrator can configure as many deactivated unicast SSPCs as needed and the VRs and service levels defined within the deactivated unicast SSPCs do not count against the limits defined in the table below.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.572165846824646, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1256.874755859375), np.float64(1618.4679947916663)), (np.float64(1256.874755859375), np.float64(1667.0669531249998)), (np.float64(1922.076171875), np.float64(1667.0669531249998)), (np.float64(1922.076171875), np.float64(1618.4679947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 175, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bce040c4addd35a41599e439b8bf1b56', 'category': 'FigureCaption', 'element_id': 'ce6154a99c1de6bfbfedb9e00e54bfea'}, page_content='Table 4-2. Service Plan Limits'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.425532072782516