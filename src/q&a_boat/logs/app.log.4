height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 283, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd1eef2bed181110a613da9561927b3d7', 'category': 'NarrativeText', 'element_id': 'f287cde1aa7f2e3e11234af41520ba2d'}, page_content='The satellite router software supports MP-BGP (Multi-Protocol - Border Gateway Protocol) for dynamic routing with both IPv4 and IPv6. While the dynamic routing information itself is exchanged through BGP, the configuration of the dynamic routing engine is set from the NMS. This includes configuration for the satellite router to inter-operate with the SAS, and any routing equipment connected to the LAN interface of the satellite router.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9467705488204956, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(987.7388281249998)), (np.float64(568.75), np.float64(1346.2336197916668)), (np.float64(2625.44580078125), np.float64(1346.2336197916668)), (np.float64(2625.44580078125), np.float64(987.7388281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 283, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd1eef2bed181110a613da9561927b3d7', 'category': 'NarrativeText', 'element_id': '4d844876bbd3df4a6399285b29d89220'}, page_content='The satellite router software will exchange routing updates with its peer routers in each SVN on its local LAN and with its peer routers on the SAS network. Based upon the routing information received, the satellite router software consolidates the route information into a forwarding table. The forwarding engine then uses the forwarding table to forward packets either through the satellite link or through the local LAN interface. For more information on BGP, refer to Border Gateway Protocol (BGP) on page 74.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9239158630371094, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1391.692138671875)), (np.float64(568.75), np.float64(1503.0044531249998)), (np.float64(2633.928955078125), np.float64(1503.0044531249998)), (np.float64(2633.928955078125), np.float64(1391.692138671875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 283, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd1eef2bed181110a613da9561927b3d7', 'category': 'NarrativeText', 'element_id': '37d5fb796c875979fe4accc339c1b1a3'}, page_content='Static routing is supported by the satellite router software. When static routes are configured for all IP subnets on the terminal within an SVN, dynamic routing is not required for that SVN.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8644968271255493, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1590.36376953125)), (np.float64(568.75), np.float64(1654.2336197916666)), (np.float64(1115.328857421875), np.float64(1654.2336197916666)), (np.float64(1115.328857421875), np.float64(1590.36376953125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'l