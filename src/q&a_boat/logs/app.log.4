97692cec31bad42187b208fff7b7', 'category': 'NarrativeText', 'element_id': '7f93b558071f43a08b66563eef76e2eb'}, page_content='R). A compact 3 RU Chassis, the iHub supports redundancy, hot-swappable modules, control, timing, power, and cooling for up to 12 line cards.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9329103827476501, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(558.6237182617188), np.float64(557.5304947916666)), (np.float64(558.6237182617188), np.float64(730.0877864583334)), (np.float64(2643.960205078125), np.float64(730.0877864583334)), (np.float64(2643.960205078125), np.float64(557.5304947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 55, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '083f97692cec31bad42187b208fff7b7', 'category': 'ListItem', 'element_id': '6e87775dc5388761b37ed2dba12eaed3'}, page_content='• Intelligent Line Cards (ILC)—With higher capacity and much smaller footprint than ULCs, ILCs provide the intermediate-frequency (IF) modulation and demodulation for all outbound and inbound OTA traffic.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9438053965568542, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(660.5067749023438), np.float64(768.9888281249998)), (np.float64(660.5067749023438), np.float64(1065.504453125)), (np.float64(2634.451203125), np.float64(1065.504453125)), (np.float64(2634.451203125), np.float64(768.9888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype