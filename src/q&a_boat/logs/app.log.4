 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 221, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '7fec2772d366fb29f6bed709983e0ccf'}, page_content='NOTE: The Diversity Site is also a Backup Site.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9285008311271667, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2750.4263281249996)), (np.float64(568.75), np.float64(2813.608619791666)), (np.float64(1270.4189453125), np.float64(2813.608619791666)), (np.float64(1270.4189453125), np.float64(2750.4263281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 221, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': 'd46b401850662eada6040ae06e29ed00'}, page_content='5.1.2.2 Physical Layer'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9491493105888367, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(564.0630493164062), np.float64(2857.44873046875)), (np.float64(564.0630493164062), np.float64(3278.525286458333)), (np.float64(2626.175161458333), np.float64(3278.525286458333)), (np.float64(2626.175161458333), np.float64(2857.44873046875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 221, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd46b401850662eada6040ae06e29ed00', 'category': 'NarrativeText', 'element_id': '395c12739ec17b1f4ed615674c366d85'}, page_content='The diversity switchover is designed such that, during a switchover, active terminals in the network do not drop out of the network. During the switchover, data loss is approximately 6 seconds. To achieve this, the time it takes for the data to flow from the antennas at both RF Gateways to the satellite (t1 and t2 values in diagram) along with the fade changes for each site (fade1 and fade2 values in in diagram) are measured in the Radio Frequency Subsystem (RFS) by a third-party Carrier Measurement System (CMS) and fed back to the PPs. The PPs, in turn, use this information to compensate for network timing and make switch decisions.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4364132583141327, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3507.561279296875)), (np.float64(353.6458333333333), np.float64(3628.525286458333)), (np.float64(1941.248046875), np.float64(3628.525286458333)), (np.float64(1941.248046875), np.float64(3507.561279296875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 221, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd46b401850662eada6040ae06e29ed00', 'category': 'NarrativeText', 'element_id': 'bf8633efd9019ca35c0972eb95207a26'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(met