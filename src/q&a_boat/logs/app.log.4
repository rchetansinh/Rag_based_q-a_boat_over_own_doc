)), (np.float64(568.75), np.float64(854.0461197916668)), (np.float64(2640.573974609375), np.float64(854.0461197916668)), (np.float64(2640.573974609375), np.float64(619.5096614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 155, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '51545c923c9c762fcad53be65bcbbb3d', 'category': 'NarrativeText', 'element_id': '2088936d4f2768e74bf79714f8754b3b'}, page_content='Satellite bandwidth is not statically allocated - instead it is allocated only when demand is actually present. This approach allows service providers to provide best effort services. It also allows service providers to support CIR-based service level agreements and, based on statistical analysis, oversubscribe with respect to CIR.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.6331138610839844, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(602.9620971679688), np.float64(2597.9211197916666)), (np.float64(602.9620971679688), np.float64(2697.5617447916666)), (np.float64(2594.49951171875), np.float64(2697.5617447916666)), (np.float64(2594.49951171875), np.float64(2597.9211197916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 155, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': 'd4b181b7c971e9c1c7201bc5ce1f151f'}, page_content='Figure 4-1. a) Satellite Operator and Service Providers b) Satellite Operator as Service Provider'), Document(metadata={'sour