pload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9458848834037781, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.7501220703125), np.float64(871.0721614583332)), (np.float64(565.7501220703125), np.float64(1229.566953125)), (np.float64(2615.67724609375), np.float64(1229.566953125)), (np.float64(2615.67724609375), np.float64(871.0721614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 291, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '24ff721b12aaf5fb8cb9dd5244c01a98', 'category': 'NarrativeText', 'element_id': '1ba3cb16d312872fc7ac2f17305d1bc7'}, page_content="Once activated, the terminal will be able to enter the network, but it still might not be able to transfer user traffic. In order to obtain the bandwidth needed to transfer user traffic, the terminal's subscriber service plan components (SSPCs) must be configured and must have reached their configured service start times, and must not have expired. This period of time when the service is available is typically set when the service plan is created and configured for a subscriber."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.43133649230003357, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(342.5018310546875), np.float64(3509.24951171875)), (np.float64(342.5018310546875), np.float64(3628.525286458333)), (np.float64(1941.547607421875), np.float64(3628.525286458333)), (np.float64(1941.547607421875), np.float64(3509.24951171875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 291, 'f