(511.3377864583335)), (np.float64(2567.3678697916666), np.float64(511.3377864583335)), (np.float64(2567.3678697916666), np.float64(400.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 308, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '699e224045b1ba4b5d5de03f81ca4349', 'category': 'NarrativeText', 'element_id': 'a6375da3cdc1a9d536d0807b22b731be'}, page_content='on the remote side. This makes the switching transparent from a networking point of view, with no need for the terminal to re-login or re-authenticate.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9510825872421265, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.6375122070312), np.float64(557.5304947916666)), (np.float64(567.6375122070312), np.float64(916.0252864583334)), (np.float64(2634.159536458333), np.float64(916.0252864583334)), (np.float64(2634.159536458333), np.float64(557.5304947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 308, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '699e224045b1ba4b5d5de03f81ca4349', 'category': 'NarrativeText', 'element_id': 'db3103cbce3f5bdcd18f832e5a1860ef'}, page_content='Because the second connection is fully made before the first one is brought down, the mechanism is robust against failures to synchronize the second channel. While the channel conditions are expected to be similar for both connections (same satellite, same atmospheric fade), differences in footprint EIRP (Effective Isotropic Radiated Power) and interference may cause the second channel to be unusable in some edge cases. When this happens, the switch will abort with no disruption to the user traffic.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9365062713623047, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(559.3521118164062), np.float64(962.2179947916665)), (np.float64(559.3521118164062), np.float64(1072.7961197916668)), (np.float64(2613.597036458333), np.float64(1072.7961197916668)), (np.float64(2613.597036458333), np.float64(962.2179947916665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 308, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '699e224045b1ba4b5d5de03f81ca4349', 'category': 'NarrativeText', 'element_id': 'c9f6688cc1729bfdb744da1db8a3df29'}, page_content='After the switch is completed, the terminal may continue moving into the second beam, as is illustrated in the following diagram.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8693116307258606, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.318359375), np.float64(1118.9888281249998)), (np.float64(567.318359375), np.float64(1167.5877864583335)), (np.float64(1498.367919921875), np.float64(1167.5877864583335)), (np.float64(1498.367919921875), np.float64(1118.9888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 308, 'file_directory': '/var/folders/5z/p05w2vpj7b90clp