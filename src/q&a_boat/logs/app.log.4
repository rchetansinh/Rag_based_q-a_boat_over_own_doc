e87dcf1ea5bdeebb780'}, page_content='The reporting time of the ACM status message is not configurable, but the operational steady state margin and fast fade margin are configurable. The parameters are described below:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9304134249687195, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(900.2388281249998)), (np.float64(567.5468749999999), np.float64(1072.7961197916668)), (np.float64(2547.07275390625), np.float64(1072.7961197916668)), (np.float64(2547.07275390625), np.float64(900.2388281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 132, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bef7e68f1358008619bd391b00b0118d', 'category': 'ListItem', 'element_id': '7817c9c6844ba3bc1028a051bf41b51e'}, page_content='• Steady State Margin (default = 0.5 dB) — The margin added to the SNR thresholds measured at hardware qualification to arrive at the operational SNR threshold during steady state operation.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(1118.9888281249998)), (np.float64(567.5468749999999), np.float64(1167.5877864583335)), (np.float64(607.6595364583333), np.float64(1167.5877864583335)), (np.float64(607.6595364583333), np.float64(1118.9888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 132, 'file_directory': '/var/fo