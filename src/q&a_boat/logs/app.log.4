52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 152, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '185a5b873d3c1529dc43243ccef657d6', 'category': 'NarrativeText', 'element_id': 'baab1e9ea58b609c228fccc9c7090a8d'}, page_content="such a carrier is found, the satellite terminal's nominal carrier is changed to the higher- MODCOD carrier."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(557.5304947916666)), (np.float64(567.5468749999999), np.float64(606.1294531250002)), (np.float64(607.6595364583333), np.float64(606.1294531250002)), (np.float64(607.6595364583333), np.float64(557.5304947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 152, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '185a5b873d3c1529dc43243ccef657d6', 'category': 'UncategorizedText', 'element_id': 'cf570bbb43d8e8eeffc336f822889ed0'}, page_content='•'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9358935356140137, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(577.72265625), np.float64(557.5304947916666)), (np.float64(577.72265625), np.float64(730.0877864583334)), (np.float64(2596.2793281249997), np.float64(730.0877864583334)), (np.float64(2596.2793281249997), np.float64(557.5304947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 152, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '185a5b873d3c1529dc43243ccef657d6', 'category': 'ListItem', 'element_id': '8ac9b3f0862e75b05e36b14701757a43'}, page_content="If the satellite terminal cannot switch to a better carrier, the power control algorithm decreases the power as necessary to return the satellite terminal's receive signal to the target C/N."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9291396737098694, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(560.4847412109375), np.float64(776.2804947916666)), (np.float64(560.4847412109375), np.float64(1072.7961197916668)), (np.float64(2584.830810546875), np.float64(1072.7961197916668)), (np.float64(2584.830810546875), np.float64(776.2804947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 152, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '185a5b873d3c1529dc43243ccef657d6', 'category': 'ListItem', 'element_id': '43cae2d06b9e48e3ac3221f6c0878c94'}, page_content='• If a satellite terminal fade is detected, the update interval is increased based on the severity of the fade. Increasing the update interval may require the system to allocate additional upstream slots to the satellite terminal. For idle satellite terminals, the configured MIR is ignored and more slots are allocated if the UCP requires additional burst measurements.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9504192471504211, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.5468749999999), np.float64(1117.1357421875)), (np.float64(567.5468749999999), np.float64(1543.6796875)), (np.float64(2605.70166015625), np.float64(1543.6796875)), (np.float64(2605.70166015625), np.float64(1117.1357421875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 152, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '185a5b873d3c1529dc43243ccef657d6', 'category': 'ListItem', 'element_id': 'a44994814e68564096439077000859fe'}, page_content="• The power control algorithm reacts faster when the SAS determines that a terminal has entered an upstream fade. When monitoring the satellite terminal's receive signal, the algorithm periodically samples the receive C/N. The algorithm determines a fade slope for the satellite terminal based on the difference in receive C/N between successive samples. The algorithm is designed to keep the fade slope linear by increasing the measurement interval during a fade. The algorithm adjusts the measurement interval depending upon the fade slope, such that it is shorter when the fade varies rapidly."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.2641487419605255, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(432.5517883300781), np.float64(3562.900286458333)), (np.float64(432.5517883300781), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 152, 'file_dire