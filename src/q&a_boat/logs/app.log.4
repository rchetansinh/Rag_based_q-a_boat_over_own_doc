 'NarrativeText', 'element_id': '36c82950ff03fb32faad293c026bcf07'}, page_content='Use of customer-written switch decision logic using the external beam switch API is desirable under certain conditions:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9285595417022705, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(943.9888281249998)), (np.float64(673.2760416666666), np.float64(1054.566953125)), (np.float64(2632.154328125), np.float64(1054.566953125)), (np.float64(2632.154328125), np.float64(943.9888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 313, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b5692d7eec58739e7f17cba6fefd1320', 'category': 'ListItem', 'element_id': 'ef664c02adec24b77c8788a8f876fd77'}, page_content='• The network operator wants to optimize based on data not available to the datapath, such as predicted motion of the terminals, business commitments, or other reasons'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8844444751739502, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1100.759661458333)), (np.float64(673.2760416666666), np.float64(1149.3586197916668)), (np.float64(2084.760498046875), np.float64(1149.3586197916668)), (np.float64(2084.760498046875), np.float64(1100.759661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 313, 'file_directory': '/var/folders/5z