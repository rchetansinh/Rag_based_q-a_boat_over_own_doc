2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 327, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'bc0144af16ea46368bdfcea1a9828eba', 'category': 'NarrativeText', 'element_id': 'a42b7261982d7e01236da6542b0a1b28'}, page_content='In this case, where multiple remotes are in an overlapping area, during a period of congestion, the remotes should not be switched simultaneously to a target iNet in the other SAS/satellite — not in the case of the multiple SASs pointed to single satellite; nor in the case of multiple remotes involving SASs pointing to different satellites.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8544045090675354, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1019.7760416666664), np.float64(1613.5461197916661)), (np.float64(1019.7760416666664), np.float64(1662.1450781249996)), (np.float64(2173.897902463802), np.float64(1662.1450781249996)), (np.float64(2173.897902463802), np.float64(1613.5461197916661))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 327, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '26a12dd644a6c0324e4f5a657ec4aba5'}, page_content='Figure 7-22. Multiple SASs with Different Satellites'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8380640149116516, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(829.455810546875), np.float64(1757.009661458333)), (np.float64(829.455810546875), np.float64(1