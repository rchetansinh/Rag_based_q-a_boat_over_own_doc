': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 326, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6175adc80dc4a2fb0ca5f355b598741c', 'category': 'NarrativeText', 'element_id': '07a75a736d2be5e14a4c27980c86a201'}, page_content='In this case, the terminal switches to the iNet that is not experiencing congestion.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8432865142822266, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1017.0899047851562), np.float64(1697.4002864583329)), (np.float64(1017.0899047851562), np.float64(1745.9992447916661)), (np.float64(2180.8359375), np.float64(1745.9992447916661)), (np.float64(2180.8359375), np.float64(1697.4002864583329))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 326, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '7b2c588d53732dbd23ab876393a50a36'}, page_content='Figure 7-20. Multiple SASs with Different Satellites'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9254865646362305, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(555.8497314453125), np.float64(1800.759661458333)), (np.float64(555.8497314453125), np.float64(1911.337786458333)), (np.float64(2646.8251953125), np.float64(1911.337786458333)), (np.float64(2646.8251953125), np.float64(1800.759661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-