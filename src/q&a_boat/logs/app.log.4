.float64(765.5059635416668)), (np.float64(1747.1440048558852), np.float64(697.4382552083332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'adeee49057d646fe77bc385202441d8a', 'category': 'Title', 'element_id': '08b36595af9e988bb7d2c78b3397c679'}, page_content='2.15.3 Layer 2 Over Satellite (L2oS)'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9447690844535828, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.367431640625), np.float64(812.7388281249998)), (np.float64(566.367431640625), np.float64(986.1376953125)), (np.float64(2659.784912109375), np.float64(986.1376953125)), (np.float64(2659.784912109375), np.float64(812.7388281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '08b36595af9e988bb7d2c78b3397c679', 'category': 'NarrativeText', 'element_id': '716e6fc3913785a12c6cbbfa4a5fa733'}, page_content='In Velocity, Layer 2 over Satellite (L2oS) enables the satellite link to emulate an Ethernet con- nection. When an iDirect network is configured for L2oS, Ethernet frames, rather than IP pack- ets, are transported across the satellite link. See Chapter 2 , Velocity System Operations.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9174659252166748, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1076.6049218749997)), (np.float64(568.75), np.float64(1144.6726302083334)), (np.float64(1123.4791259765625), np.float64(1144.6726302083334)), (np.float64(1123.4791259765625), np.float64(1076.6049218749997))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'adeee49057d646fe77bc385202441d8a', 'category': 'Title', 'element_id': 'd42d4c1d3b738c479668234d70ea212f'}, page_content='2.15.4 Multicast'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9239687323570251, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.330322265625), np.float64(1188.259661458333)), (np.float64(566.330322265625), np.float64(1298.8377864583335)), (np.float64(2605.606201171875), np.float64(1298.8377864583335)), (np.float64(2605.606201171875), np.float64(1188.259661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd42d4c1d3b738c479668234d70ea212f', 'category': 'NarrativeText', 'element_id': '555a7c72ab729c833cb0c67038644239'}, page_content='The Velocity system supports downstream IPv4 multicast operation within any SVN. On these SVNs, the PP is an IGMPv3 proxy; and the satellite router is an IGMPv3/IGMPv4 proxy.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9317223429679871, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1345.0304947916666)), (np.float64(568.75), np.float64(1517.587786458333)), (np.float64(2636.0400390625), np.float64(1517.587786458333)), (np.float64(2636.0400390625), np.float64(1345.0304947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd42d4c1d3b738c479668234d70ea212f', 'category': 'NarrativeText', 'element_id': '1dee41e9d4c215d61d73be42e799cb2d'}, page_content='Velocity implements all messages defined in RFC 3376 for IGMPv2 and IGMPv3, namely Membership Query, Version 3 Membership Report, Version 2 Membership Report and Version 2 Leave Group.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9450953006744385, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1563.290771484375)), (np.float64(568.75), np.float64(1984.2544531249998)), (np.float64(2637.681884765625), np.float64(1984.2544531249998)), (np.float64(2637.681884765625), np.float64(1563.290771484375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'd42d4c1d3b738c479668234d70ea212f', 'category': 'NarrativeText', 'element_id': '830a5126058e201aa45fd1a721797208'}, page_content='There is one multicast controller process per iNet (for additional details on iNets, beams, and channels, see Velocity Space Segment on page 13. This process supports multicast independently in each SVN. When a satellite router subscribes or unsubscribes to a multicast stream, the satellite terminal proxy process on the PP server informs the multicast controller in its iNet, and the multicast controller subscribes to the stream and forwards it on the downstream. The satellite terminal proxy process also notifies the multicast controller when the satellite router switches iNets — for example, when it switches beams.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.884228527545929, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.461181640625), np.float64(2075.5632552083334)), (np.float64(568.461181640625), np.float64(2143.6309635416665)), (np.float64(1982.6566162109375), np.float64(2143.6309635416665)), (np.float64(1982.6566162109375), np.float64(2075.5632552083334))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'adeee49057d646fe77bc385202441d8a', 'category': 'Title', 'element_id': 'e6863c9edfcadd0760d25837b8f2e33e'}, page_content='2.15.5 Transmission Control Protocol (TCP)'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9392575025558472, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2187.2179947916666)), (np.float64(568.75), np.float64(2421.7544531249996)), (np.float64(2620.7428697916666), np.float64(2421.7544531249996)), (np.float64(2620.7428697916666), np.float64(2187.2179947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'e6863c9edfcadd0760d25837b8f2e33e', 'category': 'NarrativeText', 'element_id': '8fe0f92e68a45338dd72c53cd30df3da'}, page_content='In satellite networks long round trip delays cause low TCP throughput. Velocity implements acceleration and compression algorithms to accelerate TCP traffic across the satellite links. Each of these features can be enabled/disabled separately for each SVN on a satellite router, and are configurable.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8994648456573486, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.4310913085938), np.float64(2509.8013281249996)), (np.float64(568.4310913085938), np.float64(2572.983619791666)), (np.float64(1394.8968505859375), np.float64(2572.983619791666)), (np.float64(1394.8968505859375), np.float64(2509.8013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'adeee49057d646fe77bc385202441d8a', 'category': 'Title', 'element_id': '934b0c040950766b24cb8af5a4232544'}, page_content='2.15.5.1 TCP Acceleration'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9076378345489502, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(554.9356079101562), np.float64(2615.75146484375)), (np.float64(554.9356079101562), np.float64(2851.962786458333)), (np.float64(2613.3418281249997), np.float64(2851.962786458333)), (np.float64(2613.3418281249997), np.float64(2615.75146484375))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '934b0c040950766b24cb8af5a4232544', 'category': 'NarrativeText', 'element_id': 'b78147901f882ecd1765af3aad1448e6'}, page_content='The protocol layer that implements TCP acceleration in the Velocity system is a Performance Enhancing Proxy (PEP) for TCP traffic. The TCP PEP is a symmetric protocol layer implemented inside the datapath modules at the SAS and also in the remote. TCP acceleration is configurable per-SVN-per-satellite router.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9434494972229004, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2898.1554947916666)), (np.float64(568.75), np.float64(3194.6711197916666)), (np.float64(2637.909912109375), np.float64(3194.6711197916666)), (np.float64(2637.909912109375), np.float64(2898.1554947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '934b0c040950766b24cb8af5a4232544', 'category': 'NarrativeText', 'element_id': '7ce461e30e13de5e87c95ba67d9afa93'}, page_content='TCP acceleration divides every accelerated TCP session into three links: two terrestrial links (between the communicating devices and the Velocity network), and the over the air link (between Velocity endpoints). The protocol is independent of the direction of traffic flow. On the terrestrial links, all TCP packets are sent according to the standard RFCs (Requests for Comment).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9410051107406616, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(3240.8638281249996)), (np.float64(568.75), np.float64(3413.4211197916666)), (np.float64(2634.908935546875), np.float64(3413.4211197916666)), (np.float64(2634.908935546875), np.float64(3240.8638281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '934b0c040950766b24cb8af5a4232544', 'category': 'NarrativeText', 'element_id': '0bdc1e342288a914425e62d452ed34df'}, page_content='When a TCP packet arrives on the LAN (at the satellite router from a local host, or at the SAS) the TCP PEP responds immediately with locally-generated acknowledgments, so that the host on the LAN side thinks the round-trip delay is significantly lower than the actual value. The'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5433040261268616, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(350.15093994140625), np.float64(3514.3013281249996)), (np.float64(350.15093994140625), np.float64(3562.900286458333)), (np.float64(405.9731140136719), np.float64(3562.900286458333)), (np.float64(405.9731140136719), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'adeee49057d646fe77bc385202441d8a', 'category': 'Title', 'element_id': '40c26f90ffd932d8f9f8eb75b21e9950'}, page_content='72'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4531461000442505, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1063.9229736328125), np.float64(3508.91015625)), (np.float64(1063.9229736328125), np.float64(3628.525286458333)), (np.float64(2627.06689453125), np.float64(3628.525286458333)), (np.float64(2627.06689453125), np.float64(3508.91015625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 106, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '40c26f90ffd932d8f9f8eb75b21e9950', 'category': 'NarrativeText', 'element_id': 'a52b960f8051e06206c9fa0e019db10b'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9248595833778381, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1763.769287109375), np.float64(251.28049479166657)), (np.float64(1763.769287109375), np.float64(299.87945312500017)), (np.float64(2633.194091796875), np.float64(299.87945312500017)), (np.float64(2633.194091796875), np.float64(251.28049479166657))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': '0a8c0d90f098a3979b9991f9bbd558b9'}, page_content='2.15.5.2 TCP Connection Acceleration'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9374839067459106, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(400.7596614583332)), (np.float64(568.75), np.float64(635.2961197916668)), (np.float64(2621.3626614583336), np.float64(635.2961197916668)), (np.float64(2621.3626614583336), np.float64(400.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '0a8c0d90f098a3979b9991f9bbd558b9', 'category': 'NarrativeText', 'element_id': '7bfb0bf6e45918b19ff51a83d9f2ba71'}, page_content='TCP PEP handles the reliable transmission of the packet and holds the data packets until they are acknowledged by the peer end point. The size of the buffers needed to hold the unacknowledged packets is configurable and the default value is a function of configured bandwidth for the link, OTA delay, and the amount of memory available.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9437171220779419, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.4252319335938), np.float64(681.4888281249998)), (np.float64(566.4252319335938), np.float64(916.0252864583334)), (np.float64(2628.253286458333), np.float64(916.0252864583334)), (np.float64(2628.253286458333), np.float64(681.4888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '0a8c0d90f098a3979b9991f9bbd558b9', 'category': 'NarrativeText', 'element_id': '44ff5d39efb2fe9412ce7c7532073d5d'}, page_content='The TCP PEP is responsible for TCP session management to the host on the LAN side and is responsible for retransmission and handling of out of sequence packets on the LAN side. The TCP PEP handles over the air retransmission and out of sequence packets that may occur. The TCP PEP supports slow start and TCP congestion control.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8391366004943848, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(763.0083618164062), np.float64(1002.3221614583332)), (np.float64(763.0083618164062), np.float64(1112.9002864583335)), (np.float64(2460.238525390625), np.float64(1112.9002864583335)), (np.float64(2460.238525390625), np.float64(1002.3221614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '46f872154932454991a2486cc08d04a1'}, page_content='NOTE: Current implementation of TCP/UDP related PEPs (acceleration and compression) is applicable to IPv4 only.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9286291599273682, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1241.0513281249998)), (np.float64(568.75), np.float64(1304.2336197916663)), (np.float64(1743.5474853515625), np.float64(1304.2336197916663)), (np.float64(1743.5474853515625), np.float64(1241.0513281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '7029376c82421984b374d35c5b6d958b'}, page_content='2.15.5.2 TCP Connection Acceleration'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9493980407714844, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.2186889648438), np.float64(1348.6763281249998)), (np.float64(567.2186889648438), np.float64(1707.234619140625)), (np.float64(2655.433349609375), np.float64(1707.234619140625)), (np.float64(2655.433349609375), np.float64(1348.6763281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '7029376c82421984b374d35c5b6d958b', 'category': 'NarrativeText', 'element_id': '593340790236e4779c358fd17ac641fc'}, page_content='TCP can optionally be configured for accelerated connection establishment. In standard TCP, a three-way hand shake must be completed before the client can begin sending data. The TCP PEP can speed up this process by responding to the connection request immediately, in parallel with sending a connection request over the air. If the actual connection fails, the TCP PEP sends a TCP reset to the local host. Connection acceleration is performed for TCP connection requests received by both the satellite router and the PP.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9264402389526367, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1795.2179947916666)), (np.float64(568.75), np.float64(1858.400286458333)), (np.float64(1629.14697265625), np.float64(1858.400286458333)), (np.float64(1629.14697265625), np.float64(1795.2179947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '166eac48152ccb25e9120c77e33451af'}, page_content='2.15.5.3 TCP Header Compression'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9376939535140991, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1902.8429947916663)), (np.float64(568.75), np.float64(2137.3794531249996)), (np.float64(2647.212158203125), np.float64(2137.3794531249996)), (np.float64(2647.212158203125), np.float64(1902.8429947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '166eac48152ccb25e9120c77e33451af', 'category': 'NarrativeText', 'element_id': '5acc91a8f9310123656a6600c99f7fd6'}, page_content='The TCP Acceleration layer compresses and decompresses the header for TCP traffic sent over the satellite, following the OTA compressed header message format. The compression context must first be established by exchanging several packets with a full header OTA message format, either IPv4 or IPv6.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9110118746757507, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.8990478515625), np.float64(2225.4263281249996)), (np.float64(565.8990478515625), np.float64(2288.6086197916666)), (np.float64(1434.9053955078125), np.float64(2288.6086197916666)), (np.float64(1434.9053955078125), np.float64(2225.4263281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': 'df4e31308f8e760f94b6eb8b993423b1'}, page_content='2.15.5.4 HTTP Acceleration'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.936198353767395, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2336.697161458333)), (np.float64(568.75), np.float64(2509.254453125)), (np.float64(2621.718994140625), np.float64(2509.254453125)), (np.float64(2621.718994140625), np.float64(2336.697161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'df4e31308f8e760f94b6eb8b993423b1', 'category': 'NarrativeText', 'element_id': '6605f3936924fc9693d5c0499a3a128e'}, page_content='In Velocity, HTTP requests and responses are typically transported via TCP. Thus, the time to load web pages can be greatly decreased by enabling the TCP PEP features of data accel- eration (spoofing), connection acceleration, and compression.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9358701705932617, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2559.0929947916666)), (np.float64(568.75), np.float64(2793.629453125)), (np.float64(2593.94775390625), np.float64(2793.629453125)), (np.float64(2593.94775390625), np.float64(2559.0929947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'df4e31308f8e760f94b6eb8b993423b1', 'category': 'NarrativeText', 'element_id': 'e179d8109d14ae3c72b43727081efa6e'}, page_content='In addition to web page acceleration, by enabling the TCP PEP features, DNS (Domain Name System) caching also speeds up web access. The DNS cache works to speed up lookups of objects in a web page without going over the air for every lookup. For additional details on DNS, see Velocity Data Traffic Protocols on page 71.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.912601888179779, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2881.6763281249996)), (np.float64(568.75), np.float64(2944.858619791666)), (np.float64(1969.6522216796875), np.float64(2944.858619791666)), (np.float64(1969.6522216796875), np.float64(2881.6763281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '4619071a88731655cfba57a21352e378'}, page_content='2.15.5.5 Generic Routing Encapsulation (GRE)'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9393404722213745, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.1903076171875), np.float64(2989.3013281249996)), (np.float64(568.1903076171875), np.float64(3223.837786458333)), (np.float64(2627.7428697916666), np.float64(3223.837786458333)), (np.float64(2627.7428697916666), np.float64(2989.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 107, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '4619071a88731655cfba57a21352e378', 'category': 'NarrativeText', 'element_id': '25a009b12c24f1f4551349d84e236a92'}, page_content='The Velocity system may be configured to accelerate TCP traffic in GRE tunnels that pass through the system. These tunnels do not originate or terminate on Velocity equipment, but the existence of those tunnels must be configured in the Velocity system for TCP acceleration to occur for the traffic within them.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390