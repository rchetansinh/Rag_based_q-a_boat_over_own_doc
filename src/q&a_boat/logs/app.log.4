s/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '3b2d244812875caa4f9c946de3e1f7a2', 'category': 'NarrativeText', 'element_id': '64bd17fa7dbbdfba66843c3c3cda8a9a'}, page_content='The Velocity system has integrated the Fulfillment Ratio Statistics as additional metrics that support unicast SSPCs in the upstream and downstream directions. The Fulfillment Ratio Stats, as listed below, are an enhancement to Satellite Operator and Service Provider SLA reporting.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8224408626556396, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1052.5333251953125), np.float64(830.9679947916665)), (np.float64(1052.5333251953125), np.float64(879.5669531250002)), (np.float64(2095.404296875), np.float64(879.5669531250002)), (np.float64(2095.404296875), np.float64(830.9679947916665))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 386, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '3b2d244812875caa4f9c946de3e1f7a2', 'category': 'FigureCaption', 'element_id': 'f0de6100c53aecd245c29966a70493d0'}, page_content='Table 11-2. CIR/MIR Fulfillment Ratio Statistics'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8830274343490601, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(762.021484375), np.float64(1498.1554947916666)), (np.float64(762.021484375), np.float64(1608.7336197916666)), (np.float64(2473.240478515625), np.float64(1608.7336197916666)), (np.float64(2473.240478515625), np.float64(1498.1554947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 386, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '6c79a949cb095a45d266a3f2b204bab3'}, page_content='NOTE: These stats are reported at 30 second intervals at the SAS/CDC level and 300 second intervals at the NOC level.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9344814419746399, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(555.5615844726562), np.float64(1746.072161458333)), (np.float64(555.5615844726562), np.float64(2042.587786458333)), (np.float64(2532.040283203125), np.float64(2042.587786458333)), (np.float64(2532.040283203125), np.float64(1746.072161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 386, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'a0a42397284f8b6d94f1be0e9df4a718'}, page_content='Fulfillment Ratio stats provide additional SLA performance metrics that are both complementary and an extension of existing CIR and MIR Fulfillment Stats. Their implementation relies on the results of the CIR and MIR fulfillment stats, which are also applicable only to unicast SSPCs. These stats can be enabled per SSPC, on the upstream, downstream, or both.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9502140283584595, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.52392578125), np.float64(2087.811279296875)), (np.float64(567.52392578125), np.float64(2447.275286458333)), (np.float64(2608.879638671875), np.float64(2447.275286458333)), (np.float64(2608.879638671875), np.float64(2087.811279296875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 386, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '414728a100b33fd2fd93f6b4a67d8acf'}, page_content='Whereas CIR/MIR Fulfillment Stats report the percentage of time that the CIR and MIR are respectively achieved, for a given SSPC during a given period, the Fulfillment Ratio Stats can be used by Service Providers in SLA bill settlement, to determine by how much a CIR or MIR SLA has been missed, in terms of bytes, and apply appropriate credits accordingly. The remainder of this section describes CIR/MIR Fulfillment Ratio stats and the calculation at the frame, SAS and NOC levels.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8726733922958374, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2538.584088541667)), (np.float64(568.75), np.float64(2606.651796875)), (np.float64(2149.363434439375), np.float64(2606.651796875)), (np.float64(2149.363434439375), np.float64(2538.584088541667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 386, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '6380c6513321d68c1ed34983373ca6ed'}, page_content='11.4.1 CIR/MIR Fulfillment Ratio Implementation'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9524803161621094, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.3485107421875), np.float64(2647.656494140625)), (np.float64(566.3485107421875), np.float64(3070.712786458333)), (np.float64(2625.345703125), np.float64(3070.712786458333)), (np.float64(2625.345703125), np.float64(2647.656494140625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 386, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6380c6513321d68c1ed34983373ca6ed', 'category': 'NarrativeText', 'element_id': '3e94815c390edbbbea4e885753d511b8'}, page_content='CIR/MIR Fulfillment Ratio stats are directly derived from CIR/MIR Fulfillment stats and are similarly calculated on a per frame basis, as described earlier in this chapter. Like the CIR/MIR Fulfillment Stats, the Fulfillment Ratio stats also use the delayed fulfillment and the fulfillment window size mechanisms for measurement and reporting. Since both CIR/MIR Fulfillment Stats and CIR/MIR Fulfillment Ratio Stats use the same fulfillment window size, the data of these combined metrics represents a coherent set of reports for a given SSPC in a given direction, at any time.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9380543828010559, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(3116.905494791666)), (np.float64(568.75), np.float64(3351.441953125)), (np.float64(2634.123078125), np.float64(3351.441953125)), (np.float64(2634.123078125), np.float64(3116.905494791666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 386, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6380c6513321d68c1ed34983373ca6ed', 'category': 'NarrativeText', 'element_id': 'a0b4eb0963a4b367c2ad4dd8000c6fd7'}, page_content='The CIR/MIR Fulfillment stats (cir_fulfillment, mir_fulfillment) are reported as a percentage, every 5 minutes at the NOC. The operator can use these stats externally (to Velocity/Pulse), to derive performance reports for an extended period, for example 30 days, of how the CIR and MIR was respectively met for a given SSPC in the downstream or upstream direction.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(430.0836416027083), np.float64(3562.900286458333)), (np.float64(430.0836416027083), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 386, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6380c6513321d68c1ed34983373ca6ed', 'category': 'UncategorizedText', 'element_id': '19a3889632da02519d44a1388a46bbb8'}, page_content='352'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5000712275505066, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(106