at64(566.17333984375), np.float64(506.4888281249999)), (np.float64(566.17333984375), np.float64(741.0252864583334)), (np.float64(2598.48095703125), np.float64(741.0252864583334)), (np.float64(2598.48095703125), np.float64(506.4888281249999))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 69, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '62701fa27bdb023c8811df36acf5d079', 'category': 'NarrativeText', 'element_id': '7ef8475921aded4313fe5ba8eaec3970'}, page_content='Figure of Merit (FOM) maps are imported into the Velocity™ system through the NMS and saved on the Protocol Processor. The FOM maps define a figure of merit for each beam and for each geo-location. This FOM lets the SAS balance congestion vs. operation in overlapping areas.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9490416049957275, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.21337890625), np.float64(787.2179947916666)), (np.float64(565.21337890625), np.float64(1083.7336197916668)), (np.float64(2640.612661458333), np.float64(1083.7336197916668)), (np.float64(2640.612661458333), np.float64(787.2179947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 69, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '62701fa27bdb023c8811df36acf5d079', 'category': 'NarrativeText', 'element_id': '16de56a2a0e88c031a054d6d21f87523'}, page_content='The FOM map is specified as a set of closed latitude/longitude contours, with a figure of merit for each contour. The figure of merit is always a positive number or zero. A larger figure of merit indicates a less desirable location. The FOM is scaled to kilobits per second (Kbps); this helps with load balancing. For more information on using Figure of Merit maps, see Terminal Beam Switching on page 271.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.731163501739502, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1135.5684814453125), np.float64(2732.816953125)), (np.float64(1135.5684814453125), np.float64(2781.415911458333)), (np.float64(2056.302734375), np.float64(2781.415911458333)), (np.float64(2056.302734375), np.float64(2732.816953125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 69, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': '9a66857effb189a3ce6bab94d3ebdc4f'}, page_content='Figure 2-1. Example Figure of Merit Map'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9287590980529785, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.7114868164062), np.float64(2867.0929947916666)), (np.float64(566.7114868164062), np.float64(2930.2752864583326)), (np.float64(1954.7440185546875), np.float64(2930.2752864583326)), (np.float64(1954.7440185546875), np.float64(2867.0929947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 69, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 