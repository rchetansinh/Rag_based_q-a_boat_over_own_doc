lders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9429582357406616, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(499.1971614583332)), (np.float64(568.75), np.float64(671.7544531250002)), (np.float64(2627.7998046875), np.float64(671.7544531250002)), (np.float64(2627.7998046875), np.float64(499.1971614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 174, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f10408333dfd72862f5103bf844b58fe', 'category': 'NarrativeText', 'element_id': '7b2471b63493acb4d532fe5dead58245'}, page_content="Multicast traffic differs from unicast traffic in that a single multicast stream transmitted on a beam may be received by any terminal in the beam's footprint. Thus, the bandwidth on a beam or iNet required for transmission is the same regardless of the number of recipients."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9390252828598022, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(717.9471614583332)), (np.float64(568.75), np.float64(952.4836197916668)), (np.float64(2623.259033203125), np.float64(952.4836197916668)), (np.float64(2623.259033203125), np.float64(717.9471614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 174, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f10408333dfd72862f5103bf844b58fe', 'category': 'NarrativeText', 'element_id': 'efc51255a322f33403bbaa0a5fdbd6e3'}, page_content='A multicast subscriber service plan (M-SSPP / M-SSPC) defines a multicast service that may consist of one, several, or unlimited multicast streams. The GBWM options are similar to that of unicast traffic - geographic scope, packet filtering, and classification rules — however the following are also true:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8980668187141418, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(998.6763281249998)), (np.float64(673.2760416666666), np.float64(1047.2752864583335)), (np.float64(1914.4216820924999), np.float64(1047.2752864583335)), (np.float64(1914.4216820924999), np.float64(998.6763281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 174, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f10408333dfd72862f5103bf844b58fe', 'category': 'ListItem', 'element_id': '22b48d4db12dea7657015c508e921d95'}, page_content='• All multicast traffic travels downstream to terminals.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8963273763656616, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1093.4679947916666)), (np.float64(673.2760416666666), np.float64(1142.066953125)), (np.float64(2354.772648613437), np.float64(1142.066953125)), (np.float64(2354.772648613437), np.float64(1093.4679947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 