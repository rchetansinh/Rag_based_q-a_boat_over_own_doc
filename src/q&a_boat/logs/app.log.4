0dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'e093c297a419c165c418e9bdf2d9497d', 'category': 'NarrativeText', 'element_id': '6eee6a8ee417942405f79c68f4b19fb6'}, page_content='The diagram below shows how each iNet QoS enforcement tree dedicates a separate partition for management traffic (NMS GSP), with the highest priority at the top level. The CIR/MIR parameters for each NMS are a percentage of the iNet capacity. The CIR/MIR default is 5%.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9357403516769409, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(717.9471614583332)), (np.float64(568.75), np.float64(891.0658569335938)), (np.float64(2628.981201171875), np.float64(891.0658569335938)), (np.float64(2628.981201171875), np.float64(717.9471614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 201, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'e093c297a419c165c418e9bdf2d9497d', 'category': 'NarrativeText', 'element_id': '152c034efe2f943b2c2d0539fc81be25'}, page_content='At the satellite terminal level, each satellite terminal has an NMS SSPC that is responsible for management traffic. The NMS GSP node at each iNet collects the demand from all satellite terminals, and allocates bandwidth to all satellite terminals in its range.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.39713191986083984, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(702.84375), np.float64(2135.3046875)), (np.float64(702.84375), np.float64(2187.1450781249996)), (np.float64(2490.8441477328647),