786458333)), (np.float64(2617.931884765625), np.float64(1498.1554947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 194, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '456e808b9ec06401abffb47e55d97fcc', 'category': 'NarrativeText', 'element_id': '8cb3787ef24a4d0f0f127947e3f041c3'}, page_content='The geoscope of a GSP, however, may span multiple beams across multiple satellites, and hence across different SASs. Individual SAS QoS Enforcers report the demand/allocation from local GSPs to the central GQE. See Global Bandwidth Allocation on page 165.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8782007694244385, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.0935668945312), np.float64(1762.0215885416667)), (np.float64(568.0935668945312), np.float64(1830.089296875)), (np.float64(1978.436279296875), np.float64(1830.089296875)), (np.float64(1978.436279296875), np.float64(1762.0215885416667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 194, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '746ba9a347e77296400568fa58478b93', 'category': 'Title', 'element_id': '87adc2410bed744b36bb0e7c666393ee'}, page_content='4.6.1 Global QoS Enforcement (GQE) Tree'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9451863169670105, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.7360229492188), np.float64(1872.7164306640625)), (np.float64(566.7360229492188), np.float64(2232.1711197916666)), (np.float64(2630.419189453125), np.float64(2232.1711197916666)), (np.float64(2630.419189453125), np.float64(1872.7164306640625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 194, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '87adc2410bed744b36bb0e7c666393ee', 'category': 'NarrativeText', 'element_id': '77d4158d2192ebd381cd72352f0e87a2'}, page_content='All beams on all satellites defined in the global network contribute bandwidth to a single pool that is managed by GBWM. The GBWM tree (see GBWM Tree Structure on page 142) defines the operation of the GBWM system, and is instantiated at run-time as the Global QoS Enforcement (GQE) tree. This tree actually consists of two completely separate tree structures, one for managing outbound traffic bandwidth demand and allocation and another for inbound traffic.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9476816654205322, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2276.785888671875)), (np.float64(568.75), np.float64(2574.879453125)), (np.float64(2641.242431640625), np.float64(2574.879453125)), (np.float64(2641.242431640625), np.float64(2276.785888671875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 194, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '87adc2410bed744b36bb0e7c666393ee', 'category': 'NarrativeText', 'element_id': '9ea9f8506497cb37010a6cafee62e7a0'}, page_content='The GQE tree is a hierarchical construct of which containership and inheritance rules allow the iterative application of basic allocation methods across groups and child groups. QoS properties configured at each level of the GBWM tree determine how bandwidth is distributed in cases of normal demand (no over-subscription), as well as when demand exceeds availability (over-subscription).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9438289403915405, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2621.072161458333)), (np.float64(568.75), np.float64(2917.587786458333)), (np.float64(2593.58349609375), np.float64(2917.587786458333)), (np.float64(2593.58349609375), np.float64(2621.072161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 194, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '87adc2410bed744b36bb0e7c666393ee', 'category': 'NarrativeText', 'element_id': 'ad8c76d3e1c3bef36728f6578a24b7ce'}, page_content='Each QoS enforcer of the GBWM subsystem creates a QoS Enforcement Tree that reflects its scope. For example, the iNet QOS enforcer creates a tree in which the top node is a DVB-S2 outbound carrier (or the associated TDMA inbound carriers). At the bottom are the SSPCs. Between the top node and the SSPCs, there can be multiple GSP nodes that subdivide the bandwidth as described in GBWM Tree Structure on page 142.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9317886829376221, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2963.780494791666)), (np.float64(568.75), np.float64(3062.22705078125)), (np.float64(2591.3574531249997), np.float64(3062.22705078125)), (np.float64(2591.3574531249997), np.float64(2963.780494791666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 194, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '87adc2410bed744b36bb0e7c666393ee', 'category': 'NarrativeText', 'element_id': '7d3100edfb98e5f7f7dc83369e513c5b'}, page_content='The following diagram depicts an example outbound QoS Enforcement tree and the scope of'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(3025.759661458333)), (np.float64(568.75), np.float64(3074.3586197916666)), (np.float64(996.2995238721876), np.float64(3074.3586197916666)), (np.float64(996.2995238721876), np.float64(3025.759661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 194, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '87adc2410bed744b36bb0e7c666393ee', 'category': 'UncategorizedText', 'element_id': '5b2e6a9c0fcd81712a4588314b9ea2ea'}, page_content='each GSP and SSPC.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8986266851425171, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(668.1763305664062), np.float64(3120.5513