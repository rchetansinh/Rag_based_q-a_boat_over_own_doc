e_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': '020475bec2c58147cabb427d1375fcbe'}, page_content='7.14.3 HEO Satellite and Beam Switching'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9341450929641724, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(561.9927368164062), np.float64(400.7596614583332)), (np.float64(561.9927368164062), np.float64(511.3377864583335)), (np.float64(2607.800161458333), np.float64(511.3377864583335)), (np.float64(2607.800161458333), np.float64(400.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 333, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '020475bec2c58147cabb427d1375fcbe', 'category': 'NarrativeText', 'element_id': '30e12c8c7098184262a337d436dbb1dc'}, page_content='the beams move but the demand remains high in a certain region on the ground (or in the air above the ground).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9201152324676514, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(602.6465885416666)), (np.float64(568.75), np.float64(670.7142968750002)), (np.float64(1904.7459221120312), np.float64(670.7142968750002)), (np.float64(1904.7459221120312), np.float64(602.6465885416666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 333, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '020475bec2c58147cabb427d1375fcbe', 'category': 'Title', 'element_id': '0bf475ee8203f6f93765e4724f76ae52'}, page_content='7.14.3 HEO Satellite and Beam Switching'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.951483964920044, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(714.3013281249998)), (np.float64(568.75), np.float64(1134.7752864583335)), (np.float64(2632.26318359375), np.float64(1134.7752864583335)), (np.float64(2632.26318359375), np.float64(714.3013281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 333, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '0bf475ee8203f6f93765e4724f76ae52', 'category': 'NarrativeText', 'element_id': 'a99eec21688e97445309e238e8913b79'}, page_content='The Velocity 4.0 system allows the operator to integrate services using a combination of HEO (High Elliptical Orbit) and Geosynchronous Equatorial Orbit (GEO) satellites. This requires the integration of the beam and satellite switching between Geosynchronous Satellites and HEO Satellites. Intra-satellite and inter-satellite switching between the Geosynchronous Satellites is done automatically by the iDirect System. Switching between the Geosynchronous and HEO Satellites can also be done through an external API control performed externally by the customer.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9498940706253052, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1180.9679947916666)), (np.float64(568.75), np.float64(1663.5755615234375)), (np.float64(2638.910888671875), np.float64(1663.5755615234375)), (np.float64(2638.910888671875), np.float64(1180.9679947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 333, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '0bf475ee8203f6f93765e4724f76ae52', 'category': 'NarrativeText', 'element_id': '866472354b7226d275846430d890976d'}, page_content='An emergency switchover capability is initiated When the terminal reaches the edge of beam but it has not yet been switched to another iNet (either due to the load balancing algorithm or external command). This emergency switchover is initiated by the iDirect System and is not initiated externally. The purpose of emergency switchover is to prevent a terminal from dropping out of the network. Its purpose is not to optimize or pick the best iNet/beam/ satellite, but to maintain the service. Once the terminal is back in the system, its optimal target iNet/beam/satellite is selected either by the intra-group automated switching or the external API control when the selection of optimum target requires a switch between groups.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9301893711090088, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1754.729921875)), (np.float64(568.75), np.float64(1822.7976302083334)), (np.float64(1578.0899658203125), np.float64(1822.7976302083334)), (np.float64(1578.0899658203125), np.float64(1754.729921875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 333, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '020475bec2c58147cabb427d1375fcbe', 'category': 'Title', 'element_id': 'f52c85eb17a92f71c67c2bb5d5ebffcf'}, page_content='7.14.4 Dynamic Beam Changes'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9485238790512085, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.374755859375), np.float64(1866.384661458333)), (np.float64(568.374755859375), np.float64(2225.458984375)), (np.float64(2634.03076171875), np.float64(2225.458984375)), (np.float64(2634.03076171875), np.float64(1866.384661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 333, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f52c85eb17a92f71c67c2bb5d5ebffcf', 'category': 'NarrativeText', 'element_id': 'd3f77446a5d74cc1ac47ccee42ca476a'}, page_content='Some satellites may project beam footprints that sweep across the ground rather than being stationary, as is common with GEO satellites. This may, for example, be the result of the satellite projecting a fixed pattern from its viewpoint; satellite motion will sweep that fixed pattern across the ground. The exact time interval, number of beams, and number of satellites are operator-configured. The changing beam footprint results in a varying figure of merit on the ground that needs to be constantly updated approximately every 15 minutes.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9326260685920715, 'is_e