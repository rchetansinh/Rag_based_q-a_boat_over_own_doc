2ded43e468e8b3ffabd2ab5f1fe'}, page_content='8.4 Discreet Mode Terminals'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9520331621170044, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.1354370117188), np.float64(528.3638281249998)), (np.float64(568.1354370117188), np.float64(1010.8169531250002)), (np.float64(2637.872314453125), np.float64(1010.8169531250002)), (np.float64(2637.872314453125), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 344, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'ef22c2ded43e468e8b3ffabd2ab5f1fe', 'category': 'NarrativeText', 'element_id': '8c6ae67b542dc1e5b8a304b889db89bd'}, page_content='In some Velocity applications, it may be a requirement that the exact location of a terminal remain unknown to all others. iDirect Velocity supports the terminal discreet mode, in which the geo-location of the terminal is never reported to the hub. Since the terminal location is not revealed, mobile terminals operating in the discreet mode, cannot rely on the reported latitude/longitude to support beam switching and advanced skew control. In discreet mode, the terminal determines the next best beam/iNet to switch to, and sends a geo-location message containing the beam ID of the target beam. For fixed terminals, a lat/long of (0,0) is sent, along with the current Beam ID.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8955836296081543, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.3438110351562), np.float64(1102.1257552083332)), (np.float64(565.3438110351562), np.float64(1170.1934635416667)), (np.float64(1529.484619140625), np.float64(1170.1934635416667)), (np.float64(1529.484619140625), np.float64(1102.1257552083332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 344, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '1764c37f4f046eb3f03b6064feb2ba53', 'category': 'Title', 'element_id': '6e01f925fc8d3e6b9148cd0fef66e6d5'}, page_content='8.4.1 Beam Switch Decision'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9393981695175171, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1213.7804947916666)), (np.float64(568.75), np.float64(1510.2961197916666)), (np.float64(2625.482453125), np.float64(1510.2961197916666)), (np.float64(2625.482453125), np.float64(1213.7804947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 344, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6e01f925fc8d3e6b9148cd0fef66e6d5', 'category': 'NarrativeText', 'element_id': '41171c5c344c127a7fb09faad2a08a4d'}, page_content='The decision to switch beams is based on the service beam in which the discreet mode terminal is currently operating — initially, only beams in the current satellite configuration are considered as new beam targets. As long as one carrier is supported on a visible beam on the current satellite, the terminal will continue to use that satellite. A satellite switch is only initiated if there are no longer any visible beams/iNETs on the current satellite.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9396565556526184, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.7814331054688), np.float64(1556.4888281249998)), (np.float64(563.7814331054688), np.float64(1791.025286458333)), (np.float64(2591.539744791666), np.float64(1791.025286458333)), (np.float64(2591.539744791666), np.float64(1556.4888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 344, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6e01f925fc8d3e6b9148cd0fef66e6d5', 'category': 'NarrativeText', 'element_id': 'cf6e3dedf02c6f49c80d962735523a4c'}, page_content='In determining the target beam to switch to, the terminal first sorts through each of the visible beams on the current satellite according to the distance from the terminal to the nearest beam edge (beam edge distance). The optimal beam is the beam with the greatest edge distance.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9382567405700684, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(561.139892578125), np.float64(1837.2179947916663)), (np.float64(561.139892578125), np.float64(2071.7544531249996)), (np.float64(2584.649119791666), np.float64(2071.7544531249996)), (np.float64(2584.649119791666), np.float64(1837.2179947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 344, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6e01f925fc8d3e6b9148cd0fef66e6d5', 'category': 'NarrativeText', 'element_id': 'd54b98e1cb283d0b2babf1008f880645'}, page_content='If the current beam is visible, a mapping is created to correlate each beam with its beam ID and beam edge distance. A metric is then assigned to each beam in the map. The metric of the current beam is set to ‘0’, whereas the metric for all other beams is computed against the current beam as follows:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.7425737977027893, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(633.2777709960938), np.float64(2110.6554947916666)), (np.float64(633.2777709960938), np.float64(2159.2544531249996)), (np.float64(2459.70556640625), np.float64(2159.2544531249996)), (np.float64(2459.70556640625), np.float64(2110.6554947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 344, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6e01f925fc8d3e6b9148cd0fef66e6d5', 'category': 'NarrativeText', 'element_id': '81c4f41a137b2c86f6ad70c20849c61b'}, page_content='hysteresis_radians - (beam_edge_distance - current_beam_edge_distance)'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.939913272857666, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.6539916992188), np.float64(2205.447161458333)), (np.float64(567.6539916992188), np.float64(2501.9627864583335)), (np.float64(2616.644287109375), np.float64(2501.9627864583335)), (np.float64(2616.644287109375), np.float64(2205.447161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 344, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6e01f925fc8d3e6b9148cd0fef66e6d5', 'category': 'NarrativeText', 'element_id': '71ae4e6840676c9851277dbc43fb4ac0'}, page_content='The optimal beam is then selected as the beam with the lowest metric value. If the selected target is not the current beam, then a beam switch to the optimal beam is initiated by the terminal, which sends a geo-location message that contains the beam ID of the target beam. Subsequently, the PP beam switch process will cause the discreet mode terminal to switch to the new target beam.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8863208293914795, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(835.4480590820312), np.float64(2587.0185546875)), (np.float64(835.4480590820312), np.float64(2761.789306640625)), (np.float64(2486.649119791666), np.float64(2761.789306640625)), (np.float64(2486.649119791666), np.float64(2587.0185546875))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 344, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'a95681d57b4ad315d322fab53155119f'}, page_content='NOTE: 1) The default hysteresis value is set to 0.1 degrees. The computed beam edge distance must exceed the current beam edge distance, by this value, in order to initiate a beam switch.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9496681690216064, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(556.5726318359375), np.float64(2898.1554947916666)), (np.float64(556.5726318359375), np.float64(3256.650286458333)), (np.float64(2635.909536458333), np.float64(3256.650286458333)), (np.float64(2635.909536458333), np.float64(2898.1554947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 344, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '8a0b6c3531457fb4a58f46136ab639c4'}, page_content='It is important to note that the decision of whether to select a new Beam ID is a continuous process, and not only made as the terminal nears a beam edge. The beam selection logic, excluding the influence of hysteresis, will select the beam that is furthest from beam edge. In the case of network operators that use a combination of spot beams and broad beams, a number of the spot beams may not be selected. This beam selection logic is further illustrated in the following example, which is described in the subsequent steps:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4214685559272766, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(350.0343322753906), np.float64(3514.3013281249996)), (np.float64(350.0343322753906), np.float64(3562.900286458333)), (np.float64(432.94024658203125), np.float64(3562.900286458333)), (np.float64(432.94024658203125), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languag