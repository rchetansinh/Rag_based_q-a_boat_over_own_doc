26-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 203, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': '193c759d3e19dd1296c6b8cd15d995f7'}, page_content='4.6.4.2 Allocation Fairness Relative to CIR'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9441154599189758, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.2151489257812), np.float64(400.7596614583332)), (np.float64(565.2151489257812), np.float64(635.2961197916668)), (np.float64(2631.133494791666), np.float64(635.2961197916668)), (np.float64(2631.133494791666), np.float64(400.7596614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 203, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '193c759d3e19dd1296c6b8cd15d995f7', 'category': 'NarrativeText', 'element_id': '2e1d99d1d0ea5ed2fda5f9d2f017065a'}, page_content='The previous illustration shows a simple case, with two child GSPs with equal priority and cost, but different CIR and nominal MODCOD. That GSP-B has been configured with a higher CIR and lower nominal MODCOD does not matter; any allocation available to the parent GSP is simply divided equally among the child GSPs.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8578163385391235, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(681.4888281249998)), (np.float64(568.75), np.float64(730.0877864583334)), (np.float64(2261.769775390625), np.float64(730.0877864583334)), (np.float64(2261.769775390625), np.float64(681.4888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 203, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '193c759d3e19dd1296c6b8cd15d995f7', 'category': 'NarrativeText', 'element_id': '058b171a4a43bd310b472ecfd7224d85'}, page_content='The same equal distribution of bandwidth occurs if the child nodes are SSPCs.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8988359570503235, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(833.8157958984375), np.float64(816.3846614583332)), (np.float64(833.8157958984375), np.float64(988.9419531250002)), (np.float64(2586.041015625), np.float64(988.9419531250002)), (np.float64(2586.041015625), np.float64(816.3846614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 203, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '57507eeb70fb12e2519858b8e5815ca4'}, page_content='NOTE: Note that if there is a difference in MODCOD, fairness relative to bandwidth results in the node with the less efficient MODCOD delivering lower Kbps for this allocation period.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9369770288467407, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(561.1610717773438), np.float64(1126.2804947916666)), (np.float64(561.1610717773438), np.float64(1298.8377864583335)), (np.float64(2629.857453125), np.float64(1298.8377864583335)), (np.float64(2629.857453125), np.float64(1126.2804947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 203, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'd660ff44b7a9d72b6dbce74bbced46ea'}, page_content='Consider the following example in which two SSPCs are operating at MODCODs of 8PSK3/4 and QPSK3/4, respectively. The spectral efficiency for 8PSK3/4 is approximately 2.05 and QPSK3/4 is approximately 1.37 after accounting for BBFRAME overhead.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5499686598777771, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(648.35009765625), np.float64(2196.8794531249996)), (np.float64(648.35009765625), np.float64(2245.478411458333)), (np.float64(2543.717529296875), np.float64(2245.478411458333)), (np.float64(2543.717529296875), np.float64(2196.8794531249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 203, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'FigureCaption', 'element_id': 'd3d65050e58c1cebf9fb48fc5ce4829f'}, page_content='Figure 4-22. Example of Allocation Fairness Relative to Bandwidth with child SSPCs'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8868969082832336, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(845.1770833333333), np.float64(2340.3429947916666)), (np.float64(845.1770833333333), np.float64(2450.9211197916666)), (np.float64(2577.81396484375), np.float64(2450.9211197916666)), (np.float64(2577.81396484375), np.float64(2340.3429947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 203, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '9c496f7bca36686d93103108c9679b97'}, page_content='NOTE: Fairness relative to bandwidth is always applied, but does not preclude the additional application of other fairness methods described below.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9101187586784363, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2579.072161458333)), (np.float64(568.75), np.float64(2642.2544531249996)), (np.float64(1855.3185240070832), np.float64(2642.2544531249996)), (np.float64(1855.3185240070832), np.float64(2579.072161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 203, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '191fd13545908a7d46ddb2ddcd6f2680'}, page_content='4.6.4.2 Allocation Fairness Relative to CIR'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9413491487503052, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2686.697161458333)), (np.float64(568.75), np.float64(2983.212786458333)), (np.float64(2580.0553697916666), np.float64(2983.212786458333)), (np.float64(2580.0553697916666), np.float64(2686.697161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 203, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '191fd13545908a7d46ddb2ddcd6f2680', 'category': 'NarrativeText', 'element_id': 'a5bbfa9571c6018babace0da8c1ddcba'}, page_content='Allocation fairness relative to CIR allows the CIR/MIR allocation to be proportional to the current CIR during periods of contention. The system computes an internal cost parameter that is used by the demand allocation algorithm to implement the proportional allocation behavior. The GSP cost parameter is still available to the user. It may be used in both the inbound and outbound directions.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9453310370445251, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.9042358398438), np.float64(3029.405494791666)), (np.float64(565.9042358398438), np.float64(3387.900286458333)), (np.float64(2617.22998046875), np.float64(3387.900286458333)), (np.float64(2617.22998046875), np.float64(3029.405494791666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 203, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '191fd13545908a7d46ddb2ddcd6f2680', 'category': 'NarrativeText', 'element_id': '0c9ad48a95340e252c7dd785289eea16'}, page_content='For example, consider an outbound of 8 Mbps partitioned into two GSPs, for two different service providers, GSP-A with a 3 Mbps CIR and GSP-B with a 9 Mbps CIR. Assuming consistent MODCODs, allocation fairness relative to CIR, and bandwidth demand from both service providers greater than CIR, during contention the system will automatically calculate a cost parameter for each service provider proportional to the CIRs, resulting in an allocation of (8*3/(3+9)) = 2 Mbps for GSP-A and (8*9/(3+9)) = 6 Mbps for GSP-B.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.458389014005661, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(1680.671875), np.float64(3562.900286458333)), (np.float64(1680.671875), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 203, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '191fd13545908a7d46ddb2ddcd6f2680', 'category': 'NarrativeText', 'element_id': 'efb17a6495e1fae2d625da535ed87e86'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5060696005821228, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3579.9263281249996)), (np.float64(353.6458333333333), np.float64(3628.525286458333)), (np.float64(1917.4332275390625), np.float64(3628.525286458333)), (np.float64(1917.4332275390625), np.float64(3579.92632