affic are accounted for separately in iNet overhead.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4610872268676758, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3509.52392578125)), (np.float64(353.6458333333333), np.float64(3628.525286458333)), (np.float64(1945.8250732421875), np.float64(3628.525286458333)), (np.float64(1945.8250732421875), np.float64(3509.52392578125))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 193, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '921515c053656df21f8b75a509c7e4a9', 'category': 'NarrativeText', 'element_id': '60143456c4402056a704d91043072bef'}, page_content='ST Engineering iDirect Proprietary | Confidentiality: Public Technical Reference Guide | iDirect Velocity™ | T0001665 | Revision 1'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(2544.864583333333), np.float64(3514.3013281249996)), (np.float64(2544.864583333333), np.float64(3562.900286458333)), (np.float64(2621.302391602708), np.float64(3562.900286458333)), (np.float64(2621.302391602708), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 193, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '921515c053656df21f8b75a509c7e4a9', 'category': 'UncategorizedText', 'element_id': 'a8c87eae7764b64bc9