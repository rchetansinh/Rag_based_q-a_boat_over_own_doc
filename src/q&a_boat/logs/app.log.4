td1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9129542708396912, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(779.5424218749998)), (np.float64(568.75), np.float64(833.0267968750001)), (np.float64(1692.66455078125), np.float64(833.0267968750001)), (np.float64(1692.66455078125), np.float64(779.5424218749998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 205, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '6172eddf2305b2b1d8ac8129d8ef8d20', 'category': 'Title', 'element_id': 'f0acc6295a4fbcaaafd45729ca1b1fdb'}, page_content='Allocation Fairness Relative to Base MODCOD'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9369868636131287, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(565.0377197265625), np.float64(878.3638281249998)), (np.float64(565.0377197265625), np.float64(1112.9002864583335)), (np.float64(2620.378286458333), np.float64(1112.9002864583335)), (np.float64(2620.378286458333), np.float64(878.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 205, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f0acc6295a4fbcaaafd45729ca1b1fdb', 'category': 'NarrativeText', 'element_id': 'e29f610adb8f815c0409be2649c64804'}, page_content='Allocation fairness relative to base MODCOD applies an internal cost parameter to each SSPC based on the configured base MODCOD. This option is suitable for a satellite network with fixed satellite terminals where the base MODCOD is typically used as the operating point for satellite terminals with additional rain fade margin.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9467127919197083, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1159.0929947916666)), (np.float64(568.75), np.float64(1455.69677734375)), (np.float64(2617.3623046875), np.float64(1455.69677734375)), (np.float64(2617.3623046875), np.float64(1159.0929947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 205, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f0acc6295a4fbcaaafd45729ca1b1fdb', 'category': 'NarrativeText', 'element_id': 'aaaaac0eb7f7abbc8fca4d7741d350ba'}, page_content='For example, consider two SSPCs that belong to a single GSP, where SSPC-A on Terminal A is configured with 3 Mbps CIR and has a base MODCOD of 8PSK 3/4, and SSPC-B on Terminal B is also configured with 3 Mbps CIR, but has a different base MODCOD of QPSK 3/4. (Recall that the spectral efficiency for 8PSK3/4 is approximately 2.05 and QPSK3/4 is approximately 1.37 after accounting for BBFRAME overhead.)'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.940520703792572, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1501.8013281249998)), (np.float64(568.75), np.float64(1736.337786458333)), (np.float64(2621.054931640625), np.float64(1736.337786458333)), (np.float64(2621.054931640625), np.float64(1501.8013281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 205, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f0acc6295a4fbcaaafd45729ca1b1fdb', 'category': 'NarrativeText', 'element_id': '464fd8335a77df74f0564e0864517d28'}, page_content='During contention, using the default scheme (allocation fairness relative to bandwidth), the allocation of symbols will be split equally between the two satellite terminals as described in Allocation Fairness Relative to Bandwidth (default). However, Terminal A receives 1025 Kbps while Terminal B only gets 685 Kbps due to the operating MODCOD.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.928463876247406, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.8887329101562), np.float64(1782.5304947916663)), (np.float64(566.8887329101562), np.float64(1955.087786458333)), (np.float64(2584.940786458333), np.float64(1955.087786458333)), (np.float64(2584.940786458333), np.float64(1782.5304947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 205, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f0acc6295a4fbcaaafd45729ca1b1fdb', 'category': 'NarrativeText', 'element_id': '5f47c91e1e08bd20495244766f5dd768'}, page_content='However, if the allocation fairness relative to base MODCOD option is selected, allocation is based on bits/sec rather than satellite bandwidth, so both Terminals A and B will get approximately 820 Kbps.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390da