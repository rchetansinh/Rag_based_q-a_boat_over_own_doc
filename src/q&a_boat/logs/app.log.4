ctory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Header', 'element_id': 'ade4b51ab627fc3faa1b6a712bbda802'}, page_content='7.11 Terminal Beam Switching'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9087206125259399, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(311.3017578125), np.float64(397.541666666667)), (np.float64(311.3017578125), np.float64(485.041666666667)), (np.float64(1617.732421875), np.float64(485.041666666667)), (np.float64(1617.732421875), np.float64(397.541666666667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'ade4b51ab627fc3faa1b6a712bbda802', 'category': 'Title', 'element_id': 'e296e986c9e7003673a1ae36daff8ed9'}, page_content='7.11 Terminal Beam Switching'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9436459541320801, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(562.6666870117188), np.float64(528.3638281249998)), (np.float64(562.6666870117188), np.float64(824.8794531250002)), (np.float64(2616.7001953125), np.float64(824.8794531250002)), (np.float64(2616.7001953125), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'e296e986c9e7003673a1ae36daff8ed9', 'category': 'NarrativeText', 'element_id': 'dc1cfd9da70821fa8ea97c3c16bc22b5'}, page_content='Once a terminal has acquired into a network, it will remain supported by the initial beam until a decision to switch has been made. It is not uncommon, however, for a terminal to simultaneously lie within a number of beam footprints. This state can occur for instance with a mobile terminal as it moves from one beam to another; and in stationary terminals where beams overlap. In either case, the terminal will acquire into the network using a single beam.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9376751184463501, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.439208984375), np.float64(871.0721614583332)), (np.float64(563.439208984375), np.float64(1168.334228515625)), (np.float64(2586.482421875), np.float64(1168.334228515625)), (np.float64(2586.482421875), np.float64(871.0721614583332))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'e296e986c9e7003673a1ae36daff8ed9', 'category': 'NarrativeText', 'element_id': 'e09fcd87df6944cb5cb7aca884e8d114'}, page_content='The beam switching operation has two distinct components — first is the mechanics of the switch, which refers to the actual switching itself and the effect on the physical layer and user traffic. The second is the decision logic, which is how the decision to switch is actually made. This first component, the mechanics of switching, is described in the following sections. See , for the second component — the beam switching decision logic.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8735405802726746, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(831.4046020507812), np.float64(1253.884661458333)), (np.float64(831.4046020507812), np.float64(1364.462786458333)), (np.float64(2511.362060546875), np.float64(1364.462786458333)), (np.float64(2511.362060546875), np.float64(1253.884661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '3f18e19f2c5d33cad188918f11c4c956'}, page_content='NOTE: A switch can occur between iNets on the same satellite or between iNets on different satellites.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9448789358139038, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1501.8013281249998)), (np.float64(568.75), np.float64(1798.3169531249998)), (np.float64(2591.065786458333), np.float64(1798.3169531249998)), (np.float64(2591.065786458333), np.float64(1501.8013281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '414a4344ffbb7ad4d881f592b0679500'}, page_content='The modem timestamps and logs key events during a beam switch; the log is stored in a file on the modem. The log file may be processed offline to measure traffic interruption time or to support debugging. The maximum file size is 200 KB (older entries are over- written). Retrieval of the log file is done through SSH to modem. The log file is located in the /var/log/messages folder.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9272018074989319, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1889.6257552083334)), (np.float64(568.75), np.float64(1957.6934635416667)), (np.float64(1882.6917724609375), np.float64(1957.6934635416667)), (np.float64(1882.6917724609375), np.float64(1889.6257552083334))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '59430bc75f34350409de5115d365733c'}, page_content='7.11.1 Mechanics of Terminal Switching'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9127649068832397, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(2001.2804947916663)), (np.float64(568.75), np.float64(2049.8794531249996)), (np.float64(1872.0010986328125), np.float64(2049.8794531249996)), (np.float64(1872.0010986328125), np.float64(2001.2804947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 305, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '59430bc75f34350409de5115d365733c', 'category': 'NarrativeText', 'element_i