lication/pdf', 'languages': ['eng'], 'page_number': 174, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f10408333dfd72862f5103bf844b58fe', 'category': 'ListItem', 'element_id': '88303aaa995569c923c0ef53e031e3f6'}, page_content='• FAP is not available for M-SSPPs; it can only be configured at the GSP level.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8512767553329468, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(673.2760416666666), np.float64(1377.8429947916666)), (np.float64(673.2760416666666), np.float64(1426.4419531249998)), (np.float64(1971.42578125), np.float64(1426.4419531249998)), (np.float64(1971.42578125), np.float64(1377.8429947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 174, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f10408333dfd72862f5103bf844b58fe', 'category': 'ListItem', 'element_id': 'fd65c2da0ba97c66a9931e73fd694a19'}, page_content='• Recurring service plan modifications are not supported.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9412530660629272, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.1929321289062), np.float64(1471.4322509765625)), (np.float64(566.1929321289062), np.float64(1707.1711197916663)), (np.float64(2631.389892578125), np.float64(1707.1711197916663)), (np.float64(2631.389892578125), np.float64(1471.4322509765625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 174, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f10408333dfd72862f5103bf844b58fe', 'category': 'NarrativeText', 'element_id': '7fc480d1c7bf8034cfbb600a7b61f2d5'}, page_content='The multicast streams that the M-SSPP enables are specified in its application service level classification rules. The classification rules may specify one multicast stream (i.e., multicast IP address), multiple multicast streams, or even match all multicast streams. If the same stream is specified in two service plans on a terminal, the one with higher priority is applied.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.2886975109577179, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(353.6458333333333), np.float64(3514.3013281249996)), (np.float64(353.6458333333333), np.float64(3562.900286458333)), (np.float64(432.98309326171875), np.float64(3562.900286458333)), (np.float64(432.98309326171875), np.float64(3514.3013281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 174, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'f10408333dfd72862f5103bf844b58fe', 'category': 'NarrativeText', 'element_id': 'efba4607c37febca0a6c48cfb29028ce'}, page_content='140'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4795354902744293, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1060.9215087890625), np.float64(3510.846923828125)), (np.float64(1060.9215087890625), 