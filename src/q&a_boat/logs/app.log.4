64(856.4888281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 145, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'a23effacca899a15109a80ca3b7cbe9b', 'category': 'NarrativeText', 'element_id': 'fdf7bb29eb3dd86985e6a5033c098310'}, page_content='Spread spectrum BPSK mode for ULC-R is affected as well in which case the ranges provided in the Table 3-2 are inferred as chip rate.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.4393481910228729, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(834.984130859375), np.float64(1057.009661458333)), (np.float64(834.984130859375), np.float64(1107.1165771484375)), (np.float64(1984.45166015625), np.float64(1107.1165771484375)), (np.float64(1984.45166015625), np.float64(1057.009661458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 145, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '512a7fb884291bfa1ac367c1f6bbcbdc'}, page_content='NOTE: Supported chip rates are from 1 to 7.5 Mcps.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9346761703491211, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(563.365234375), np.float64(1242.947161458333)), (np.float64(563.365234375), np.float64(1415.8299560546875)), (np.float64(2580.0553697916666), np.float64(1415.8299560546875)), (np.float64(2580.0553697916666), np.float64(1242.947161458333))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 145, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': 'c1e2b14dcb1a56b8b0dc9b34925d5282'}, page_content='For ILC-R, the affected symbol-rate ranges are narrower, from 2ksps to 4ksps in magnitude, and far fewer. Unlike the ULC-R, only the lowest 3 MODCODs are affected. Details of these affected symbol-rate ranges are provided after the ULC-R coverage below.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9168468713760376, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(556.554443359375), np.float64(1465.3429947916666)), (np.float64(556.554443359375), np.float64(1575.9211197916666)), (np.float64(2547.16796875), np.float64(1575.9211197916666)), (np.float64(2547.16796875), np.float64(1465.3429947916666))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 145, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'NarrativeText', 'element_id': '1981894b6ff30458857c787bb64c3607'}, page_content='All Velocity releases are affected by this issue. iDirect recommends avoiding these symbol rates when configuring inroute groups.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.7229029536247253, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(844.2826538085938), np.float64(1662.93