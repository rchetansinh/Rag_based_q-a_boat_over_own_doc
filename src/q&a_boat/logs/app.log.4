folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'category': 'Title', 'element_id': '52c8a24129c260627f96b69507300186'}, page_content='4.5.5.3 IP Minimum Efficiency'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9494240283966064, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1497.97900390625)), (np.float64(568.75), np.float64(1856.650286458333)), (np.float64(2613.840576171875), np.float64(1856.650286458333)), (np.float64(2613.840576171875), np.float64(1497.97900390625))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 191, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '52c8a24129c260627f96b69507300186', 'category': 'NarrativeText', 'element_id': '31db3fadfeec09fd051b49c14d825818'}, page_content='In the IP-based service mode, only IP bits and bytes are taken into consideration in the use and enforcement of the CIR/MIR in the downstream direction. The corresponding symbols (Msps) needed to fulfill the contracted CIR/MIR in Mbps, are not considered, and there is no cap on symbols used to satisfy a given CIR/MIR allocation. As such, without any measurement and control of the efficiency, terminals operating at low and inefficient MODCODs, exceed their fair share of the satellite bandwidth (Msps).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9524408578872681, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1902.8429947916663)), (np.float64(568.75), np.float64(2385.2961197916666)), (np.float64(2634.451203125), np.float64(2385.2961197916666)), (np.float64(2634.451203125), np.float64(1902.8429947916663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 191, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '52c8a24129c260627f96b69507300186', 'category': 'NarrativeText', 'element_id': '6b57896253e3e2280aaeeb4d35f85152'}, page_content='Configuring the IP efficiency allows Satellite Operators and Service Providers to specify, at the GSP level, a desired operating efficiency that would provide an efficiency lower limit. If the operating GSP efficiency (ratio of Allocated IP Bits to Distributed Bandwidth in Symbols), reported in the last interval, is higher than the configured minimum efficiency, the GSP CIR/MIR is not scaled down or scaled up. Below this lower limit, the configured CIR/MIR on the GSP downstream is scaled down. With this down scale, the symbols used to satisfy a given CIR/MIR allocation is thereby capped, and available bandwidth is distributed fairly among GSP child nodes as long as they operate within prescribed guidelines.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9413596987724304, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(566.6824951171875), np.float64(2431.4888281249996)), (np.float64(566.6824951171875), np.float64(2789.9836197916666)), (np.float64(2634.123078125), np.float64(2789.9836197916666)), (np.float64(2634.123078125), np.float64(2431.4888281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 191, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '52c8a24129c260627f96b69507300186', 'category': 'NarrativeText', 'element_id': 'e09359d81c98c815fdfecd0b27658751'}, page_content='Based on an assumed mix of terminal types, beam types, carrier usage, or number of terminals of each type, Satellite Operators and Service Providers can determine the efficiency (IP bits/Symbol) needed to fulfill certain operational objectives. This threshold efficiency would be based on an expected level of performance. Any operating efficiency that falls below the expected target causes the CIR/MIR to be scaled down by a scale factor equal to the measured efficiency (M) divided by the threshold efficiency (E) or M/E.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.8974084854125977, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(564.5437622070312), np.float64(2836.1763281249996)), (np.float64(564.5437622070312), np.float64(2884.775286458333)), (np.float64(1627.549265416667), np.float64(2884.775286458333)), (np.float64(1627.549265416667), np.float64(2836.1763281249996))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 191, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '52c8a24129c260627f96b69507300186', 'category': 'NarrativeText', 'element_id': '2a080e45272d8a463d5bb944a04a845f'}, page_content='f M < E then scale down the CIR/MIR as follows:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.5493055582046509, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(845.442138671875), np.float64(2922.2786979166667)), (np.float64(845.442138671875), np.float64(2981.771588541666)), (np.float64(1461.3461868096874), np.float64(2981.771588541666)), (np.float64(1461.3461868096874), np.float64(2922.2786979166667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 191, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '52c8a24129c260627f96b69507300186', 'category': 'NarrativeText', 'element_id': '73ab35ab60db7a17023c273a6e00abda'}, page_content='CIRscaled = CIRcurrent * (M/E)'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(845.8333333333333), np.float64(3011.9661979166663)), (np.float64(845.8333333333333), np.float64(3071.4226302083334)), (np.float64(1472.137853476354), np.float64(3071.4226302083334)), (np.float64(1472.137853476354), np.float64(3011.9661979166663))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 191, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': '52c8a24129c260627f96b69507300186', 'category': 'UncategorizedText', 'element_id': '5125a4bad889e66f9bf83171232d7f42'}, page_content='MIRscaled = MIRcurrent * (M/E)'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9029327630996704, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(3110.306536458333)), (np.float64(568.75), np.float64(3158.905494791666)), (np.floa