at64(397.541666666667)), (np.float64(299.8392028808594), np.float64(485.39044189453125)), (np.float64(1359.9024658203125), np.float64(485.39044189453125)), (np.float64(1359.9024658203125), np.float64(397.541666666667))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 354, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'c006047be3f18d23bf291a5fb7f23a38', 'category': 'Title', 'element_id': 'b53c995f73fb6dbebff0df3beba2c538'}, page_content='8.6 Fast SNR Reporting'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9486464262008667, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(528.3638281249998)), (np.float64(568.75), np.float64(886.8586197916668)), (np.float64(2647.2587890625), np.float64(886.8586197916668)), (np.float64(2647.2587890625), np.float64(528.3638281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 354, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b53c995f73fb6dbebff0df3beba2c538', 'category': 'NarrativeText', 'element_id': 'e9443cafb4a5aabf363f619897299937'}, page_content='The fast SNR reporting feature is based on an iDirect modem products feature, referred to as the receive signal strength indicator (RSSI) signal. Fast SNR reporting, in a modem, allows the modem to use OpenAMIP to report its carrier signal-to-noise ratio (SNR) as measured at the demodulator. This information provides an error compensation component, needed to support closed-loop feedback, which allows mobile terminal integrators to dynamically control antenna pointing.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9496190547943115, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(567.9171142578125), np.float64(933.0513281249998)), (np.float64(567.9171142578125), np.float64(1415.5044531249998)), (np.float64(2627.3525390625), np.float64(1415.5044531249998)), (np.float64(2627.3525390625), np.float64(933.0513281249998))), 'system': 'PixelSpace', 'layout_width': 2975, 'layout_height': 3850}, 'last_modified': '2026-08-24T13:52:40', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 354, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'parent_id': 'b53c995f73fb6dbebff0df3beba2c538', 'category': 'NarrativeText', 'element_id': 'c456ae3cbd7ceee1aeaef789e1c8a744'}, page_content="Although these measurements are not calibrated to represent an absolute value of SNR at the satellite router's receive input, differences between consecutive measurements can be considered accurate. Measurements are timestamped and can be streamed to the ACU at rates as high as 60 times per second. This periodic feedback can help the ACU improve dynamic antenna pointing accuracy over the accuracy that can be obtained from the use of platform-mounted navigation sensors, alone. This additional accuracy is especially useful when attempting to perform a conical scan for a satellite with an antenna assembly mounted on a moving platform, such as is the case for maritime terminals."), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_2390dad9058e9d21ffdcdecf211d325c.pdf', 'detection_class_prob': 0.9068038463592529, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(568.75), np.float64(1461.697161458333)), (np.float