0clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'category': 'NarrativeText', 'element_id': '4c5c8b8b99a548ac07b93e5a315bc7a6'}, page_content='In the context of evaluating RAG models, the Pearson correlation coeﬃcient can be used to measure how well the model’s predictions align with actual outcomes. A coeﬃ- cient close to +1 indicates a strong positive linear relationship, meaning as one variable increases, the other also increases. A coeﬃcient close to -1 indicates a strong negative lin- ear relationship, meaning as one variable increases, the other decreases. A coeﬃcient near 0 suggests no linear correlation between variables. In the evaluation of RAG models, a high Pearson correlation coeﬃcient could indicate that the model is accurately retrieving and generating responses, while a low coeﬃcient could suggest areas for improvement.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.5957085490226746, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(803.666259765625), np.float64(2284.1534625)), (np.float64(803.666259765625), np.float64(2332.8617958333334)), (np.float64(1075.6675708333337), np.float64(2332.8617958333334)), (np.float64(1075.6675708333337), np.float64(2284.1534625))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 18, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'category': 'Title', 'element_id': '940537259da70c1fc021482713b0b34e'}, page_content='3.7. F1 Score'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9444721341133118, 'is_extracted': 'true', 'coordinates': {'points