: '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'category': 'NarrativeText', 'element_id': 'e1e17cc4f5de0a6fff07200cdc06085b'}, page_content='where, 𝑐 is the total length of the candidate translation, and 𝑟 is the eﬀective reference corpus length, which is the sum of the lengths of the closest matching reference transla- tions for each candidate sentence.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.8734927773475647, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7888666666668), np.float64(2060.9302)), (np.float64(808.7888666666668), np.float64(2176.26416015625)), (np.float64(2731.0924666666665), np.float64(2176.26416015625)), (np.float64(2731.0924666666665), np.float64(2060.9302))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 15, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'category': 'NarrativeText', 'element_id': 'fcea65523c22b0607751fd4154fcef0e'}, page_content='𝐵𝑃 = 1 if the candidate translation length 𝑐 is greater than the reference length 𝑟, indicating no penalty.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.8775851726531982, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7914625), np.float64(2178.157625)), (np.float64(808.7914625), np.float64(2299.6258541666666)), (np.float64(2731.304508333334), np.float64(2299.6258541666666)), (np.float64(2731.304508333334), np.float64(2178.157625))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'app