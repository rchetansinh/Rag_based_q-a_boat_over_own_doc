nt_id': '3d8879a3020aef88b6968111f8df7e46'}, page_content='where: cb is for connector balance, Stos is for a Smart Token’s Outstanding Supply = base.balance, and STtv is for a Smart Token’s total value = Connector Balance = quote.bal- ance.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.8958313465118408, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(795.9827880859375), np.float64(3472.64990234375)), (np.float64(795.9827880859375), np.float64(3754.364013671875)), (np.float64(2732.92919921875), np.float64(3754.364013671875)), (np.float64(2732.92919921875), np.float64(3472.64990234375))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 26, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'category': 'NarrativeText', 'element_id': 'afec50a07f9eba108c215829d59875bf'}, page_content='The cost evaluation of RAM, CPU, and NET resources in SYS tokens during a test execution occurs as follows. The PaSSER App uses SYS tokens. The CPU price is measured in (SYS token/ms/Day) and is valid for a speciﬁc account on the network. The NET Price is measured in (SYS token/KiB/Day) and is valid for a speciﬁc account on the network.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(912.0367958333331), np.float64(3722.343401388888)), (np.float64(912.0367958333331), np.float64(3771.051734722222)), (np.float64(2672.7164041666647), np.float64(3771.051734722222)), (np.float64(2672.7164041666647), np.float64(3722.343401388888))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2