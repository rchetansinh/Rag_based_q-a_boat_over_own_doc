 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 20, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '6594a3a0b086fc66918fd8a9a885b389', 'category': 'NarrativeText', 'element_id': 'c42638a142b28b440f36faac81378e12'}, page_content='Evaluation count is the number of individual evaluations performed by the model during a speciﬁc test. It helps to understand its capacity to process multiple prompts or tasks within a given timeframe, reﬂecting its productivity under varying workloads.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9349952936172485, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7920458333331), np.float64(2974.823308333333)), (np.float64(808.7920458333331), np.float64(3210.483966666666)), (np.float64(2741.6025390625), np.float64(3210.483966666666)), (np.float64(2741.6025390625), np.float64(2974.823308333333))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 20, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '6594a3a0b086fc66918fd8a9a885b389', 'category': 'NarrativeText', 'element_id': '72766e04afc04b9da0167ddcbb9edbc6'}, page_content='Load duration time is the time required for initializing and loading the language model into memory before it begins processing data. This metric is essential for assessing the start-up eﬃciency of the model, which can signiﬁcantly impact user experience and oper- ational latency in real-time applications.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297f