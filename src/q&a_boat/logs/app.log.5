8.7871400000005), np.float64(3047.4279208333337)), (np.float64(2731.263048888889), np.float64(3047.4279208333337)), (np.float64(2731.263048888889), np.float64(2624.638427734375))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 12, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '4869e6c152682a4ffdcd63b4053042b5', 'category': 'NarrativeText', 'element_id': '01181e987828f9116a9e968509b991dd'}, page_content='The evaluation of RAG models within the PaSSER App was performed using a set of 13 standard NLP metrics. These metrics evaluated various dimensions of model perfor- mance, including the quality of text generation and summarization, semantic similarity, predictive accuracy, and consistency of generated content compared to reference or ex- pected results. Metrics included METEOR, ROUGE (with ROUGE-1 and ROUGE-L vari- ants), BLEU, perplexity (using Laplace and Lidstone smoothing techniques), cosine simi- larity, Pearson correlation coeﬃcient, and F1 score.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.94573974609375, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7822711111115), np.float64(3061.1344458333333)), (np.float64(808.7822711111115), np.float64(3421.332570833333)), (np.float64(2731.708251953125), np.float64(3421.332570833333)), (np.float64(2731.708251953125), np.float64(3061.1344458333333))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 12, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '4869e6c152682a4ffdcd63b4053042b5', 'category': 'NarrativeText', 'element_id': '2c6fca262e5c08d5efb285bdc855c93b'}, page_content='The PaSSER App ran two main tests to assess LLM: “LLM Q&A Time Test” and “RAG Q&A Assessment Test”. The latter speciﬁcally applied the selected metrics to a cre- ated dataset of question–answer pairs for the smart agriculture domain. The test aimed to determine which model provides the most accurate and contextually relevant answers within the RAG framework and the capabilities of each model in the context of text gen- eration and summarization tasks.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.8940236568450928, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7871400000006), np.float64(3434.751716666667)), (np.float64(808.7871400000006), np.float64(3545.874908333333)), (np.float64(2731.6525599999995), np.float64(3545.874908333333)), (np.float64(2731.6525599999995), np.float64(3434.751716666667))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 12, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '4869e6c152682a4ffdcd63b4053042b5', 'category': 'NarrativeText', 'element_id': '1a70a7ea0319ea9ba35bfef66ad0d1cb'}, page_content='The RAG Q&A chat’ was assessed using a set of selected metrics: METEOR, ROUGE, PPL (perplexity), cosine similarity, Pearson correlation coefficient, and F1 score [35].'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9221176505088806, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(793.9666137695312), np.float64(3559.2891833333333)),