es': {'points': ((np.float64(795.1583251953125), np.float64(1267.396783333331)), (np.float64(795.1583251953125), np.float64(1440.6425833333305)), (np.float64(2745.90625), np.float64(1440.6425833333305)), (np.float64(2745.90625), np.float64(1267.396783333331))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 25, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '259b70d6f9daf26f88e8ee45ccb2aa6b', 'category': 'NarrativeText', 'element_id': 'aaf17e804ab51056b703be5cca2c86d8'}, page_content='Laplace perplexity. For perplexity, a lower score is better as it indicates a model’s predictions are more certain. Llama2:7b has the lowest score, suggesting the best predictability under Laplace smoothing conditions.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.8910754323005676, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7879625), np.float64(1454.3491083333304)), (np.float64(808.7879625), np.float64(1565.4722999999967)), (np.float64(2730.9308250000017), np.float64(1565.4722999999967)), (np.float64(2730.9308250000017), np.float64(1454.3491083333304))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 25, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '259b70d6f9daf26f88e8ee45ccb2aa6b', 'category': 'NarrativeText', 'element_id': '2262b3c75d2dba61fb99103c37bd525a'}, page_content='Lidstone perplexity—Mistral:7b has the lowest score, indicating it is slightly more predictable under Lidstone smoothing conditions.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.917840301990509, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(801.5816650390625), np.float64(1578.8865749999966)), (np.float64(801.5816650390625), np.float64(1752.13724583333)), (np.float64(2731.1451416666664), np.float64(1752.13724583333)), (np.float64(2731.1451416666664), np.float64(1578.8865749999966))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 25, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '259b70d6f9daf26f88e8ee45ccb2aa6b', 'category': 'NarrativeText', 'element_id': 'e9be0b7e67ea28363cc7f36a59c8ad10'}, page_content='Cosine similarity measures the cosine of the angle between two vectors. A higher score indicates greater semantic similarity. Mistral:7b has the highest score, suggesting its generated text is most similar to the reference text in terms of meaning.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9202816486358643, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(805.6611938476562), np.float64(1765.84377083333)), (np.float64(805.6611938476562), np.float64(1939.0944416666634)), (np.float64(2742.50146484375), np.float64(1939.0944416666634)), (np.float64(2742.50146484375), np.float64(1765.84377083333))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 25, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '259b70d6f9daf26f88e8ee45ccb2aa6b', 'category': 'NarrativeText', 'element_id': '03d862f22d084d96fe54674c7d48d51c'}, page_content='Pearson correlation measures the linear correlation between two variables. A score of 1 indicates perfect correlation. Mistral:7b has the highest score, showing its outputs have a stronger linear relationship with the reference data.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.8999804258346558, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.8025749999997), np.float64(1952.8009666666633)), (np.float64(808.8025749999997), np.float64(2063.63190833333)), (np.float64(2730.5849958333324), np.float64(2063.63190833333)), (np.float64(2730.5849958333324), np.float64(1952.8009666666633))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 25, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '259b70d6f9daf26f88e8ee45ccb2aa6b', 'category': 'NarrativeText', 'element_id': '818bb017b5b9ebbf4322b17f70527cc5'}, page_content='F1 score balances precision and recall. Mistral:7b has the highest F1 score, indicating the best balance between recall and precision in its outputs.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9494792819023132, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7977041666657), np.float64(2077.33843333333)), (np.float64(808.7977041666657), np.float64(2562.074024999997)), (np.float64(2731.710158333333), np.float64(2562.074024999997)), (np.float64(2731.710158333333), np.float64(2077.33843333333))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 25, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '259b70d6f9daf26f88e8ee45ccb2aa6b', 'category': 'NarrativeText', 'element_id': '929f9fa9a3ce41df937778ff21fecfbe'}, page_content='Based on the above analysis, the following summary can be concluded. For text gen- eration and summarization, Mistral:7b appears to be the best-performing model in most metrics, particularly those related to semantic quality and relevance. Orca2:7b shows strength in balancing precision and recall, especially for longer content sequences. Llama2:7b demonstrates the best predictive capability under Laplace smoothing condi- tions, which may be beneﬁcial in certain predictive text generation tasks. The selection of the best model would depend on the speciﬁc requirements of the text generation or sum- marization task.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.6090524196624756, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7977041666657), np.float64(2634.113649999997)), (np.float64(808.7977041666657), np.float64(2682.821983333331)), (np.float64(1659.6446124999986), np.float64(2682.821983333331)), (np.float64(1659.6446124999986), np.float64(2634.113649999997))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 25, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '259b70d6f9daf26f88e8ee45ccb2aa6b', 'category': 'Title', 'element_id': 'bb5f71f0e1d85316dddee6e78d943b80'}, page_content='4.3. Blockchain RAM Resource Evaluation'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9442297220230103, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.792833333332), np.float64(2710.871337890625)), (np.float64(808.792833333332), np.float64(3071.309908333331)), (np.float64(2731.1159166666653), np.float64(3071.309908333331)), (np.float64(2731.1159166666653), np.float64(2710.871337890625))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 25, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': 'bb5f71f0e1d85316dddee6e78d943b80', 'category': 'NarrativeText', 'element_id': '75da5ee768236c80f437fbc8b1be6a53'}, page_content='The integration of blockchain technologies to record test results aims to increase the conﬁdence and transparency of the results obtained, support their traceability, and facili- tate their documentation. This can also be implemented using classical databases (e.g., Mongo DB, Postgres, Maria DB, or others), but as the amount of data stored in the block- chain is relatively small (on average 1 kB per test), there is no obstacle to exploit the ad- vantages of this technology.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9340832233428955, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7879624999988), np.float64(3084.7241833333305)), (np.float64(808.7879624999988), np.float64(3382.7996999999973)), (np.float64(2731.198720833332), np.float64(3382.7996999999973)), (np.float64(2731.198720833332), np.float64(3084.7241833333305))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 25, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': 'bb5f71f0e1d85316dddee6e78d943b80', 'category': 'NarrativeText', 'element_id': '26bc8e873f1037c68681a701995dfc74'}, page_content='In terms of blockchain performance, the platform used (Antelope) is characterized as one of the fastest—over 7000 transactions per second. Since the main time for running the tests is due to the generation of answers (with or without the use of RAG), it is multiple times longer than the time for recording the results in the blockchain (for example, about 1 min for generating an answer, and about 0.5 s for recording the results in the blockchain).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9286231398582458, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(798.3162841796875), np.float64(3396.2900416666666)), (np.float64(798.3162841796875), np.float64(3756.4881666666665)), (np.float64(2740.313232421875), np.float64(3756.4881666666665)), (np.float64(2740.313232421875), np.float64(3396.2900416666666))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 25, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': 'bb5f71f0e1d85316dddee6e78d943b80', 'category': 'NarrativeText', 'element_id': 'fb0425a65b4c09df3ac1e5821178af84'}, page_content='PaSSER App uses a private, permissionless blockchain network. Such a blockchain network can be installed by anyone with the required technical knowledge. Instructions for installing the Antelope blockchain can be found on GitHub “https://github.com/scpdxtest/PaSSER/blob/main/%23%20Installation%20Instruc- tions.md (accessed on 1 April 2024)”. There are no plans to implement a public blockchain network in this project. at:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.8487944602966309, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(2562.454345703125), np.float64(257.4604187011719)), (np.float64(2562.454345703125), np.float64(299.765375)), (np.float64(2728.608866666667), np.float64(299.765375)), (np.float64(2728.608866666667), np.float64(257.4604187011719))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 25, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'category': 'Header', 'element_id': '01d24a12d9746adfa8bfb1c3abf15888'}, page_content='25 of 31'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.8969898819923401, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(174.89488220214844), np.float64(260.9737083333338)), (np.float64(174.89488220214844), np.float64(299.765375)), (np.float64(602.0690958333333), np.float64(299.765375)), (np.float64(602.0690958333333), np.float64(260.9737083333338))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 26, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'category': 'Header', 'element_id': '479a6d3009414d5177ef49e964690d49'}, page_content='Electronics 2024, 13, 1361'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9408553242683411, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7928333333332), np.float64(457.45513333333326)), (np.float64(808.7928333333332), np.float64(755.5306499999989)), (np.float64(2731.6322249999985), np.float64(755.5306499999989)), (np.float64(2731.6322249999985), np.float64(457.45513333333326))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 26, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '479a6d3009414d5177ef49e964690d49', 'category': 'NarrativeText', 'element_id': '67677a514438c73627572da043cd6ebc'}, page_content='The blockchain (Antelope) must use a system token. The symbol (SYS), precision, and supply are set when the network is installed. All system resources (RAM, CPU, NET) are evaluated in SYS. Similar to other platforms (e.g., Bitcoin, Ethereum), to execute transac- tions and build blocks (to prevent denial of service attacks), Antelope charges a fee in SYS tokens.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9242404103279114, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.8025750000003), np.float64(768.9449249999988)), (np.float64(808.8025750000003), np.float64(942.1907249999982)), (np.float64(2731.2961375000004), np.float64(942.1907249999982)), (np.float64(2731.2961375000004), np.float64(768.9449249999988))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 26, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '479a6d3009414d5177ef49e964690d49', 'category': 'NarrativeText', 'element_id': '27ae4230269c1e5c41291e6c08b9cde0'}, page_content='The NET is used to measure the amount of data that can be sent per transaction as an average consumption in bytes over the last 3 days (72 h). It is consumed temporarily for each action/transaction.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9458000659942627, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.8025750000005), np.float64(955.897249999998)), (np.float64(808.8025750000005), np.float64(1316.1051166666643)), (np.float64(2731.0964333333327), np.float64(1316.1051166666643)), (np.float64(2731.0964333333327), np.float64(955.897249999998))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 26, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '479a6d3009414d5177ef49e964690d49', 'category': 'NarrativeText', 'element_id': 'd909eac1f7831a848c0704f441b4f426'}, page_content='The CPU limits the maximum execution time of a transaction and is measured as average consumption in microseconds, also for the last 3 days. It is also temporarily con- sumed when an action or transaction is sent. NET and CPU are together called bandwidth. In public networks, users can use the bandwidth resources if available, i.e., that are not mortgaged by other accounts. The price of mortgaged bandwidth (NET and CPU) re- sources varies, depending on how many SYS tokens are staked in total.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9485545754432678, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(804.767333984375), np.float64(1329.8116416666642)), (np.float64(804.767333984375), np.float64(1814.5521041666634)), (np.float64(2731.2912666666675), np.float64(1814.5521041666634)), (np.float64(2731.2912666666675), np.float64(1329.8116416666642))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 26, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '479a6d3009414d5177ef49e964690d49', 'category': 'NarrativeText', 'element_id': 'd86cc146fa27327fb05eeb6360c382d8'}, page_content='The RAM is the information that is accessible from application logic (order books, account balances). It limits the maximum space that can be occupied to store permanent data (in the block producers’ RAM). An account can exchange NET and CPU by mortgag- ing SYS tokens, but must buy RAM. RAM is not freed automatically. The only way to free up memory is to delete the data that is using the account (multi-index tables). Freed un- used RAM can be sold and purchased at the market price, which is determined by the Bancor algorithm [43]. In detail, the entire RAM, CPU, NET evaluation procedure that applies here is described in [11].'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9261243343353271, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(800.0092163085938), np.float64(1828.2586291666632)), (np.float64(800.0092163085938), np.float64(2001.5092999999968)), (np.float64(2733.7109375), np.float64(2001.5092999999968)), (np.float64(2733.7109375), np.float64(1828.2586291666632))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 26, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '479a6d3009414d5177ef49e964690d49', 'category': 'NarrativeText', 'element_id': '4b0e4f4fe751eba5cc7e5c0df9abdf6f'}, page_content='In our case, the RAM price is extracted from the eammarket’ table of the eosio system account by executing the cleos command from the command line with the appropriate pa- rameters (date 23.03.2024, 14:05 h).'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.8748513460159302, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(839.7529907226562), np.float64(2057.6721666666663)), (np.float64(839.7529907226562), np.float64(2556.7133472222217)), (np.float64(1798.644604166667), np.float64(2556.7133472222217)), (np.float64(1798.644604166667), np.float64(2057.6721666666663))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 26, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '479a6d3009414d5177ef49e964690d49', 'category': 'NarrativeText', 'element_id': '52173c58c99835453c9c217595be8a01'}, page_content='“rows”: [{ “supply”: “10000000000.0000 RAMCORE”, “base”: { “balance”: “68660625616 RAM”, “weight”: “0.50000000000000000” }, “quote”: { “balance”: “1000857.1307 SYS”, “weight”: “0.50000000000000000” } } ]'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9420393705368042, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(806.4157104492188), np.float64(2631.619384765625)), (np.float64(806.4157104492188), np.float64(3056.4858722222216)), (np.float64(2731.7996125000013), np.float64(3056.4858722222216)), (np.float64(2731.7996125000013), np.float64(2631.619384765625))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 26, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': '479a6d3009414d5177ef49e964690d49', 'category': 'NarrativeText', 'element_id': 'ffe210e55544c4b24c9db90ae53aeb1f'}, page_content='In order to apply the Bancor algorithm for RAM pricing to our private network, the following clariﬁcations should be made. The Antelope blockchain network has a so-called RAM token. The PaSSER uses our private Antelope blockchain network, whose system token is SYS. In the context of the Bancor algorithm, RAM and SYS should be considered Smart Tokens. The Smart Token is a token that has one or more connectors with other tokens in the network. The connector, in this case, is a SYS token, and it establishes a relationship between SYS and RAM. Using the Bancor algorithm [43,44] could be presented as follows:'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.3199969530105591, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(1270.7931541666665), np.float64(3097.978515625)), (np.float64(1270.7931541666665), np.float64(3154.671142578125)), (np.float64(2666.72119140625), np.float64(3154.671142578125)), (np.float64(2666.72119140625), np.float64(3097.978515625))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 26, 'file_directory': '/var/folders/5z/p