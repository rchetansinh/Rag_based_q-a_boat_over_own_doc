ement_id': '6e31c6e5b82de7673b0c997019bd61bc'}, page_content='Prompt evaluation duration captures the time model used to evaluate a single prompt, from receiving the input to generating the output. It measures the model’s responsiveness and is particularly important for interactive applications where fast output is vital.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.8426822423934937, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(2562.777587890625), np.float64(257.3096008300781)), (np.float64(2562.777587890625), np.float64(299.765375)), (np.float64(2728.608866666667), np.float64(299.765375)), (np.float64(2728.608866666667), np.float64(257.3096008300781))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 20, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'category': 'Header', 'element_id': '046da4b0df73cd10c22fc786c0b906e8'}, page_content='20 of 31'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.898171603679657, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(174.8980712890625), np.float64(260.9737083333338)), (np.float64(174.8980712890625), np.float64(299.765375)), (np.float64(602.0708561875), np.float64(299.765375)), (np.float64(602.0708561875), np.float64(260.9737083333338))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 21, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'category': 'Header', 'element_id': 'df3c2f9b1d3ea50d38af0772a5053e24'}, page_content='Electronics 2024, 13, 1361'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9281647205352783, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7881355555556), np.float64(457.45513333333326)), (np.float64(808.7881355555556), np.float64(630.7009333333327)), (np.float64(2736.0703125), np.float64(630.7009333333327)), (np.float64(2736.0703125), np.float64(457.45513333333326))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 21, 'file_directory': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T', 'filename': 'rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'parent_id': 'df3c2f9b1d3ea50d38af0772a5053e24', 'category': 'NarrativeText', 'element_id': 'df824e4b45e1543278e29f5b8a1934c1'}, page_content='Total duration is the overall time for the entire evaluation process, incorporating all phases from initialization to the completion of the last prompt evaluation. This metric gives a complete view of the model’s operational eﬃciency over an entire test cycle.'), Document(metadata={'source': '/var/folders/5z/p05w2vpj7b90clpntd1kvyp80000gp/T/rag_upload_44c3d19297fec5dad77b32cba42d667a.pdf', 'detection_class_prob': 0.9342451691627502, 'is_extracted': 'true', 'coordinates': {'points': ((np.float64(808.7832666666668), np.float64(644.4074583333326)), (np.float64(808.7832666666668), np.float64(880.0681166666651)), (np.float64(2740.537109375), np.float64(880.0681166666651)), (np.float64(2740.537109375), np.float64(644.4074583333326))), 'system': 'PixelSpace', 'layout_width': 2894, 'layout_height': 4094}, 'last_modified': '2026-08-24T16:05:13', 'filetype': 'application/pdf', 'languages': ['eng'], 'page_number': 21, 'file_directory': '/var/folders/5z/p05w2vpj7b90c